const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));
const backdrop=document.getElementById('backdrop');
const header=document.querySelector('header');
document.querySelectorAll('img[alt="M2P"]').forEach(img=>{img.src='/profile/m2p-logo.svg';});
document.getElementById('download-pdf')?.addEventListener('click',e=>{e.preventDefault();window.print();});

function openApp(id,push=true){
 const a=APPS.find(x=>x.id===id); if(!a)return;
 document.getElementById('dbadge').textContent=a.name[0];
 document.getElementById('dbadge').style.background='#edf2f7';
 document.getElementById('dbadge').style.color='#10284b';
 document.getElementById('dname').textContent=a.name;
 document.getElementById('dcat').textContent=a.category+' · Integrated Channels Suite';
 const capabilities=a.capabilities.map(x=>'<div>'+esc(x)+'</div>').join('');
 const users=a.users.map(x=>'<div>'+esc(x)+'</div>').join('');
 const integrations=a.integrations.map(x=>'<div>'+esc(x)+'</div>').join('');
 const pm=a.pm.map(x=>'<div>'+esc(x)+'</div>').join('');
 const workflow=a.workflow.map((x,i)=>'<div class="fstep"><b>'+String(i+1).padStart(2,'0')+' · '+esc(x)+'</b><span>State · owner · validation · next action</span></div>').join('');
 const rows=a.reports.map((x,i)=>'<tr><td>'+esc(x)+'</td><td>'+['Operational monitoring','Management visibility','Exception management','Control / compliance'][i%4]+'</td><td>'+(i%2?'On demand':'Cycle / daily')+'</td></tr>').join('');
 const api=esc(JSON.stringify({reference_id:'IC-DEMO-001',application:a.name,source_system:'BANK-SOURCE',idempotency_key:'synthetic-key',metadata:{channel:'operations',suite:'integrated-channels'}},null,2));
 document.getElementById('dbody').innerHTML=`
 <div class="dhero">
  <div class="dcard"><span class="eyebrow">Product brief</span><h3>${esc(a.purpose)}</h3><p><b>Problem:</b> ${esc(a.problem)}</p><div class="dsection"><div class="dsection-head"><h3>Core capabilities</h3><span>${a.capabilities.length} capabilities</span></div><div class="list2">${capabilities}</div></div></div>
  <div class="dcard"><span class="eyebrow">Users &amp; ecosystem</span><div class="dsection-head"><h3>Primary users</h3></div><div class="list2">${users}</div><div class="dsection"><div class="dsection-head"><h3>Integration landscape</h3></div><div class="list2">${integrations}</div></div></div>
 </div>
 <div class="dsection"><div class="dsection-head"><h3>End-to-end workflow</h3><span>Conceptual product journey</span></div><div class="flow">${workflow}</div></div>
 <div class="dsection"><div class="dsection-head"><h3>Product design lens</h3><span>What had to be designed beyond screens</span></div><div class="journey-grid"><div class="journey-card"><b>Roles &amp; permissions</b><span>Who can create, review, approve, close or view.</span></div><div class="journey-card"><b>Business rules</b><span>Validations, thresholds, mandatory information and state transitions.</span></div><div class="journey-card"><b>Exceptions</b><span>Failure, retry, rejection, duplicate, incomplete and manual handling.</span></div><div class="journey-card"><b>Reporting</b><span>Operational queue, management view, auditability and closure.</span></div></div></div>
 <div class="dsection"><div class="dsection-head"><h3>Sample reporting view</h3><span>Synthetic · no client data</span></div><div class="report"><div class="report-head"><b>${esc(a.name)} Operations Dashboard</b><span>Illustrative reporting specification</span></div><table><thead><tr><th>Report / widget</th><th>Product purpose</th><th>Cadence</th></tr></thead><tbody>${rows}</tbody></table></div></div>
 <div class="dsection"><div class="dsection-head"><h3>API / integration thinking</h3><span>Conceptual contract</span></div><div class="api"><span class="method">POST</span> ${esc(a.api)}<br><br>${api}</div><div class="error"><b>Representative guardrail / exception</b><p>${esc(a.error)}</p></div></div>
 <div class="dsection"><div class="dsection-head"><h3>Product management contribution</h3><span>PM responsibilities applied to this product</span></div><div class="list2">${pm}</div></div>
 <div class="dsection"><div class="dcard"><span class="eyebrow">Product learning</span><p style="font-size:11.5px;margin-top:6px">${esc(a.learning)}</p></div></div>
 <div class="dsection"><div class="dcard"><span class="eyebrow">Portfolio artefacts represented</span><div class="list2"><div>Problem statement / use cases</div><div>Workflow &amp; role model</div><div>BRD / FRD / FSD</div><div>Figma / product screens</div><div>DFD / ER / architecture</div><div>API specification</div><div>Acceptance criteria / UAT</div><div>User manual / training</div></div></div></div>`;
 backdrop.classList.add('open');backdrop.setAttribute('aria-hidden','false');document.body.classList.add('locked');
 if(push)history.replaceState({app:id},'', '#app/'+id);
}
function closeApp(push=true){backdrop.classList.remove('open');backdrop.setAttribute('aria-hidden','true');document.body.classList.remove('locked');if(push&&location.hash.startsWith('#app/'))history.replaceState({},'', '#products');}
document.querySelectorAll('[data-open]').forEach(el=>el.addEventListener('click',e=>{e.preventDefault();openApp(el.dataset.open,true)}));
document.getElementById('close').onclick=()=>closeApp();backdrop.addEventListener('click',e=>{if(e.target===backdrop)closeApp()});document.addEventListener('keydown',e=>{if(e.key==='Escape')closeApp()});
const search=document.getElementById('search'),filters=[...document.querySelectorAll('.filter')];let filter='All';
function applyFilter(){if(!search)return;let count=0,q=search.value.toLowerCase().trim();document.querySelectorAll('.app-card').forEach(c=>{let show=(filter==='All'||c.dataset.cat===filter)&&(!q||c.dataset.search.includes(q));c.classList.toggle('hidden',!show);if(show)count++});const empty=document.getElementById('empty');if(empty)empty.classList.toggle('hidden',count>0)}
if(search){search.oninput=applyFilter;filters.forEach(f=>f.onclick=()=>{filters.forEach(x=>x.classList.remove('active'));f.classList.add('active');filter=f.dataset.filter;applyFilter()})}

function getHeaderOffset(){return (header?.getBoundingClientRect().height || 0)+8;}
function scrollToSection(id,updateHash=true){
  const target=document.getElementById(id);if(!target)return;
  const top=target.getBoundingClientRect().top+window.scrollY-getHeaderOffset();
  window.scrollTo({top:Math.max(0,top),behavior:'smooth'});
 setActiveNav(id);
  if(updateHash)history.replaceState({section:id},'', '#'+id);
}
document.querySelectorAll('a[href^="#"]').forEach(a=>a.addEventListener('click',e=>{
  const href=a.getAttribute('href')||'';
  if(!href.startsWith('#')||href==='#'||a.hasAttribute('data-open'))return;
  const id=href.slice(1),target=document.getElementById(id);if(!target)return;
  e.preventDefault();scrollToSection(id,true);
}));
const sections=[...document.querySelectorAll('main section[id]')],links=[...document.querySelectorAll('nav a[href^="#"]')];
function setActiveNav(id){links.forEach(a=>a.classList.toggle('active',a.getAttribute('href')==='#'+id));}
function updateActiveNav(){
  const marker=window.scrollY+getHeaderOffset()+28;
  let current=sections[0]?.id||'overview';
  for(const s of sections){if(s.offsetTop<=marker)current=s.id;else break;}
 setActiveNav(current);
}
window.addEventListener('scroll',updateActiveNav,{passive:true});
window.addEventListener('resize',updateActiveNav);
updateActiveNav();
window.addEventListener('scroll',()=>{const h=document.documentElement,max=h.scrollHeight-h.clientHeight;document.getElementById('progress').style.width=(max>0?(h.scrollTop/max)*100:0)+'%'},{passive:true});
function handleHash(){
  if(location.hash.startsWith('#app/')){openApp(location.hash.slice(5),false);return}
  const id=location.hash.slice(1);
 if(id&&document.getElementById(id))setTimeout(()=>scrollToSection(id,false),50);
}
window.addEventListener('popstate',handleHash);window.addEventListener('hashchange',handleHash);handleHash();
</script>
</SiteLayout>