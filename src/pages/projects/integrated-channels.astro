---
import SiteLayout from '../../layouts/SiteLayout.astro';
---

<SiteLayout title="Integrated Channels Suite | Digital Banking Platform | Manoj Pant">
<style is:global>
:root{
  --navy:#102f55;--navy-2:#163d6a;--navy-3:#214e7d;
  --ink:#102a4d;--ink-2:#365774;--muted:#627c97;--line:#d8e4ef;--line-2:#e8eff5;
  --bg:#f3f7fb;--paper:#fff;--blue:#2468d7;--blue-soft:#eaf2ff;
  --lav:#7658d9;--lav-soft:#f1edff;--mint:#17886f;--mint-soft:#e8f7f2;
  --amber:#be7615;--amber-soft:#fff2df;--rose:#bb3f76;--rose-soft:#fff0f6;
  --teal:#167d87;--teal-soft:#e9f7f8;--radius:18px;--max:1480px;--header-h:110px;
  --shadow:0 12px 30px rgba(22,52,82,.07);--sans:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  --mono:"SFMono-Regular",Consolas,"Liberation Mono",monospace;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:calc(var(--header-h) + 10px)}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);font-size:15px;line-height:1.45;overflow-x:hidden}
body.locked{overflow:hidden}
a{text-decoration:none;color:inherit}button,input{font:inherit}button{cursor:pointer}svg,img{max-width:100%;display:block}
.wrap{width:min(var(--max),calc(100% - 48px));margin:0 auto}
.hidden{display:none!important}
#progress{position:fixed;top:0;left:0;height:4px;width:0;background:linear-gradient(90deg,var(--blue),var(--lav));z-index:300}

/* HEADER */
header{position:fixed;inset:0 0 auto;width:100%;z-index:120;background:var(--navy);color:#fff;border-bottom:1px solid rgba(255,255,255,.10);box-shadow:0 10px 24px rgba(8,28,51,.18)}
.head{height:var(--header-h);display:grid;grid-template-columns:280px minmax(530px,1fr) 250px;gap:10px;align-items:center}
.brand{display:flex;align-items:center;gap:12px;min-width:0}
.brand-logo{width:82px;height:82px;border-radius:50%;object-fit:cover;object-position:center 18%;border:3px solid rgba(255,255,255,.72);background:#244f7f;box-shadow:0 4px 12px rgba(0,0,0,.18)}
.brand-copy{min-width:0}.brand-copy b{display:block;font-size:18px;line-height:1.1;color:#fff;letter-spacing:-.02em}.brand-copy small{display:block;margin-top:5px;color:#c1d2e4;font-size:8.5px;line-height:1.15;font-weight:900;letter-spacing:.035em;text-transform:uppercase;white-space:nowrap;overflow:visible;text-overflow:clip}
#nav{display:grid;grid-template-columns:repeat(6,max-content);grid-template-rows:repeat(2,30px);gap:2px 22px;align-items:center;justify-content:end;min-width:0}
#nav a{width:max-content;height:30px;display:flex;align-items:center;justify-content:flex-end;border-radius:8px;color:#eaf1f7;font-size:10px;font-weight:900;white-space:nowrap;transition:.15s ease;padding:0 5px;text-align:right}
#nav a:hover,#nav a.active{background:#234f7f;color:#fff}
.head-actions{display:grid;grid-template-columns:1fr 1fr;grid-template-rows:42px 42px;gap:7px}.head-actions .action-row{grid-column:1/-1;display:grid;grid-template-columns:1fr 1fr;gap:7px}.head-actions .btn{height:42px}.portfolio-top{grid-column:1/-1}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;height:auto;padding:10px 14px;border:1px solid var(--line);border-radius:11px;background:#fff;color:var(--ink);font-size:12px;font-weight:950;transition:.15s ease}
.btn:hover{transform:translateY(-1px);box-shadow:0 8px 18px rgba(10,36,65,.12)}.btn.primary{background:var(--navy);border-color:var(--navy);color:#fff}.portfolio-top{background:#2a5c8d;color:#fff;border-color:#547ca5}

/* SECTIONS & VIEWPORT SLIDES */
.section,.ecosystem-wrap{border-bottom:1px solid var(--line-2)}
.section.white{background:#fff}.section{background:#f6f9fc}

.fit-section, .slide-page, .section.slide-page, .section > .slide-page, .slide-page.section { min-height: calc(100vh - var(--header-h)); display: flex; flex-direction: column; overflow: hidden; }
.slide-page { border-bottom: 1px solid var(--line-2); }
.slide-page:last-child { border-bottom: none; }
.fit-section > .wrap, .slide-page > .wrap, .section > .slide-page > .wrap { height: 100%; padding: 18px 0 16px; display: flex; flex-direction: column; min-height: 0; flex: 1; justify-content: center; }

.eyebrow{font-size:11px;line-height:1.15;color:var(--blue);font-weight:950;letter-spacing:.17em;text-transform:uppercase}
.section-head{display:grid;gap:6px;margin-bottom:14px;flex:none}.section-head h2{margin:4px 0 0;font-size:37px;line-height:1.03;letter-spacing:-.045em;color:var(--ink);font-weight:950;white-space:nowrap}.section-head p{margin:0;color:var(--ink-2);font-size:15px;line-height:1.42}
main{padding-top:var(--header-h)}

/* OVERVIEW */
.hero{background:linear-gradient(180deg,#f8fbff 0%,#f3f7fb 100%)}
.hero>.wrap{height:calc(100vh - var(--header-h));padding:16px 0 16px;display:flex;flex-direction:column;min-height:0}
.hero-copy{display:grid;grid-template-columns:1.18fr .82fr;gap:26px;align-items:center;min-height:0;flex:1}
.kicker{display:inline-flex;align-items:center;gap:9px;padding:7px 11px;border:1px solid #c8def7;border-radius:999px;background:var(--blue-soft);color:#17539c;font-size:11px;font-weight:950;letter-spacing:.11em;text-transform:uppercase}.kicker-m2p{width:34px;height:34px;border-radius:9px;overflow:hidden;flex:none}.kicker-m2p img{width:100%;height:100%;object-fit:contain}
h1{font-size:clamp(44px,4.4vw,64px);line-height:.96;letter-spacing:-.055em;margin:18px 0 15px;color:#d51f2a;font-weight:950;white-space:nowrap}.lead{font-size:16px;line-height:1.48;color:#42627f;margin:0;text-align:justify}.lead strong{color:var(--ink);font-weight:900}.hero-actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:18px}.safe{margin:10px 0 0;color:#7087a0;font-size:10.5px;line-height:1.35}
.hero>.wrap>.safe{margin-top:12px;padding:10px 13px;border:1px solid #c7dcef;border-left:4px solid var(--blue);border-radius:10px;background:#eef5ff;color:#365d82;font-size:10.5px;line-height:1.4;text-align:justify}
.role-card{border:1px solid var(--line);border-radius:18px;background:#fff;box-shadow:var(--shadow);padding:18px}.role-top{display:flex;align-items:center;gap:11px}.m2p-mark{width:52px;height:52px;flex:none}.m2p-mark img{width:100%;height:100%}.role-kicker{font-size:9px;letter-spacing:.12em;text-transform:uppercase;color:#6d84a0;font-weight:950}.role-top h2{margin:3px 0 0;font-size:24px;line-height:1.1;color:var(--ink)}.role-list{display:grid;gap:7px;margin-top:13px}.role-list>div{padding:9px 10px;border:1px solid var(--line);border-radius:11px;background:#fff}.role-list>div:nth-child(1){background:var(--blue-soft)}.role-list>div:nth-child(2){background:var(--lav-soft)}.role-list>div:nth-child(3){background:var(--mint-soft)}.role-list>div:nth-child(4){background:var(--amber-soft)}.role-list b{display:block;color:var(--ink);font-size:12px}.role-list span{display:block;margin-top:2px;color:#54708d;font-size:10.5px;line-height:1.35}
.quick{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;margin-top:12px}.stat{background:#fff;border:1px solid var(--line);border-top:4px solid var(--blue);border-radius:13px;padding:10px 12px;min-height:66px;display:flex;flex-direction:column;justify-content:center}.stat-purple{border-top-color:var(--lav)}.stat-mint{border-top-color:var(--mint)}.stat-rose{border-top-color:var(--rose)}.stat strong{font-size:25px;line-height:1;color:var(--ink);letter-spacing:-.04em}.stat span{margin-top:4px;font-size:9.5px;line-height:1.2;color:#607891;font-weight:800}

/* ECOSYSTEM */
.ecosystem-wrap{background:#edf3f8}.ecosystem-panel{height:100%;border:1px solid var(--line);border-radius:22px;background:#fff;box-shadow:var(--shadow);padding:10px}.eco-shell{height:100%;border:1px solid #d9e5ef;border-radius:18px;background:#f8fbfd;display:flex;flex-direction:column;overflow:hidden}.eco-topbar{height:34px;display:flex;align-items:center;justify-content:space-between;padding:0 14px;background:#fff;border-bottom:1px solid var(--line)}.eco-dots{display:flex;gap:6px}.eco-dots i{width:8px;height:8px;border-radius:50%;background:#d2deea}.eco-brand{display:flex;align-items:center;gap:6px;color:#566f89;font-size:9px;font-weight:950;letter-spacing:.12em;text-transform:uppercase}.m2p-mini{width:22px;height:22px}.m2p-mini img{width:100%;height:100%}
.eco-stage{flex:1;padding:15px 18px 10px;display:flex;flex-direction:column;min-height:0;justify-content:center;}.eco-heading{text-align:center;flex:none}.eco-heading h2{margin:0;font-size:28px;line-height:1.05;letter-spacing:-.035em;color:var(--ink);font-weight:950}.eco-heading h2 span{color:var(--blue)}.eco-heading p{margin:5px auto 0;max-width:1250px;color:#365a79;font-size:11.5px;line-height:1.4}.eco-heading p strong{font-weight:900;color:var(--ink-2)}
.eco-board{position:relative;flex:1;display:grid;grid-template-columns:repeat(12,minmax(0,1fr));grid-template-rows:44px 48px 64px 48px 44px;gap:7px;margin:16px auto 0;width:min(1280px,100%);min-height:0}.eco-lines{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:0}.eco-lines .ring{fill:none}.eco-lines line{fill:none}.eco-lines circle:last-child{fill:var(--blue)}
.eco-core{z-index:2;grid-column:5/9;grid-row:2/5;align-self:center;justify-self:center;width:100%;max-width:360px;min-height:112px;padding:12px 16px;border:2px solid #b9cee4;border-radius:18px;background:#fff;box-shadow:0 14px 30px rgba(26,59,90,.09);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}.core-logo{display:none}.eco-core>b{font-size:20px;line-height:1.05;color:var(--ink);letter-spacing:-.02em;white-space:nowrap}.eco-core>b br{display:none}.eco-core>span:last-child{margin-top:7px;font-size:10.5px;line-height:1.3;color:var(--ink-2);font-weight:800;white-space:nowrap}
.eco-node{z-index:3;display:flex;align-items:center;gap:7px;padding:5px 8px;border:1px solid #ccdbe8;border-left:4px solid var(--accent);border-radius:10px;background:var(--soft);box-shadow:0 6px 15px rgba(28,57,83,.05);color:var(--ink);min-width:0;min-height:0;transition:.15s ease}.eco-node:hover{transform:translateY(-2px);box-shadow:0 11px 22px rgba(28,57,83,.10)}.eco-number{width:24px;height:24px;border-radius:7px;background:rgba(255,255,255,.80);display:flex;align-items:center;justify-content:center;color:var(--accent);font-size:9px;font-weight:950;flex:none}.eco-copy{min-width:0}.eco-copy b{display:block;font-size:12px;line-height:1.02;white-space:nowrap}.eco-copy span{display:block;margin-top:2px;font-size:9px;line-height:1.15;color:#627c97;white-space:nowrap}.eco-footnote{text-align:center;margin-top:10px;font-size:10.5px;color:#56718d;font-weight:850;flex:none}
.eco-12{grid-column:2/5;grid-row:1}.eco-01{grid-column:5/8;grid-row:1}.eco-02{grid-column:8/11;grid-row:1}.eco-11{grid-column:1/4;grid-row:2}.eco-03{grid-column:10/13;grid-row:2}.eco-10{grid-column:1/4;grid-row:3}.eco-04{grid-column:10/13;grid-row:3}.eco-09{grid-column:1/4;grid-row:4}.eco-05{grid-column:10/13;grid-row:4}.eco-08{grid-column:2/5;grid-row:5}.eco-07{grid-column:5/8;grid-row:5}.eco-06{grid-column:8/11;grid-row:5}

/* CHALLENGE */
#challenge .section-head{margin-bottom:10px}#challenge .section-head h2{font-size:37px}#challenge .section-head p{font-size:15px;line-height:1.58}#challenge .story-grid{display:grid;grid-template-columns:1.05fr .95fr;grid-template-rows:auto auto;gap:10px;flex:1;min-height:0;align-content:start;align-items:stretch}.story{border:1px solid var(--line);border-radius:15px;padding:16px;background:var(--blue-soft);box-shadow:var(--shadow);min-height:0;height:100%}.story:nth-child(2){background:var(--lav-soft)}.story:nth-child(2) h3{font-size:21px;letter-spacing:-.03em}.story h3{font-size:24px;line-height:1.1;margin:6px 0;color:var(--ink);letter-spacing:-.025em}.story p{font-size:14px;line-height:1.45;color:#4f6d8a;margin:0}.story ul{margin:9px 0 0;padding-left:18px;color:#506d89;font-size:12.5px;line-height:1.4}.story li+li{margin-top:3px}.story-flow{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin-top:10px}.story-step{border:1px solid #d3dfeb;border-radius:9px;padding:9px;background:#fff}.story-step b{display:block;color:var(--ink);font-size:12px}.story-step span{display:block;margin-top:3px;color:#58728d;font-size:10.5px;line-height:1.3}.challenge-response{grid-column:1/-1;display:grid;grid-template-columns:repeat(4,1fr);gap:8px;align-items:stretch}.challenge-response>div{padding:11px;border:1px solid var(--line);border-radius:9px;background:#fff;height:100%;min-height:0}.challenge-response>div:nth-child(1){background:var(--blue-soft)}.challenge-response>div:nth-child(2){background:var(--mint-soft)}.challenge-response>div:nth-child(3){background:var(--rose-soft)}.challenge-response>div:nth-child(4){background:var(--amber-soft)}.challenge-response b{display:block;color:var(--ink);font-size:13px}.challenge-response span{display:block;margin-top:3px;color:#58718d;font-size:11px;line-height:1.3}

#challenge .story h3{margin-bottom:12px}

/* STRATEGY */
#strategy .section-head{margin-bottom:10px}#strategy .section-head h2{font-size:37px}#strategy .section-head p{font-size:15px;line-height:1.42}#strategy .strategy{display:grid;grid-template-columns:repeat(4,1fr);grid-template-rows:auto auto;gap:10px;flex:1;min-height:0;align-content:start}.strategy-card{border:1px solid var(--line);border-left:4px solid var(--tone);border-radius:12px;padding:12px;background:#fff;box-shadow:var(--shadow);min-height:0;height:auto;display:flex;flex-direction:column}.strategy-card .num{display:none}.strategy-card h3{margin:0 0 8px;padding:7px 9px;border-radius:7px;background:var(--blue-soft);font-size:15px;line-height:1.1;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.strategy-card:nth-child(2) h3,.strategy-card:nth-child(7) h3{background:var(--mint-soft)}.strategy-card:nth-child(3) h3,.strategy-card:nth-child(8) h3{background:var(--lav-soft)}.strategy-card:nth-child(4) h3{background:var(--amber-soft)}.strategy-card:nth-child(5) h3{background:var(--rose-soft)}.strategy-card p{margin:0;font-size:12px;line-height:1.42;color:#57718c;text-align:justify}.decision{margin-top:10px;border:1px solid var(--line);border-radius:11px;background:#fff;padding:10px;flex:none}.decision-title{display:block;font-size:10.5px;font-weight:950;color:var(--ink);letter-spacing:.1em}.decision-row{display:grid;grid-template-columns:repeat(9,1fr);gap:4px;margin-top:7px}.decision-step{padding:7px 4px;border:1px solid #cbdbea;border-radius:7px;background:var(--blue-soft);text-align:center;color:var(--ink);font-size:9px;font-weight:900}

#strategy .strategy{flex:none}

/* PM SCOPE */
#ownership .section-head{margin-bottom:10px}#ownership .section-head h2{font-size:37px}#ownership .section-head p{font-size:15px;line-height:1.42}#ownership .ownership{display:grid;grid-template-columns:repeat(4,1fr);grid-template-rows:auto auto auto;gap:9px;flex:1;min-height:0;align-content:start}.own{border:1px solid var(--line);border-left:4px solid #9ab4cc;border-radius:12px;padding:14px;background:#fff;box-shadow:var(--shadow);min-height:0;height:auto}.own:nth-child(1),.own:nth-child(5){background:var(--blue-soft)}.own:nth-child(2),.own:nth-child(6){background:var(--lav-soft)}.own:nth-child(3),.own:nth-child(7){background:var(--mint-soft)}.own:nth-child(4),.own:nth-child(8){background:var(--amber-soft)}.pill{display:inline-flex;align-items:center;padding:5px 8px;border-radius:999px;background:#fff;border:1px solid #d5e1ec;color:#294d70;font-size:11px;font-weight:950}.own h3{margin:8px 0 5px;font-size:17px;line-height:1.1;color:var(--ink)}.own p{margin:0;color:#58718d;font-size:12px;line-height:1.35}.own ul{margin:8px 0 0;padding-left:17px;color:#58718d;font-size:11.5px;line-height:1.4}.scope-evidence{grid-column:1/-1;display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.scope-evidence-card{border:1px solid #294d72;border-radius:9px;background:var(--navy);padding:11px}.scope-evidence-card b{display:block;font-size:16px;color:#fff;line-height:1}.scope-evidence-card span{display:block;margin-top:4px;color:#dbe8f4;font-size:10.5px;line-height:1.25}

#ownership .own{padding:12px}#ownership .own h3{font-size:15px;line-height:1.08;white-space:nowrap}#ownership .own p{font-size:11.5px;line-height:1.3}#ownership .own ul{font-size:11px;line-height:1.3;margin-top:6px}#ownership .scope-evidence-card{padding:9px}#ownership .scope-evidence-card b{font-size:15px}#ownership .scope-evidence-card span{font-size:10px;line-height:1.2}

/* ARCHITECTURE */
#architecture .section-head{margin-bottom:8px}#architecture .section-head h2{font-size:32px}#architecture .section-head p{font-size:13px;line-height:1.32}#architecture .arch-layout{display:grid;grid-template-columns:1.08fr .92fr;gap:8px;flex:1;min-height:0;align-content:center}.arch-card{border:1px solid var(--line);border-radius:14px;background:#fff;box-shadow:var(--shadow);padding:12px;min-width:0;height:auto;overflow:hidden}.arch-card>h3{margin:5px 0 7px;font-size:17px;line-height:1.06;color:var(--ink)}.arch-map{display:grid;grid-template-columns:1fr 16px 2.2fr 16px 1fr;gap:5px;height:auto;min-height:0}.arch-column{display:flex;flex-direction:column;min-width:0;min-height:0}.arch-column h4{margin:0 0 5px;font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:#607b97}.arch-side{display:grid;gap:5px}.mini-box{border:1px solid var(--line);border-radius:7px;background:#fbfdff;padding:7px;font-size:9.5px;line-height:1.15;color:#4f6b87;font-weight:850}.arch-arrow{display:flex;align-items:center;justify-content:center;color:#8ba4bc;font-size:18px}.arch-stack{display:grid;gap:5px;min-height:0}.arch-layer{border:1px solid var(--line);border-left:4px solid var(--blue);border-radius:7px;background:var(--blue-soft);padding:7px;min-height:0}.arch-layer:nth-child(2){border-left-color:var(--lav);background:var(--lav-soft)}.arch-layer:nth-child(3){border-left-color:var(--mint);background:var(--mint-soft)}.arch-layer:nth-child(4){border-left-color:var(--amber);background:var(--amber-soft)}.arch-layer:nth-child(5){border-left-color:var(--rose);background:var(--rose-soft)}.arch-layer b{display:block;font-size:10px;color:var(--ink)}.arch-layer span{display:block;margin-top:2px;font-size:8px;line-height:1.2;color:#58728d}.arch-note{margin:5px 0 0;color:#71879f;font-size:9px}.stack{display:grid;grid-template-columns:repeat(2,1fr);gap:5px}.stack-card{border:1px solid var(--line);border-top:3px solid #9eb7cf;border-radius:8px;padding:8px;background:#fff;min-height:0}.stack-card:nth-child(2n){border-top-color:#9a86e8;background:var(--lav-soft)}.stack-card:nth-child(3n){border-top-color:#75c8af;background:var(--mint-soft)}.stack-card:nth-child(4n){border-top-color:#e1b16d;background:var(--amber-soft)}.stack-card h3{margin:0 0 4px;font-size:11px;color:var(--ink)}.chips{display:flex;flex-wrap:wrap;gap:4px}.stack-card .chips{flex-wrap:wrap;overflow:visible}.chip{padding:4px 6px;border:1px solid #d5e1eb;border-radius:5px;background:rgba(255,255,255,.84);font-size:8px;font-weight:850;color:#4e6985;white-space:normal}

#architecture>.slide-page:first-child .arch-card:first-child{padding:16px}#architecture>.slide-page:first-child .arch-card:first-child>h3{margin:6px 0 9px;font-size:19px;line-height:1.08}#architecture>.slide-page:first-child .arch-map{grid-template-columns:1fr 18px 2.2fr 18px 1fr;gap:7px}#architecture>.slide-page:first-child .arch-column h4{margin-bottom:7px;font-size:11px;color:var(--ink);font-weight:950}#architecture>.slide-page:first-child .arch-side{gap:7px}#architecture>.slide-page:first-child .mini-box{padding:9px;font-size:11px;line-height:1.2;border-radius:8px}#architecture>.slide-page:first-child .arch-arrow{font-size:20px}#architecture>.slide-page:first-child .arch-stack{gap:6px}#architecture>.slide-page:first-child .arch-layer{padding:9px;border-radius:8px}#architecture>.slide-page:first-child .arch-layer b{font-size:11.5px}#architecture>.slide-page:first-child .arch-layer span{font-size:9px;line-height:1.25}#architecture>.slide-page:first-child .arch-note{margin-top:7px;font-size:10px}
