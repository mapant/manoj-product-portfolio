---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';

/* --------------------------------------------------------------------------
   PORTFOLIO CONTENT MODEL
   -------------------------------------------------------------------------- */

const navItems = [
  ['overview', 'Overview'],
  ['ecosystem', 'Ecosystem'],
  ['challenge', 'Challenge'],
  ['strategy', 'Strategy'],
  ['scope', 'PM Scope'],
  ['metrics', 'Product Metrics'],
  ['portfolio', 'Portfolio'],
  ['tech', 'Tech & Data'],
  ['outcomes', 'Outcomes'],
