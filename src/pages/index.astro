  ['05', 'Automate', 'Rules, approval orchestration, exception handling, reconciliation and compliance workflows.', ['Rules engine', 'Approvals', 'Exceptions']],
  ['06', 'AI / GenAI', 'AI-assisted decisioning, document intelligence, knowledge workflows and intelligent process assistance.', ['Decisioning', 'Document AI', 'GenAI workflows']],
  ['07', 'Deliver', 'Backlog, epics, sprint execution, QA, UAT, VAPT, release coordination and stakeholder demos.', ['JIRA', 'Agile', 'UAT / VAPT']],
  ['08', 'Scale & Adopt', 'Data migration, deployment, training, support readiness, rollout and feedback loops.', ['Migration', 'Deployment', 'Training / support']]
];

const metricGroups = [
  {
    title: 'Adoption',
    question: 'Are the intended users actually using the product?',
    metrics: ['Eligible-user adoption', 'Active users / active accounts', 'Workflow completion rate']
  },
  {
    title: 'Activation',
    question: 'How quickly does a user reach meaningful value?',
    metrics: ['Time to first value', 'Activation rate', 'Onboarding completion']
  },
  {
    title: 'Efficiency',
    question: 'Does the product remove time, effort or manual work?',
    metrics: ['Turnaround time', 'Manual effort saved', 'Automation rate']
  },
  {
    title: 'Quality & Risk',
    question: 'Does the product make the process more reliable and controlled?',
    metrics: ['Error / exception rate', 'Reconciliation breaks', 'Control effectiveness']
  },
  {
    title: 'AI & Automation',
    question: 'Is intelligence improving the workflow without losing control?',
    metrics: ['Assist rate', 'Straight-through rate', 'Human hand-off rate']
  },
  {
    title: 'Business Impact',
    question: 'Did the product change a meaningful business outcome?',
    metrics: ['Cost reduction', 'Productivity gain', 'Revenue / service impact']
  }
];

const metricFormulas = [
  ['Adoption rate', 'Active eligible users ÷ total eligible users × 100'],
  ['Activation rate', 'Users reaching first-value milestone ÷ eligible users × 100'],
  ['Efficiency gain', '(Baseline effort − current effort) ÷ baseline effort × 100'],
  ['Automation rate', 'Automated cases ÷ total eligible cases × 100'],
  ['Exception rate', 'Exception cases ÷ total processed cases × 100']
];

const products = [
  {
    number: '01',
    company: 'M2P FINTECH',
    title: 'Integrated Channels Suite',
    problem: 'Banks and NBFCs needed connected capabilities across lending, compliance, reconciliation, payments and operations.',
    ownership: 'Product strategy, requirements, workflows, API integrations, DFD / ER mapping, roadmap and delivery.',
