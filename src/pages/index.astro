    .priority-item strong { font-size: 10px; }
    .priority-item span { font-size: 9px; line-height: 1.3; }

    /* PM SCOPE */
    .scope-card strong { font-size: 15px; }
    .scope-card p { font-size: 10.5px; line-height: 1.45; }
    .scope-tag { font-size: 8.5px; }
    .scope-footer strong { font-size: 10.5px; }
    .scope-footer span { font-size: 9.5px; white-space: normal; }

    /* PRODUCT METRICS */
