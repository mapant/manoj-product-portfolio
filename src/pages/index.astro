<PortfolioLayout title="Manoj Pant | Senior Product Manager | Product Portfolio">
  

  

  <header>
    <div class="wrap head">
      <a class="brand" href="#overview" aria-label="Manoj Pant Product Portfolio">
        <img
          class="brand-logo"
          src="https://github.com/mapant.png?size=256"
          alt="Manoj Pant"
          onerror="this.onerror=null;this.src='https://github.com/mapant.png?size=256';"
        />
        <span class="brand-copy">
          <b>Manoj Pant</b>
          <small>Senior Product Manager</small>
        </span>
      </a>

      <nav id="nav" aria-label="Portfolio sections">
        {navItems.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
      </nav>

      <div class="nav-cta">
        <a class="btn primary" href="#portfolio">
          <span class="view-projects-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
              <rect x="4" y="4" width="6" height="6" rx="1"></rect>
              <rect x="14" y="4" width="6" height="6" rx="1"></rect>
              <rect x="4" y="14" width="6" height="6" rx="1"></rect>
              <rect x="14" y="14" width="6" height="6" rx="1"></rect>
            </svg>
          </span>
          <span>View Projects</span>
          <span class="view-projects-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </header>

  <main>
