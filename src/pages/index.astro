const capabilityRows = [
  ['Product', 'Strategy · discovery · roadmap · MVP · prioritization · GTM · adoption'],
  ['AI & GenAI', 'AI-assisted decisioning · GenAI use cases · document intelligence · knowledge workflows · intelligent assistance'],
  ['Automation', 'Rules engines · approval orchestration · exception handling · reconciliation · compliance automation'],
  ['Architecture', 'API-first products · modular platforms · integrations · DFD · ER models · field mapping'],
