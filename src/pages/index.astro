    /* ---------- Desktop height compensation for shorter laptops ---------- */
    @media (min-width:1181px) and (max-height:820px) {
      html:not([data-layout="desktop"]) { --header-h:108px; }
      html:not([data-layout="desktop"]) .slide { padding-top:13px; padding-bottom:12px; }
      html:not([data-layout="desktop"]) #overview .overview-title { font-size:clamp(44px,calc(3.45 * var(--app-vw1, 1vw)),54px); }
      html:not([data-layout="desktop"]) #overview .overview-lead { font-size:13.5px; }
