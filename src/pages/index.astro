      html:not([data-layout="desktop"]) #nav a { font-size: 9.5px; }
    }

    @media (max-width: 560px) {
      html:not([data-layout="desktop"]) .wrap { padding: 0 16px; }
      html:not([data-layout="desktop"]) .overview-stats,
html:not([data-layout="desktop"]) .career-strip,
html:not([data-layout="desktop"]) .ecosystem-grid,
html:not([data-layout="desktop"]) .challenge-cards,
html:not([data-layout="desktop"]) .metrics-grid,
html:not([data-layout="desktop"]) .scope-grid,
html:not([data-layout="desktop"]) .portfolio-grid,
html:not([data-layout="desktop"]) .outcomes-grid { grid-template-columns: 1fr; }
      html:not([data-layout="desktop"]) #overview .model-capabilities,
html:not([data-layout="desktop"]) #overview .expertise-grid { grid-template-columns: 1fr; }
