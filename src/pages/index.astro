    /* ---------- Keep mobile/tablet behavior usable rather than forcing the
       desktop one-viewport system onto narrow screens. ---------- */
    @media (max-width:1180px) {
      html:not([data-layout="desktop"]) .slide { min-height:calc(var(--app-vh, 100dvh)) - var(--header-h)); }
      html:not([data-layout="desktop"]) .slide::before { height:70px; }
    }

    @media (max-width:820px) {
      html:not([data-layout="desktop"]) .slide,
html:not([data-layout="desktop"]) .slide.white,
html:not([data-layout="desktop"]) .slide.soft,
html:not([data-layout="desktop"]) .slide.dark { min-height:auto; height:auto; }
      html:not([data-layout="desktop"]) .slide::before { display:none; }
