                    <path d="M12 3l7 3v5c0 4.7-2.9 8-7 10-4.1-2-7-5.3-7-10V6l7-3z"></path>
                    <path d="m9.5 12 1.7 1.7 3.7-4"></path>
                  </svg>
                </div>
                <strong>10+</strong><span>Years Experience</span>
