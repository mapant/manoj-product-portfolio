    .portfolio-note strong {
      display: block;
      color: var(--navy-900);
      font-size: 10px;
      line-height: 1;
      white-space: nowrap;
    }

    .portfolio-note span {
      display: block;
      margin-top: 5px;
      color: var(--body);
      font-size: 8.5px;
      line-height: 1.3;
    }

    .portfolio-grid {
      display: grid;
      grid-template-columns: repeat(5,minmax(0,1fr));
      gap: 9px;
    }

    .portfolio-card {
      min-width: 0;
      height: 408px;
      padding: 17px;
      border: 1px solid var(--line);
      border-radius: 17px;
      display: flex;
      flex-direction: column;
      background: #fff;
      position: relative;
      overflow: hidden;
    }

    .portfolio-card.blue { background: var(--blue-soft); border-color: #d2e4fa; }
    .portfolio-card.amber { background: var(--amber-soft); border-color: #f1dec1; }
    .portfolio-card.mint { background: var(--mint-soft); border-color: #cbece2; }
    .portfolio-card.lav { background: var(--lav-soft); border-color: #e2d9ff; }
    .portfolio-card.teal { background: var(--teal-soft); border-color: #cce8eb; }

    .portfolio-card::after {
      content: "";
      position: absolute;
      width: 120px;
      height: 120px;
      right: -55px;
      bottom: -55px;
      border-radius: 50%;
      border: 1px solid rgba(16,47,85,.06);
    }

    .portfolio-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .portfolio-number {
      color: var(--amber);
      font-size: 9px;
      line-height: 1;
      font-weight: 950;
    }

    .portfolio-company {
      color: var(--muted);
      font-size: 8px;
      line-height: 1;
      font-weight: 950;
      letter-spacing: .08em;
      white-space: nowrap;
    }

    .portfolio-card h3 {
      margin: 14px 0 8px;
      color: var(--navy-900);
      font-size: 15px;
      line-height: 1.05;
      font-weight: 950;
      letter-spacing: -.02em;
    }

    .portfolio-block {
      margin-top: 9px;
    }

    .portfolio-block label {
      display: block;
      margin-bottom: 4px;
      color: var(--muted);
      font-size: 7.5px;
      line-height: 1;
      font-weight: 950;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .portfolio-block p {
      margin: 0;
      color: var(--body);
      font-size: 8.7px;
      line-height: 1.36;
    }

    .portfolio-outcome {
      margin-top: 10px;
      padding: 9px 10px;
      border-radius: 10px;
      background: rgba(255,255,255,.62);
      border: 1px solid rgba(16,47,85,.06);
    }

    .portfolio-outcome p {
      color: var(--ink-soft);
      font-weight: 750;
    }

    .portfolio-tags {
      margin-top: auto;
      display: flex;
      gap: 5px;
      overflow: hidden;
    }

    .portfolio-tag {
      min-height: 22px;
      padding: 0 7px;
      display: inline-flex;
      align-items: center;
      border: 1px solid rgba(16,47,85,.08);
      border-radius: 999px;
      background: rgba(255,255,255,.68);
      color: var(--ink-soft);
      font-size: 7px;
      line-height: 1;
      font-weight: 900;
      white-space: nowrap;
    }

    .case-link {
      display: inline-flex;
      align-items: center;
      margin-top: 9px;
      color: var(--navy-900);
      text-decoration: none;
      font-size: 8.5px;
      line-height: 1;
      font-weight: 950;
      position: relative;
      z-index: 2;
    }

    .supporting-row {
      margin-top: 12px;
      display: grid;
      grid-template-columns: repeat(6,minmax(0,1fr));
      gap: 7px;
    }

    .supporting-item {
      min-width: 0;
      padding: 9px 10px;
      border: 1px solid var(--line);
      border-radius: 11px;
      background: #fff;
    }

    .supporting-item strong {
      display: block;
      color: var(--navy-900);
      font-size: 8px;
      line-height: 1.05;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: clip;
    }

    .supporting-item span {
      display: block;
      margin-top: 4px;
      color: var(--body);
      font-size: 7px;
      line-height: 1.25;
    }

    /* ======================================================================
       TECH & DATA SLIDE
       ====================================================================== */

    .tech-layout {
      display: grid;
      grid-template-columns: minmax(0,1.04fr) minmax(380px,.96fr);
      gap: 27px;
      align-items: center;
    }

    .capability-table {
      border: 1px solid var(--line);
      border-radius: 18px;
      background: #fff;
      overflow: hidden;
      box-shadow: var(--shadow-xs);
    }

    .capability-row {
      min-height: 57px;
      display: grid;
      grid-template-columns: 145px minmax(0,1fr);
      gap: 18px;
      align-items: center;
      padding: 0 17px;
      border-bottom: 1px solid var(--line-soft);
    }

    .capability-row:last-child { border-bottom: 0; }

    .capability-row strong {
      color: var(--navy-900);
      font-size: 10px;
      line-height: 1;
      font-weight: 950;
      white-space: nowrap;
    }

    .capability-row span {
      color: var(--body);
      font-size: 8.8px;
      line-height: 1.25;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: clip;
    }

    .tech-panel {
      min-height: 474px;
      padding: 24px;
      border-radius: 25px;
      background: var(--navy-900);
      color: #fff;
      position: relative;
      overflow: hidden;
      box-shadow: var(--shadow-md);
    }

    .tech-panel::before {
      content: "";
      position: absolute;
      width: 340px;
      height: 340px;
      right: -135px;
      top: -135px;
      border: 1px solid rgba(255,255,255,.08);
      border-radius: 50%;
    }

    .tech-panel::after {
      content: "";
      position: absolute;
      width: 240px;
      height: 240px;
      left: -150px;
      bottom: -150px;
      border: 1px solid rgba(255,255,255,.06);
      border-radius: 50%;
    }

    .tech-panel-title {
      margin: 15px 0 0;
      color: #fff;
      font-size: 22px;
      line-height: 1.03;
      font-weight: 950;
      letter-spacing: -.035em;
    }

    .tech-panel-sub {
      margin: 7px 0 0;
      color: #9fb8d0;
      font-size: 9px;
      line-height: 1.35;
    }

    .tech-layers {
      display: grid;
      gap: 7px;
      margin-top: 18px;
      position: relative;
      z-index: 2;
    }

    .tech-layer {
      min-height: 55px;
      display: grid;
      grid-template-columns: 25px 105px minmax(0,1fr);
      gap: 10px;
      align-items: center;
      padding: 10px 12px;
      border: 1px solid rgba(255,255,255,.1);
      border-radius: 12px;
      background: rgba(255,255,255,.035);
    }

    .tech-layer .number {
      color: var(--amber-bright);
      font-size: 8px;
    }

    .tech-layer strong {
      color: #fff;
      font-size: 9.5px;
      line-height: 1.1;
      white-space: nowrap;
    }

    .tech-layer span {
      color: #9fb8d0;
      font-size: 7.8px;
      line-height: 1.2;
      white-space: nowrap;
    }

    .tool-row {
      margin-top: 10px;
      display: grid;
      grid-template-columns: repeat(5,1fr);
      gap: 6px;
    }

    .tool {
      min-height: 38px;
      display: grid;
      place-items: center;
      border: 1px solid rgba(255,255,255,.1);
      border-radius: 9px;
      color: #dbe6f1;
      font-size: 7.5px;
      font-weight: 850;
      white-space: nowrap;
    }

    /* ======================================================================
       OUTCOMES SLIDE
       ====================================================================== */

    .outcomes-intro {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 24px;
      margin-bottom: 19px;
    }

    .outcomes-intro .section-head { margin-bottom: 0; }

    .outcomes-note {
      width: 290px;
      flex: 0 0 290px;
      padding: 13px 14px;
      border: 1px solid var(--line);
      border-radius: 13px;
      background: var(--bg);
    }

    .outcomes-note strong {
      display: block;
      color: var(--navy-900);
      font-size: 9px;
      line-height: 1;
      white-space: nowrap;
    }

    .outcomes-note span {
      display: block;
      margin-top: 5px;
      color: var(--body);
      font-size: 8px;
      line-height: 1.3;
    }

    .outcomes-grid {
      display: grid;
      grid-template-columns: repeat(6,minmax(0,1fr));
      gap: 9px;
    }

    .outcome-card {
      height: 246px;
      padding: 20px;
      border-radius: 18px;
      background: var(--navy-900);
      color: #fff;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      overflow: hidden;
    }

    .outcome-card::after {
      content: "";
      position: absolute;
      width: 120px;
      height: 120px;
      right: -55px;
      top: -55px;
      border: 1px solid rgba(255,255,255,.07);
      border-radius: 50%;
    }

    .outcome-card strong {
      color: var(--amber-bright);
      font-size: 29px;
      line-height: 1;
      font-weight: 950;
      letter-spacing: -.035em;
      white-space: nowrap;
      position: relative;
      z-index: 2;
    }

    .outcome-card h3 {
      margin: 0;
      color: #fff;
      font-size: 13px;
      line-height: 1.16;
      font-weight: 900;
      position: relative;
      z-index: 2;
    }

    .outcome-card span {
      color: #8fa8c0;
      font-size: 7.5px;
      line-height: 1;
      font-weight: 900;
      letter-spacing: .08em;
      text-transform: uppercase;
      white-space: nowrap;
      position: relative;
      z-index: 2;
    }

    .outcome-summary {
      margin-top: 12px;
      display: grid;
      grid-template-columns: repeat(4,1fr);
      gap: 8px;
    }

    .outcome-summary-item {
      padding: 11px 13px;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: #fff;
    }

    .outcome-summary-item strong {
      display: block;
      color: var(--navy-900);
      font-size: 9px;
      line-height: 1;
      white-space: nowrap;
    }

    .outcome-summary-item span {
      display: block;
      margin-top: 4px;
      color: var(--body);
      font-size: 7.5px;
      line-height: 1.2;
    }

    /* ======================================================================
       CONNECT SLIDE
       ====================================================================== */

    .contact-grid {
      display: grid;
      grid-template-columns: minmax(0,1.12fr) minmax(360px,.88fr);
      gap: 45px;
      align-items: center;
    }

    .contact-title {
      margin: 16px 0 12px;
      color: #fff;
      font-size: clamp(45px,calc(4.2 * var(--app-vw1, 1vw)),64px);
      line-height: .97;
      font-weight: 950;
      letter-spacing: -.06em;
      white-space: nowrap;
    }

    .contact-copy {
      max-width: 850px;
      margin: 0;
      color: #b8cbe0;
      font-size: 15px;
      line-height: 1.42;
    }

    .contact-focus {
      margin-top: 20px;
      display: flex;
      gap: 7px;
      flex-wrap: nowrap;
    }

    .contact-focus .pill {
      border-color: rgba(255,255,255,.13);
      background: rgba(255,255,255,.045);
      color: #fff;
    }

    .contact-card {
      padding: 25px;
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 23px;
      background: rgba(255,255,255,.035);
      box-shadow: 0 18px 40px rgba(0,0,0,.1);
    }

    .contact-link {
      min-height: 49px;
      margin-top: 9px;
      padding: 0 15px;
      display: flex;
      align-items: center;
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 12px;
      color: #fff;
      text-decoration: none;
      font-size: 11px;
      line-height: 1;
      font-weight: 850;
      white-space: nowrap;
    }

    .contact-link.primary {
      background: var(--amber);
      border-color: var(--amber);
      box-shadow: 0 9px 20px rgba(196,123,13,.17);
    }

    .contact-link:hover { background-color: rgba(255,255,255,.07); }
    .contact-link.primary:hover { background-color: #d18718; }

    .contact-foot {
      margin-top: 28px;
      padding-top: 13px;
      border-top: 1px solid rgba(255,255,255,.1);
      display: flex;
      justify-content: space-between;
      gap: 20px;
      color: #7894b0;
      font-size: 8px;
      line-height: 1;
      font-weight: 900;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

