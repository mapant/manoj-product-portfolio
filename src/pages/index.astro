      html:not([data-layout="desktop"]) .ecosystem-story h3 { font-size: 31px; }
      html:not([data-layout="desktop"]) .eco-card span { font-size: 10px; }
      html:not([data-layout="desktop"]) .portfolio-block p { font-size: 9.5px; }
    }

    @media (max-width: 820px) {
      html:not([data-layout="desktop"]) .ecosystem-grid-layout { grid-template-columns: 1fr; }
      html:not([data-layout="desktop"]) .strategy-flow { grid-template-columns: repeat(2,minmax(0,1fr)); }
      html:not([data-layout="desktop"]) .strategy-step { height: auto; min-height: 145px; }
      html:not([data-layout="desktop"]) .section-head h2 { font-size: clamp(32px, calc(7 * var(--app-vw1, 1vw)), 44px); }
    }


    /* ======================================================================
       FINAL CLEAN-UI SYSTEM — CONSISTENT TYPOGRAPHY / CONTRAST / ALIGNMENT
       This layer intentionally overrides earlier experimental sizing without
       deleting the original content or component structure.
       ====================================================================== */

    :root {
      --font-ui: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      --text-strong: #173a63;
      --text-body: #4f6780;
      --text-soft: #667d93;
      --text-on-dark: #f8fbff;
      --text-on-dark-soft: #c7d6e6;
      --pastel-blue: #edf5ff;
      --pastel-mint: #edf9f5;
      --pastel-lavender: #f4f0ff;
      --pastel-amber: #fff6e8;
      --pastel-teal: #edf8fa;
      --pastel-sand: #fbf7ef;
      --footer-ink: #244d76;
    }

    html, body, button, input, textarea, select, a {
      font-family: var(--font-ui);
    }

    body {
      color: var(--text-body);
      font-size: 14px;
      line-height: 1.5;
    }

    .wrap {
      max-width: 1920px;
      padding-left: 42px;
      padding-right: 42px;
    }

    /* One typographic hierarchy across every section. */
    .eyebrow {
