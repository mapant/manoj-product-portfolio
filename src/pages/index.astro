    /* ======================================================================
       1920 × 1200 DESKTOP ALIGNMENT PATCH
       ----------------------------------------------------------------------
       Purpose: preserve the complete existing portfolio markup/content while
       making the 10 slides fit a normal desktop browser at 100% zoom.
       This is intentionally appended as an override layer; no original
       section, component, diagram, text or interaction is removed.
       ====================================================================== */
      html[data-layout="desktop"] {
        --header-h: 88px;
        --max: 1840px;
      }

      html[data-layout="desktop"],
html[data-layout="desktop"] body { overflow: hidden; }

      html[data-layout="desktop"] header {
        height: var(--header-h);
      }

      html[data-layout="desktop"] .wrap {
        max-width: var(--max);
        padding-left: 24px;
        padding-right: 24px;
      }

      html[data-layout="desktop"] #nav {
        height: 72px;
        gap: 3px 8px;
      }

      html[data-layout="desktop"] #nav a {
        min-height: 30px;
        padding: 6px 8px;
        font-size: 11.5px;
      }

      html[data-layout="desktop"] .brand-logo {
        width: 44px;
        height: 44px;
        flex-basis: 44px;
      }

      html[data-layout="desktop"] .brand-copy b { font-size: 16px; }
      html[data-layout="desktop"] .brand-copy small { font-size: 9px; margin-top: 5px; }
      html[data-layout="desktop"] .btn { min-height: 40px; padding: 0 16px; font-size: 11.5px; }

      html[data-layout="desktop"] main {
        height: calc(var(--app-vh, 100dvh)) - var(--header-h));
        overflow-y: auto;
        scroll-snap-type: y mandatory;
      }

      html[data-layout="desktop"] .slide {
        height: calc(var(--app-vh, 100dvh)) - var(--header-h));
        min-height: 0;
        padding: 12px 0;
        overflow: hidden;
        scroll-snap-align: start;
        scroll-snap-stop: always;
      }

      html[data-layout="desktop"] .slide > .wrap {
        height: 100%;
        min-height: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      /* Typography must wrap instead of clipping at 100% browser zoom. */
      html[data-layout="desktop"] .section-head {
        flex: 0 0 auto;
        margin-bottom: 12px;
      }
      html[data-layout="desktop"] .section-head h2,
html[data-layout="desktop"] .section-head p {
        white-space: normal;
        overflow: visible;
        text-overflow: clip;
      }
      html[data-layout="desktop"] .section-head h2 {
        font-size: clamp(30px, calc(2.45 * var(--app-vw1, 1vw)), 46px);
        line-height: 1.02;
        margin-top: 8px;
        margin-bottom: 6px;
      }
      html[data-layout="desktop"] .section-head p {
        max-width: 1100px;
        font-size: 13px;
        line-height: 1.28;
      }

      /* 01 / OVERVIEW ----------------------------------------------------- */
