---

<PortfolioLayout title="Manoj Pant | Senior Product Manager | Product Portfolio">
  <style>
    /* ======================================================================
       DESIGN SYSTEM
       ====================================================================== */

    :root {
      --navy-950: #0b2443;
      --navy-900: #102f55;
      --navy-800: #163d6a;
      --navy-700: #234f7c;
      --ink: #15385f;
      --ink-soft: #466887;
      --body: #587795;
      --muted: #7890a8;
      --faint: #9aaec1;
      --line: #d8e4ef;
      --line-strong: #c9d9e7;
      --line-soft: #eaf0f5;
      --bg: #f5f8fb;
      --paper: #ffffff;
      --blue: #2167d3;
      --blue-soft: #edf5ff;
      --amber: #c47b0d;
      --amber-bright: #e09a2b;
      --amber-soft: #fff7e9;
      --mint: #17886f;
      --mint-soft: #eefaf6;
      --lav: #7356d5;
      --lav-soft: #f5f1ff;
      --teal: #147c86;
      --teal-soft: #edf9fa;
      --red: #a74a43;
      --shadow-xs: 0 4px 14px rgba(16,47,85,.035);
      --shadow-sm: 0 10px 26px rgba(16,47,85,.055);
      --shadow-md: 0 18px 44px rgba(16,47,85,.08);
      --radius-sm: 10px;
      --radius-md: 16px;
      --radius-lg: 24px;
      --header-h: 112px;
      --max: 1920px;
      --sans: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    /* ======================================================================
       BASE / VIEWPORT
       ====================================================================== */

    * { box-sizing: border-box; }

    html {
      scroll-behavior: smooth;
      background: var(--bg);
      overflow: hidden;
    }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: var(--sans);
      font-size: 14px;
      line-height: 1.45;
      overflow: hidden;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }

    a { color: inherit; }
    button, a { -webkit-tap-highlight-color: transparent; }

    main {
      height: calc(var(--app-vh, 100dvh)) - var(--header-h));
      overflow-y: auto;
      overflow-x: hidden;
      scroll-snap-type: y mandatory;
      scrollbar-width: thin;
      scrollbar-color: #b8c9d9 transparent;
    }

    .slide {
      height: calc(var(--app-vh, 100dvh)) - var(--header-h));
      min-height: 720px;
      width: 100%;
      overflow: hidden;
      position: relative;
      display: flex;
      align-items: center;
      scroll-snap-align: start;
      scroll-snap-stop: always;
      padding: 30px 0 28px;
      isolation: isolate;
    }

    .slide.white { background: var(--paper); }
    .slide.soft { background: var(--bg); }
    .slide.dark { background: var(--navy-900); color: #fff; }

    .wrap {
      width: 100%;
      max-width: var(--max);
      margin: 0 auto;
      padding: 0 34px;
      position: relative;
      z-index: 2;
    }

    /* ======================================================================
       HEADER / NAVIGATION
       Shared visual system with the Integrated Channels Suite case-study page
       ====================================================================== */

    header {
      position: fixed;
      inset: 0 0 auto;
      width: 100%;
      z-index: 1200;
      height: var(--header-h);
      background: #102f55;
      color: #fff;
      border-bottom: 1px solid rgba(255,255,255,.10);
      box-shadow: 0 10px 24px rgba(8,28,51,.18);
    }

    .head {
      height: var(--header-h);
      display: grid;
      grid-template-columns: 280px minmax(530px,1fr) 250px;
      gap: 10px;
      align-items: center;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
      text-decoration: none;
    }

    .brand-logo {
      width: 82px;
      height: 82px;
      flex: 0 0 82px;
      border-radius: 50%;
      object-fit: cover;
      object-position: center 18%;
      border: 3px solid rgba(255,255,255,.72);
      background: #244f7f;
      box-shadow: 0 4px 12px rgba(0,0,0,.18);
    }

    .brand-copy {
      min-width: 0;
    }

    .brand-copy b {
      display: block;
      color: #fff;
      font-size: 18px;
      line-height: 1.1;
      font-weight: 900;
      letter-spacing: -.02em;
      white-space: nowrap;
    }

    .brand-copy small {
      display: block;
      margin-top: 5px;
      color: #c1d2e4;
      font-size: 8.5px;
      line-height: 1.15;
      font-weight: 900;
      letter-spacing: .035em;
      text-transform: uppercase;
      white-space: nowrap;
      overflow: visible;
      text-overflow: clip;
    }

    #nav {
      display: grid;
      grid-template-columns: repeat(5,max-content);
      grid-template-rows: repeat(2,30px);
      gap: 2px 22px;
      align-items: center;
      justify-content: end;
      min-width: 0;
    }

    #nav a {
      min-width: 0;
      display: grid;
      place-items: center;
      height: 30px;
      padding: 0 5px;
      border-radius: 8px;
      color: #eaf1f7;
      text-decoration: none;
      font-size: 10px;
      line-height: 1;
      font-weight: 900;
      white-space: nowrap;
      text-align: right;
      transition: background .15s ease, color .15s ease, transform .15s ease;
    }

    #nav a:hover {
      background: #234f7f;
      color: #fff;
    }

    #nav a.active {
      background: #234f7f;
      color: #fff;
    }

    .nav-cta {
      display: flex;
      justify-content: flex-end;
    }

    .btn {
      min-height: 42px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0 19px;
      border-radius: 11px;
      text-decoration: none;
      font-size: 12px;
      line-height: 1;
      font-weight: 950;
      white-space: nowrap;
      transition: transform .15s ease, box-shadow .15s ease, background .15s ease;
    }

    .btn.primary {
      background: #2a5c8d;
      color: #fff;
      border: 1px solid #547ca5;
      box-shadow: none;
    }

    .btn.primary:hover {
      transform: translateY(-1px);
      box-shadow: 0 8px 18px rgba(10,36,65,.16);
      background: #316a9f;
    }

    main {
      margin-top: var(--header-h);
    }

    /* ======================================================================
       TYPOGRAPHY / SECTION HEADERS
       ====================================================================== */

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      color: var(--amber);
      font-size: 10.5px;
      line-height: 1;
      font-weight: 950;
      letter-spacing: .15em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .eyebrow::before {
      content: "";
      width: 30px;
      height: 3px;
      flex: 0 0 30px;
      background: var(--amber);
      border-radius: 99px;
    }

    .section-head {
      margin-bottom: 22px;
    }

    .section-head h2 {
      margin: 10px 0 8px;
      color: var(--navy-900);
      font-size: clamp(34px, calc(3.1 * var(--app-vw1, 1vw)), 50px);
      line-height: .98;
      font-weight: 950;
      letter-spacing: -.052em;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: clip;
    }

    .section-head p {
      max-width: 1040px;
      margin: 0;
      color: var(--body);
      font-size: 14.5px;
      line-height: 1.32;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: clip;
    }

    .dark .section-head h2 { color: #fff; }
    .dark .section-head p { color: #b9cbe0; }
    .dark .eyebrow { color: var(--amber-bright); }
    .dark .eyebrow::before { background: var(--amber-bright); }

    .mini-label {
      color: var(--muted);
      font-size: 9px;
      line-height: 1;
      font-weight: 900;
      letter-spacing: .1em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .body-copy {
      margin: 0;
      color: var(--body);
      font-size: 13px;
      line-height: 1.48;
    }

    /* ======================================================================
       GENERIC COMPONENTS
       ====================================================================== */

    .pill-row {
      display: flex;
      align-items: center;
      flex-wrap: nowrap;
      gap: 7px;
      min-width: 0;
    }

    .pill {
      min-height: 29px;
      display: inline-flex;
      align-items: center;
      padding: 0 11px;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: #fff;
      color: var(--ink-soft);
      font-size: 9.5px;
      line-height: 1;
      font-weight: 850;
      white-space: nowrap;
    }

    .card {
      min-width: 0;
      border: 1px solid var(--line);
      border-radius: var(--radius-md);
      background: var(--paper);
      box-shadow: var(--shadow-xs);
    }

    .number {
      color: var(--amber);
      font-size: 10px;
      line-height: 1;
      font-weight: 950;
      letter-spacing: .06em;
    }

    .soft-rule {
      height: 1px;
      background: var(--line);
      width: 100%;
    }

    .dark-rule {
      height: 1px;
      background: rgba(255,255,255,.11);
      width: 100%;
    }

    /* ======================================================================
       OVERVIEW SLIDE
       ====================================================================== */

    .overview-grid {
      display: grid;
      grid-template-columns: minmax(0,1.04fr) minmax(500px,.96fr);
      gap: 48px;
      align-items: center;
    }

    .hero-kicker {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      color: var(--amber);
      font-size: 10px;
      line-height: 1;
      font-weight: 950;
      letter-spacing: .13em;
      text-transform: uppercase;
    }

    .hero-kicker::before {
      content: "";
      width: 28px;
      height: 3px;
      border-radius: 99px;
      background: var(--amber);
    }

    .overview-title {
      margin: 13px 0 16px;
      max-width: 820px;
      color: var(--text-strong);
