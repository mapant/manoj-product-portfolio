                  <strong>{title}</strong>
                  <span>{text}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="tech-panel">
            <span class="eyebrow">Product Technology Model</span>
            <h3 class="tech-panel-title">I translate business intent into product behavior and technical context.</h3>
            <p class="tech-panel-sub">The product layer sits between the business problem and the systems that execute it.</p>

            <div class="tech-layers">
              {techLayers.map(([number, title, text]) => (
                <div class="tech-layer">
                  <span class="number">{number}</span>
                  <strong>{title}</strong>
                  <span>{text}</span>
                </div>
              ))}
            </div>

            <div class="tool-row">
              {['SQL', 'Power BI', 'Tableau', 'Figma', 'JIRA'].map((tool) => <div class="tool">{tool}</div>)}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================================================================
         09 / OUTCOMES
         ================================================================== -->
    <section class="slide white" id="outcomes">
      <div class="wrap">
        <div class="outcomes-intro">
