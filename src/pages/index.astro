  ['07', 'Learn', 'Use feedback, usage, exceptions and operational signals to improve the product.'],
  ['08', 'Measure', 'Connect adoption, efficiency, quality and business outcomes back to the roadmap.']
];

const prioritization = [
  ['Customer Value', 'Does it solve a meaningful user problem?'],
  ['Business Value', 'Does it improve revenue, cost, productivity or service?'],
  ['Risk / Compliance', 'Does it reduce regulatory or operational exposure?'],
  ['AI / Automation', 'Can intelligence or automation materially improve the flow?'],
  ['Feasibility', 'Can technology and data support the intended outcome?'],
  ['Effort', 'What delivery complexity and dependency does it introduce?']
];

const pmScope = [
  ['01', 'Discover', 'Customer workshops, stakeholder interviews, process mapping, use cases and problem framing.', ['Discovery', 'Process maps', 'Use cases']],
  ['02', 'Define', 'Business and functional requirements translated into journeys, capabilities and acceptance criteria.', ['BRD / FRD / FSD', 'User stories', 'Acceptance criteria']],
