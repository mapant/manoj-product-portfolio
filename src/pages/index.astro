              <strong>{metric}</strong>
              <h3>{label}</h3>
              <span>{company} · {type}</span>
            </article>
          ))}
        </div>

        <div class="outcome-summary">
          <div class="outcome-summary-item"><strong>Adoption</strong><span>Doctor adoption, provider journeys and user engagement.</span></div>
          <div class="outcome-summary-item"><strong>Efficiency</strong><span>Turnaround time, reconciliation and manual effort.</span></div>
          <div class="outcome-summary-item"><strong>Automation</strong><span>Rules, workflow automation and operational processing.</span></div>
          <div class="outcome-summary-item"><strong>Business impact</strong><span>Cost optimization, productivity and service performance.</span></div>
        </div>
      </div>
    </section>

    <!-- ==================================================================
         10 / CONNECT
         ================================================================== -->
