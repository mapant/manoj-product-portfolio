      text-overflow: unset;
      font-size: 14px;
      line-height: 1.42;
      max-width: 980px;
    }

    /* OVERVIEW typography is defined in the main Overview component block above. */

    /* ECOSYSTEM: wider statement column so the headline reads as a clean
       3-line statement instead of a narrow 5-line block. */
    .ecosystem-grid-layout {
      grid-template-columns: minmax(560px,.9fr) minmax(0,1.1fr);
      gap: 32px;
    }
    .ecosystem-story { padding: 30px; min-height: 525px; }
