    .challenge-card p { font-size: 11px; line-height: 1.46; }
    .challenge-card .response { font-size: 9px; line-height: 1.25; white-space: normal; }

    /* STRATEGY: 4 x 2 gives every step enough width for readable copy. */
    .strategy-flow { grid-template-columns: repeat(4,minmax(0,1fr)); gap: 10px; }
    .strategy-step { height: 158px; padding: 17px 16px; }
    .strategy-step:not(:last-child)::after { display: none; }
    .strategy-step strong { font-size: 14px; }
    .strategy-step p { font-size: 10.5px; line-height: 1.42; }
