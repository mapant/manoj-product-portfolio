      line-height: 1.1;
      letter-spacing: .14em;
    }

    .section-head {
      margin-bottom: 18px;
    }

    .section-head h2 {
      color: var(--text-strong);
      font-size: clamp(36px, calc(3.05 * var(--app-vw1, 1vw)), 48px);
      line-height: 1.04;
      letter-spacing: -.045em;
      font-weight: 850;
      margin: 10px 0 8px;
      white-space: normal;
      overflow: visible;
    }

    .section-head p {
      color: var(--text-body);
      font-size: 14px;
      line-height: 1.48;
      white-space: normal;
      overflow: visible;
      max-width: 980px;
    }

    .dark .section-head h2 { color: var(--text-on-dark); }
    .dark .section-head p { color: var(--text-on-dark-soft); }

    /* Overview is intentionally kept on the component-level design system above. */

    /* Ecosystem: give the narrative column enough width for a 3-line headline,
