    /* ======================================================================
       TYPOGRAPHY / READABILITY PASS
       ====================================================================== */

    /* Section titles may wrap when needed; never clip meaningful content. */
    .section-head h2 {
      white-space: normal;
      overflow: visible;
      text-overflow: unset;
      font-size: clamp(34px, calc(3 * var(--app-vw1, 1vw)), 48px);
