    title: 'Provider Payout Automation',
    problem: 'Provider payout processing involved rules, approvals, calculations and operational hand-offs.',
    ownership: 'Workflow design, rules, approval states, exception handling, operational reporting and process automation.',
    outcome: 'Provider payout turnaround represented in the portfolio moved from 10 days to 2 days.',
    tags: ['Automation', 'Rules', 'Approvals', 'Healthcare'],
    url: '/projects/provider-payout',
    tint: 'lav'
  },
  {
    number: '05',
    company: 'NOKIA NETWORKS',
    title: 'Telecom Analytics & Cost Optimization',
    problem: 'Large operational datasets needed clearer financial visibility, KPI tracking and cost-control decisions.',
