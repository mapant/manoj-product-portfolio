const techLayers = [
  ['01', 'Business layer', 'Goals · users · process · economics · operating constraints'],
  ['02', 'Product layer', 'Vision · journeys · roadmap · capabilities · requirements'],
  ['03', 'Intelligence layer', 'AI / GenAI · decisioning · document intelligence · product analytics'],
