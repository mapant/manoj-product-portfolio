    /* ======================================================================
       FINAL DESKTOP PRESENTATION CANVAS — STABILITY FIX
       ----------------------------------------------------------------------
       This override intentionally sits last in the existing stylesheet so it
       wins over the earlier iterative desktop patches without deleting or
       rewriting any existing markup/content.

       Design principle:
       - One fixed desktop coordinate system: 1840 × 1072 CSS px.
       - 1920 × 1200 @ 100% is the reference viewport.
       - Browser zoom changes the physical scale of this canvas; it does not
         cause the cards/diagrams/grids to reflow independently.
       - Internal section geometry is therefore stable across 75/80/90/100%.
       ====================================================================== */
      html[data-layout="desktop"] {
        --header-h: 88px !important;
        --desktop-canvas-w: 1840px;
        --desktop-slide-h: 1072px;
      }

      html[data-layout="desktop"],
html[data-layout="desktop"] body {
        overflow: hidden !important;
      }

      html[data-layout="desktop"] header {
        height: var(--header-h) !important;
        min-height: var(--header-h) !important;
      }

      html[data-layout="desktop"] header {
        overflow: hidden !important;
      }

      html[data-layout="desktop"] header .wrap.head {
        width: min(var(--desktop-canvas-w), calc(var(--app-vw, calc(100 * var(--app-vw1, 1vw))) - 48px)) !important;
        max-width: min(var(--desktop-canvas-w), calc(var(--app-vw, calc(100 * var(--app-vw1, 1vw))) - 48px)) !important;
        height: var(--header-h) !important;
        margin: 0 auto !important;
        padding: 0 !important;
        transform: none !important;
      }

      html[data-layout="desktop"] main {
        height: calc(var(--app-vh, 100dvh)) - var(--header-h)) !important;
        min-height: 0 !important;
        overflow-x: hidden !important;
        overflow-y: auto !important;
        scroll-snap-type: y mandatory !important;
      }

      /* Every section is the same presentation canvas. */
      html[data-layout="desktop"] main > .slide {
        width: 100% !important;
        height: var(--desktop-slide-h) !important;
        min-height: var(--desktop-slide-h) !important;
        max-height: var(--desktop-slide-h) !important;
        padding: 0 !important;
        margin: 0 !important;
        overflow: hidden !important;
        display: block !important;
        position: relative !important;
        scroll-snap-align: start !important;
        scroll-snap-stop: always !important;
      }

      /*
       * The wrap is the actual slide coordinate system. It is deliberately
       * fixed rather than using vw/vh percentages. The whole coordinate
       * system is then uniformly scaled to the available viewport.
       */
      html[data-layout="desktop"] main > .slide > .wrap {
        width: var(--desktop-canvas-w) !important;
        max-width: var(--desktop-canvas-w) !important;
        height: var(--desktop-slide-h) !important;
        min-height: var(--desktop-slide-h) !important;
        max-height: var(--desktop-slide-h) !important;
        margin: 0 auto !important;
        padding: 0 !important;
        position: relative !important;
        display: flex !important;
        flex-direction: column !important;
        justify-content: center !important;
        transform-origin: center top !important;
        transform: scale(min(1, calc((var(--app-vw, calc(100 * var(--app-vw1, 1vw))) - 48px) / var(--desktop-canvas-w)), calc((var(--app-vh, 100dvh)) - var(--header-h) - 12px) / var(--desktop-slide-h)))) !important;
      }

      /* Do not let viewport height leak back into the internal slide system. */
      html[data-layout="desktop"] #overview .overview-grid,
html[data-layout="desktop"] #ecosystem .ecosystem-grid-layout,
html[data-layout="desktop"] #challenge .challenge-layout,
html[data-layout="desktop"] #strategy .strategy-shell,
html[data-layout="desktop"] #scope .ref-scope-layout,
html[data-layout="desktop"] #metrics .ref-metrics-layout,
html[data-layout="desktop"] #tech .ref-tech-layout,
html[data-layout="desktop"] #contact .ref-connect-wrap {
        height: 100% !important;
        min-height: 0 !important;
        max-height: 100% !important;
