  'FinTech',
  'Health Tech',
  'AI Strategy',
  'Copilot',
  'Product Development'
];

const careerArc = [
  ['01', 'Analytics', 'SQL · Power BI · Tableau · KPI reporting'],
  ['02', 'Business Analysis', 'Requirements · process design · stakeholder discovery'],
  ['03', 'Technical Product', 'APIs · workflows · data flows · solution collaboration'],
  ['04', 'Product Management', 'Strategy · roadmap · delivery · adoption · outcomes']
];

const ecosystem = [
  { title: 'Business', text: 'Goals, economics and operating constraints', type: 'business', details: ['Business strategy & OKRs', 'Revenue, cost and productivity', 'Operating model and constraints'] },
  { title: 'Customer', text: 'Journeys, pain points and adoption', type: 'customer', details: ['User personas and segments', 'Journey mapping and NPS', 'Adoption and experience metrics'] },
  { title: 'Product', text: 'Vision, roadmap, capabilities and experience', type: 'product', details: ['Product strategy and roadmap', 'Capabilities and features', 'Omnichannel experience'] },
