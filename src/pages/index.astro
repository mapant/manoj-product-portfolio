    /* ======================================================================
       FINAL STATIC DESKTOP LAYOUT — 1920 CSS px / 100% ZOOM
       ----------------------------------------------------------------------
       This is an additive override layer. No existing markup, content,
       diagrams, links or interactions are removed. The desktop canvas uses
       fixed CSS-pixel geometry so browser zoom changes the physical scale,
       not the internal composition. The same composition therefore remains
       stable at 75%, 80%, 90%, 100%, etc. on a desktop viewport.
       ====================================================================== */
      html[data-layout="desktop"] {
        --header-h: 88px;
        --desktop-canvas: 1840px;
        --desktop-gap: 18px;
      }

      html[data-layout="desktop"],
html[data-layout="desktop"] body {
        overflow: hidden;
      }

      html[data-layout="desktop"] header {
        height: 88px !important;
        min-height: 88px !important;
      }

      html[data-layout="desktop"] header .wrap.head {
        width: 1840px !important;
        max-width: 1840px !important;
        height: 88px !important;
        padding: 0 !important;
        grid-template-columns: 300px minmax(0,1fr) 250px !important;
        gap: 18px !important;
      }

      html[data-layout="desktop"] .brand-logo {
        width: 64px !important;
        height: 64px !important;
        flex-basis: 64px !important;
      }

      html[data-layout="desktop"] .brand-copy b { font-size: 17px !important; }
      html[data-layout="desktop"] .brand-copy small { font-size: 8.5px !important; }

      html[data-layout="desktop"] #nav {
        grid-template-columns: repeat(5, minmax(0,1fr)) !important;
        grid-template-rows: repeat(2, 30px) !important;
        gap: 2px 10px !important;
        justify-content: stretch !important;
        width: 100% !important;
      }

      html[data-layout="desktop"] #nav a {
        height: 30px !important;
        min-height: 30px !important;
        padding: 0 8px !important;
        font-size: 11px !important;
        text-align: center !important;
      }

      html[data-layout="desktop"] .nav-cta { justify-content: flex-end !important; }
      html[data-layout="desktop"] .btn.primary {
        min-width: 236px !important;
        min-height: 50px !important;
        height: 50px !important;
        padding: 0 22px !important;
      }

      html[data-layout="desktop"] main {
        width: 100% !important;
        height: calc(var(--app-vh, 100dvh)) - 88px) !important;
        overflow-y: auto !important;
        overflow-x: hidden !important;
        scroll-snap-type: y mandatory !important;
      }

      html[data-layout="desktop"] .slide {
        width: 100% !important;
        height: calc(var(--app-vh, 100dvh)) - 88px) !important;
        min-height: 0 !important;
        max-height: calc(var(--app-vh, 100dvh)) - 88px) !important;
        padding: 14px 0 !important;
        overflow: hidden !important;
        align-items: stretch !important;
        scroll-snap-align: start !important;
        scroll-snap-stop: always !important;
      }

      html[data-layout="desktop"] .slide > .wrap {
        width: 1840px !important;
        max-width: 1840px !important;
        height: 100% !important;
        min-height: 0 !important;
        margin: 0 auto !important;
        padding: 0 !important;
        display: flex !important;
        flex-direction: column !important;
        justify-content: center !important;
      }

      html[data-layout="desktop"] .slide * { min-width: 0; }
      html[data-layout="desktop"] .slide p,
html[data-layout="desktop"] .slide span,
html[data-layout="desktop"] .slide li,
html[data-layout="desktop"] .slide small,
html[data-layout="desktop"] .slide strong,
html[data-layout="desktop"] .slide h2,
html[data-layout="desktop"] .slide h3,
html[data-layout="desktop"] .slide label {
        overflow-wrap: break-word;
        word-break: normal;
      }

