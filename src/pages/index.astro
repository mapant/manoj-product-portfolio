---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import Header from '../components/Header.astro';
import Overview from '../components/sections/Overview.astro';
import Ecosystem from '../components/sections/Ecosystem.astro';
import Challenge from '../components/sections/Challenge.astro';
import Strategy from '../components/sections/Strategy.astro';
import PMScope from '../components/sections/PMScope.astro';
import Metrics from '../components/sections/Metrics.astro';
import Portfolio from '../components/sections/Portfolio.astro';
import TechData from '../components/sections/TechData.astro';
import Outcomes from '../components/sections/Outcomes.astro';
import Connect from '../components/sections/Connect.astro';
import '../styles/portfolio.scss';
---

<PortfolioLayout title="Manoj Pant | Senior Product Manager | Product Portfolio">
  <div class="portfolio-root viewport-fit-prototype">
    <Header />
    <main id="portfolio-main" aria-label="Product portfolio">
      <Overview />
      <Ecosystem />
      <Challenge />
      <Strategy />
      <PMScope />
      <Metrics />
      <Portfolio />
      <TechData />
      <Outcomes />
      <Connect />
    </main>
  </div>
  <script>
    import '../scripts/navigation.js';
  </script>
</PortfolioLayout>
