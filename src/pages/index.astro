const strategyOutcomes = [
  ['Strategy outcomes', 'A consistent approach that turns strategy into measurable business impact.', 'target'],
  ['Higher customer satisfaction', 'Better user experience and adoption.', 'people'],
  ['Measurable business impact', 'Revenue, efficiency and cost optimization.', 'chart'],
