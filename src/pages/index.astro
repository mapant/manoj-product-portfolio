    /* ---------- Shared Overview visual language for every section ---------- */
    .slide.white,
    .slide.soft,
    .slide.dark {
      background:
        radial-gradient(circle at 92% 8%, rgba(76,137,255,.075), transparent 24%),
        radial-gradient(circle at 12% 92%, rgba(112,65,239,.055), transparent 25%),
        linear-gradient(145deg, #f8fbff 0%, #f2f7fc 58%, #fbf8ff 100%);
      color: var(--portfolio-ink);
    }

    .slide.dark {
      color: var(--portfolio-ink);
    }

    .slide.dark::before,
    .slide.soft::before,
    .slide.white::before {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      background-image: radial-gradient(rgba(33,103,211,.075) 1px, transparent 1px);
      background-size: 24px 24px;
      opacity: .25;
      mask-image: linear-gradient(90deg, transparent 0%, #000 18%, #000 82%, transparent 100%);
    }

    .section-head {
      margin-bottom: 18px;
    }

    .section-head h2,
    .challenge-lead h3,
    .metrics-story h3,
    .contact-title {
      color: var(--portfolio-ink);
      letter-spacing: -.045em;
    }

    .section-head p,
    .challenge-lead p,
    .metrics-story p,
    .portfolio-note span,
    .outcomes-note span {
      color: var(--portfolio-body);
    }

    .eyebrow {
      color: #245a95;
    }

    .eyebrow::before {
      background: linear-gradient(90deg, #1788ef, #6c3ff0);
    }

    /* ---------- Ecosystem ---------- */
    #ecosystem .ecosystem-grid-layout {
      grid-template-columns: minmax(310px,.78fr) minmax(0,1.22fr);
      gap: 24px;
    }

    #ecosystem .ecosystem-story {
      min-height: 0;
      height: 100%;
      padding: 26px;
      border: 1px solid #a9d0ff;
      border-radius: 24px;
      background: linear-gradient(145deg, #eef8ff, #f6f2ff);
      color: var(--portfolio-ink);
      box-shadow: 0 18px 42px rgba(41,89,145,.09);
    }

    #ecosystem .ecosystem-story h3 { color: var(--portfolio-ink); }
    #ecosystem .ecosystem-story p { color: var(--portfolio-body); }
    #ecosystem .story-point { color: var(--portfolio-ink); }
    #ecosystem .story-point i { background: linear-gradient(135deg,#1687ef,#713df0); }
    #ecosystem .ecosystem-story-foot { color: #62809f; border-color: #d8e6f4; }

    #ecosystem .ecosystem-panel {
      border-color: #b9d7f7;
      border-radius: 24px;
      background: rgba(255,255,255,.72);
      box-shadow: 0 18px 42px rgba(41,89,145,.075);
      backdrop-filter: blur(8px);
    }

    #ecosystem .eco-card {
      border-radius: 15px;
      box-shadow: 0 10px 24px rgba(41,89,145,.055);
    }

    #ecosystem .eco-card:nth-child(3n+1) { background:#eef8ff; border-color:#b9ddff; }
    #ecosystem .eco-card:nth-child(3n+2) { background:#f5f0ff; border-color:#d9c8ff; }
    #ecosystem .eco-card:nth-child(3n) { background:#eefbf8; border-color:#bde9df; }

    /* ---------- Challenge ---------- */
    #challenge .challenge-lead,
    #challenge .challenge-card,
    #strategy .strategy-step,
    #strategy .strategy-principle,
    #strategy .priority-panel,
    #scope .scope-card,
    #metrics .metrics-story,
    #metrics .metric-group,
    #tech .capability-table,
    #tech .tech-panel,
    #outcomes .outcomes-note {
      border-color: #c9dcf0;
      box-shadow: 0 12px 30px rgba(41,89,145,.055);
    }

    #challenge .challenge-lead {
      background: linear-gradient(145deg,#edf8ff,#f8f4ff);
      border-radius: 22px;
    }

    #challenge .challenge-card:nth-child(3n+1) { background:linear-gradient(145deg,#f0f8ff,#ffffff); border-top:3px solid #2687f2; }
    #challenge .challenge-card:nth-child(3n+2) { background:linear-gradient(145deg,#f8f2ff,#ffffff); border-top:3px solid #7544ee; }
    #challenge .challenge-card:nth-child(3n) { background:linear-gradient(145deg,#fff8ed,#ffffff); border-top:3px solid #f39a20; }

    /* ---------- Strategy ---------- */
    #strategy .strategy-step {
      background: linear-gradient(145deg,#ffffff,#f3f8ff);
      border-radius: 16px;
      border-top: 3px solid #2384ee;
    }
    #strategy .strategy-step:nth-child(2) { border-top-color:#6c43ed; background:linear-gradient(145deg,#fff,#f7f2ff); }
    #strategy .strategy-step:nth-child(3) { border-top-color:#11b893; background:linear-gradient(145deg,#fff,#effbf7); }
    #strategy .strategy-step:nth-child(4) { border-top-color:#f39a20; background:linear-gradient(145deg,#fff,#fff8ec); }
    #strategy .strategy-principle { background:linear-gradient(145deg,#edf7ff,#f7f3ff); border-radius:18px; }
    #strategy .priority-panel { background:#fff; border-radius:18px; }

    /* ---------- PM Scope ---------- */
    #scope .scope-card {
      background:#fff;
      border-radius:16px;
      border-top:3px solid #2384ee;
      box-shadow:0 12px 28px rgba(41,89,145,.06);
    }
    #scope .scope-card:nth-child(4n+2) { border-top-color:#6d43ed; background:linear-gradient(145deg,#fff,#f8f3ff); }
    #scope .scope-card:nth-child(4n+3) { border-top-color:#11b893; background:linear-gradient(145deg,#fff,#effbf7); }
    #scope .scope-card:nth-child(4n) { border-top-color:#f39a20; background:linear-gradient(145deg,#fff,#fff8ed); }
    #scope .scope-footer { border-color:#c9dcf0; background:rgba(255,255,255,.78); }

    /* ---------- Product Metrics ---------- */
    #metrics .metrics-story {
      background:linear-gradient(145deg,#eef8ff,#f7f2ff);
      border-radius:22px;
    }
    #metrics .metric-group:nth-child(3n+1) { background:#eff8ff; border-color:#bddfff; }
    #metrics .metric-group:nth-child(3n+2) { background:#f5f0ff; border-color:#dacbff; }
    #metrics .metric-group:nth-child(3n) { background:#effbf7; border-color:#bce9dd; }
    #metrics .formula-bar { border-color:#c9dcf0; background:rgba(255,255,255,.8); }

    /* ---------- Portfolio ---------- */
    #portfolio .portfolio-note,
    #outcomes .outcomes-note {
      border-color:#c7dcf3;
      background:linear-gradient(145deg,#eef8ff,#f8f4ff);
      border-radius:16px;
    }

    #portfolio .portfolio-card {
      border-radius:17px;
      box-shadow:0 14px 30px rgba(41,89,145,.065);
    }
    #portfolio .portfolio-card.blue { background:linear-gradient(145deg,#eef8ff,#fff); border-color:#b8dbff; }
    #portfolio .portfolio-card.amber { background:linear-gradient(145deg,#fff8ed,#fff); border-color:#f0d2a8; }
    #portfolio .portfolio-card.mint { background:linear-gradient(145deg,#edfbf7,#fff); border-color:#b8e6d9; }
    #portfolio .portfolio-card.lav { background:linear-gradient(145deg,#f6f1ff,#fff); border-color:#d7c7fb; }
    #portfolio .portfolio-card.teal { background:linear-gradient(145deg,#eefafa,#fff); border-color:#bce4e7; }

    /* ---------- Tech & Data ---------- */
    #tech .capability-table {
      background:rgba(255,255,255,.8);
      border-radius:18px;
      overflow:hidden;
    }
    #tech .capability-row:nth-child(odd) { background:#f2f8ff; }
    #tech .capability-row:nth-child(even) { background:#fbf9ff; }
    #tech .tech-panel {
      background:linear-gradient(145deg,#0d3c70,#1b57a0 55%,#6840cf);
      border-color:#6da8ee;
      border-radius:22px;
      color:#fff;
      box-shadow:0 20px 44px rgba(31,74,140,.18);
    }
    #tech .tech-panel-title { color:#fff; }
    #tech .tech-panel-sub { color:#d4e5f7; }
    #tech .tech-layer { background:rgba(255,255,255,.09); border-color:rgba(255,255,255,.15); }
    #tech .tool { background:rgba(255,255,255,.12); border-color:rgba(255,255,255,.2); color:#fff; }

    /* ---------- Outcomes ---------- */
    #outcomes .outcome-card {
      border-radius:17px;
      box-shadow:0 14px 30px rgba(41,89,145,.06);
    }
    #outcomes .outcome-card:nth-child(4n+1) { background:linear-gradient(145deg,#eef8ff,#fff); border-color:#b8dbff; }
    #outcomes .outcome-card:nth-child(4n+2) { background:linear-gradient(145deg,#f6f0ff,#fff); border-color:#d8c8fb; }
    #outcomes .outcome-card:nth-child(4n+3) { background:linear-gradient(145deg,#effbf7,#fff); border-color:#b9e6da; }
    #outcomes .outcome-card:nth-child(4n) { background:linear-gradient(145deg,#fff8ec,#fff); border-color:#efd2a6; }
    #outcomes .outcome-summary { border-color:#c9dcf0; background:rgba(255,255,255,.82); }
    #outcomes .outcome-summary-item { background:transparent; }

    /* ---------- Connect ---------- */
    #contact {
      background:
        radial-gradient(circle at 90% 15%,rgba(54,136,255,.14),transparent 25%),
        radial-gradient(circle at 15% 85%,rgba(113,61,240,.10),transparent 25%),
        linear-gradient(145deg,#eef7ff,#f7f2ff);
    }
    #contact .contact-title { color:var(--portfolio-ink); }
    #contact .contact-copy { color:var(--portfolio-body); }
    #contact .contact-card {
      background:rgba(255,255,255,.82);
      border:1px solid #bfd8f2;
      border-radius:22px;
      box-shadow:0 18px 40px rgba(41,89,145,.08);
    }
    #contact .contact-link {
      color:var(--portfolio-ink);
      border-color:#c9dcf0;
      background:#fff;
    }
    #contact .contact-link.primary {
      color:#fff;
      border:0;
      background:linear-gradient(100deg,#168ff1,#7140ed);
    }
    #contact .contact-focus .pill {
      background:#fff;
      border-color:#c8dcf1;
      color:#245580;
    }
    #contact .contact-foot { color:#66819e; border-color:#c9dcf0; }
    #contact .senior-signals > div {
      border-color:#c9dcf0 !important;
      background:rgba(255,255,255,.72) !important;
    }
    #contact .senior-signals strong { color:var(--portfolio-ink) !important; }
    #contact .senior-signals p { color:#607c99 !important; }

    /* Prevent text clipping in the light portfolio theme. */
    .section-head p,
    .challenge-lead p,
    .metrics-story p,
    .portfolio-note span,
    .outcomes-note span,
    .capability-row span {
      white-space: normal;
      overflow: visible;
      text-overflow: unset;
    }

    @media (max-width: 1180px) and (min-width: 821px) {
      html:not([data-layout="desktop"]) #overview .overview-grid { grid-template-columns:minmax(0,1fr) minmax(500px,.92fr); gap:18px; }
      html:not([data-layout="desktop"]) #overview .overview-title { font-size:48px; }
      html:not([data-layout="desktop"]) #overview .overview-lead { font-size:14px; }
      html:not([data-layout="desktop"]) #overview .hero-stat { min-height:88px; }
      html:not([data-layout="desktop"]) #overview .expertise-item { min-height:92px; }
      html:not([data-layout="desktop"]) #overview .model-capability { width:270px; min-height:100px; }
      html:not([data-layout="desktop"]) #overview .model-profile { width:220px; min-height:150px; }
    }

    /* =====================================================================
       APPROVED HERO DESIGN SYSTEM — APPLIED TO ALL PORTFOLIO SECTIONS
       ---------------------------------------------------------------------
       This is a visual/layout layer only. Existing content, section order,
       navigation labels, URLs and data arrays remain untouched.
       ===================================================================== */

    :root {
      --hero-navy: #0b315c;
      --hero-navy-2: #123f72;
      --hero-blue: #1d82f2;
      --hero-blue-2: #2d6df5;
      --hero-violet: #7041ef;
      --hero-purple: #9b39ee;
      --hero-cyan: #16a9ef;
      --hero-mint: #10b99a;
      --hero-amber: #f2a21a;
      --hero-orange: #ff6f24;
      --hero-ink: #102f55;
      --hero-body: #496985;
      --hero-muted: #68829b;
      --hero-line: #c9ddf1;
      --hero-bg: #f4f9fe;
      --hero-card: rgba(255,255,255,.92);
    }

    /* ---------- Shared page canvas ---------- */
    body {
      background:
        radial-gradient(circle at 8% 8%, rgba(29,130,242,.07), transparent 24%),
        radial-gradient(circle at 92% 16%, rgba(112,65,239,.065), transparent 26%),
        #f4f9fe;
      color: var(--hero-body);
    }

    main {
      background:
        radial-gradient(circle at 18% 18%, rgba(29,130,242,.045), transparent 22%),
        radial-gradient(circle at 84% 74%, rgba(155,57,238,.045), transparent 24%);
    }

    /* ---------- Header: same visual language as approved Overview ---------- */
    header {
      background: linear-gradient(110deg, #0a315c 0%, #0d3767 52%, #102e59 100%);
      border-bottom: 1px solid rgba(133,193,255,.20);
      box-shadow: 0 12px 30px rgba(7,37,72,.22);
    }

    #nav a {
      color: #f4f8ff;
      border: 1px solid transparent;
    }

    #nav a:hover,
    #nav a.active {
      color: #fff;
      background: linear-gradient(135deg, rgba(27,136,240,.88), rgba(73,93,239,.88));
      box-shadow: 0 7px 18px rgba(21,109,211,.20);
    }

    .btn.primary {
      min-height: 50px;
      min-width: 236px;
      padding: 0 24px;
      border: 0;
      border-radius: 17px;
      background: linear-gradient(100deg, #20a9ec 0%, #397cf3 48%, #762fe5 100%);
      box-shadow: 0 10px 24px rgba(45,104,231,.24);
    }

    .btn.primary:hover {
      background: linear-gradient(100deg, #20a9ec 0%, #397cf3 48%, #762fe5 100%);
      box-shadow: 0 13px 28px rgba(45,104,231,.32);
      transform: translateY(-1px);
    }

    /* ---------- All section backgrounds use the Overview palette ---------- */
    .slide,
    .slide.white,
    .slide.soft,
    .slide.dark {
      background:
        radial-gradient(circle at 88% 12%, rgba(112,65,239,.055), transparent 24%),
        radial-gradient(circle at 10% 82%, rgba(22,169,239,.055), transparent 25%),
        linear-gradient(145deg, #f7fbff 0%, #eef6fd 56%, #f8f4ff 100%);
      color: var(--hero-body);
    }

    .slide::before {
      content: "";
      position: absolute;
      inset: auto -5% -8% -5%;
      height: 90px;
      background: linear-gradient(90deg, rgba(42,126,238,.07), rgba(112,65,239,.09), rgba(255,160,31,.06));
      border-radius: 50% 50% 0 0;
      pointer-events: none;
      z-index: 0;
    }

    .slide.dark .wrap,
    .slide.soft .wrap,
    .slide.white .wrap { position: relative; }

    /* ---------- Shared headings / labels ---------- */
    .eyebrow,
    .hero-kicker {
      color: #2d5e91;
    }

    .eyebrow::before,
    .hero-kicker::before {
      background: linear-gradient(90deg, var(--hero-blue), var(--hero-violet));
    }

    .section-head h2,
    .section-head h2,
    .challenge-lead h3,
    .ecosystem-story h3,
    .metrics-story h3,
    .contact-title {
      color: var(--hero-ink) !important;
    }

    .section-head p,
    .challenge-lead p,
    .ecosystem-story p,
    .metrics-story p,
    .contact-copy,
    .portfolio-note span,
    .outcomes-note span {
      color: var(--hero-body) !important;
    }

    /* ---------- Universal card language ---------- */
    .card,
    .challenge-lead,
    .challenge-card,
    .strategy-step,
    .strategy-principle,
    .priority-panel,
    .scope-card,
    .metrics-story,
    .metric-group,
    .portfolio-note,
    .portfolio-card,
    .capability-table,
    .tech-panel,
    .outcomes-note,
    .outcome-card,
    .contact-card,
    .ecosystem-story,
    .ecosystem-panel {
      border: 1px solid var(--hero-line);
      box-shadow: 0 16px 38px rgba(32,86,139,.075);
    }

    /* ---------- Ecosystem ---------- */
    #ecosystem .ecosystem-grid-layout {
      grid-template-columns: minmax(0,.78fr) minmax(0,1.22fr);
      gap: 24px;
    }

    #ecosystem .ecosystem-story {
      background: linear-gradient(145deg, #0b3565 0%, #15508b 58%, #6a42d1 100%);
      border-color: rgba(105,176,247,.42);
      color: #fff;
    }

    #ecosystem .ecosystem-story h3,
    #ecosystem .ecosystem-story p,
    #ecosystem .ecosystem-story .story-point,
    #ecosystem .ecosystem-story-foot { color: #fff !important; }

    #ecosystem .ecosystem-story p { color: #dcecff !important; }
    #ecosystem .ecosystem-story-foot { color: #b9d1ea !important; border-color: rgba(255,255,255,.18); }

    #ecosystem .story-point i { background: linear-gradient(135deg,#2ca9ff,#8d49ef); }

    #ecosystem .ecosystem-panel {
      background: rgba(255,255,255,.78);
      border-radius: 24px;
      backdrop-filter: blur(10px);
    }

    #ecosystem .eco-card {
      min-height: 105px;
      border-radius: 16px;
      box-shadow: 0 10px 24px rgba(32,86,139,.055);
    }

    #ecosystem .eco-card:nth-child(3n+1) { background: linear-gradient(145deg,#e9f7ff,#f9fcff); border-color:#a9d7ff; }
    #ecosystem .eco-card:nth-child(3n+2) { background: linear-gradient(145deg,#f7efff,#fffaff); border-color:#d4b8ff; }
    #ecosystem .eco-card:nth-child(3n) { background: linear-gradient(145deg,#eafff8,#fafffd); border-color:#aee8d9; }
    #ecosystem .eco-card strong { color: var(--hero-ink); }
    #ecosystem .eco-card span { color: var(--hero-body); }

    /* ---------- Challenge ---------- */
    #challenge .challenge-lead {
      background: linear-gradient(145deg,#0d396b,#205f99 58%,#7042d0);
      border-color: rgba(91,171,244,.45);
      color: #fff;
    }

    #challenge .challenge-lead h3 { color:#fff !important; }
    #challenge .challenge-lead p { color:#dcecff !important; }
    #challenge .challenge-lead .mini-label { color:#c4dcf2 !important; }

    #challenge .challenge-card {
      border-radius: 17px;
      background: rgba(255,255,255,.92);
      color: var(--hero-body);
    }

    #challenge .challenge-card:nth-child(3n+1) { background:linear-gradient(145deg,#edf8ff,#fff); border-top:3px solid #2589f3; }
    #challenge .challenge-card:nth-child(3n+2) { background:linear-gradient(145deg,#f7f0ff,#fff); border-top:3px solid #7542ef; }
    #challenge .challenge-card:nth-child(3n) { background:linear-gradient(145deg,#fff7eb,#fff); border-top:3px solid #f39b20; }
    #challenge .challenge-card h3 { color:var(--hero-ink); }
    #challenge .challenge-card p { color:var(--hero-body); }
    #challenge .challenge-card .response { color:#52708e; border-color:#d8e6f2; }

    /* ---------- Strategy ---------- */
    #strategy .strategy-flow { grid-template-columns: repeat(4,minmax(0,1fr)); gap: 11px; }
    #strategy .strategy-step {
      height: 155px;
      border-radius: 17px;
      background: linear-gradient(145deg,#fff,#edf7ff);
      border-top: 4px solid #2589f3;
    }
    #strategy .strategy-step:nth-child(2) { border-top-color:#7042ef; background:linear-gradient(145deg,#fff,#f7f0ff); }
    #strategy .strategy-step:nth-child(3) { border-top-color:#10b99a; background:linear-gradient(145deg,#fff,#ecfbf7); }
    #strategy .strategy-step:nth-child(4) { border-top-color:#f39b20; background:linear-gradient(145deg,#fff,#fff7eb); }
    #strategy .strategy-step:nth-child(5) { border-top-color:#2389f3; background:linear-gradient(145deg,#fff,#edf7ff); }
    #strategy .strategy-step:nth-child(6) { border-top-color:#8c3de8; background:linear-gradient(145deg,#fff,#f8efff); }
    #strategy .strategy-step:nth-child(7) { border-top-color:#0fb99a; background:linear-gradient(145deg,#fff,#effbf8); }
    #strategy .strategy-step:nth-child(8) { border-top-color:#f47d25; background:linear-gradient(145deg,#fff,#fff8ef); }
    #strategy .strategy-step strong { color:var(--hero-ink); }
    #strategy .strategy-step p { color:var(--hero-body); }
    #strategy .strategy-principle {
      background: linear-gradient(135deg,#0b3565,#17528d 55%,#6b40d4);
      border-color: rgba(91,171,244,.45);
    }
    #strategy .strategy-principle strong { color:#fff; }
    #strategy .strategy-principle span { color:#dcecff; }
    #strategy .priority-panel { background:linear-gradient(145deg,#eef8ff,#f8f1ff); }
    #strategy .priority-item strong { color:var(--hero-ink); }
    #strategy .priority-item span { color:var(--hero-body); }

    /* ---------- PM Scope ---------- */
    #scope .scope-grid { grid-template-columns: repeat(4,minmax(0,1fr)); gap:11px; }
    #scope .scope-card {
      height: 176px;
      border-radius: 17px;
      background: linear-gradient(145deg,#fff,#edf7ff);
      border-top: 4px solid #2389f3;
    }
    #scope .scope-card:nth-child(4n+2) { border-top-color:#7042ef; background:linear-gradient(145deg,#fff,#f7f0ff); }
    #scope .scope-card:nth-child(4n+3) { border-top-color:#10b99a; background:linear-gradient(145deg,#fff,#ecfbf7); }
    #scope .scope-card:nth-child(4n) { border-top-color:#f39b20; background:linear-gradient(145deg,#fff,#fff7eb); }
    #scope .scope-card strong { color:var(--hero-ink); }
    #scope .scope-card p { color:var(--hero-body); }
    #scope .scope-tag { color:#28577f; background:rgba(255,255,255,.84); border-color:#cfe0ef; }
    #scope .scope-footer { background:linear-gradient(90deg,#edf8ff,#f6f0ff); border-color:#c4dbef; }
    #scope .scope-footer strong { color:var(--hero-ink); }
    #scope .scope-footer span { color:var(--hero-body); }

    /* ---------- Product Metrics ---------- */
    #metrics .metrics-story {
      background: linear-gradient(145deg,#eaf7ff 0%,#f5efff 100%);
      border-radius:22px;
    }
    #metrics .metrics-story h3 { color:var(--hero-ink) !important; }
    #metrics .metrics-story p { color:var(--hero-body) !important; }
    #metrics .metric-group {
      border-radius:16px;
      box-shadow:0 10px 24px rgba(32,86,139,.055);
    }
    #metrics .metric-group:nth-child(3n+1) { background:linear-gradient(145deg,#eaf7ff,#fff); border-color:#acd9ff; }
    #metrics .metric-group:nth-child(3n+2) { background:linear-gradient(145deg,#f6efff,#fff); border-color:#d5bfff; }
    #metrics .metric-group:nth-child(3n) { background:linear-gradient(145deg,#eafbf7,#fff); border-color:#afe8d9; }
    #metrics .metric-group h3 { color:var(--hero-ink); }
    #metrics .metric-group > p,
    #metrics .metric-list div { color:var(--hero-body); }
    #metrics .formula-bar { background:rgba(255,255,255,.86); border-color:#c6dcef; }
    #metrics .formula strong { color:var(--hero-ink); }
    #metrics .formula span { color:var(--hero-body); }

    /* ---------- Portfolio ---------- */
    #portfolio .portfolio-note,
    #outcomes .outcomes-note {
      background:linear-gradient(145deg,#eaf7ff,#f6f0ff);
      border-color:#bdd8f0;
    }
    #portfolio .portfolio-note strong,
    #outcomes .outcomes-note strong { color:var(--hero-ink); }
    #portfolio .portfolio-note span,
    #outcomes .outcomes-note span { color:var(--hero-body) !important; }

    #portfolio .portfolio-card {
      border-radius:17px;
      box-shadow:0 14px 30px rgba(32,86,139,.065);
    }
    #portfolio .portfolio-card.blue { background:linear-gradient(145deg,#eaf7ff,#fff); border-color:#a9d7ff; }
    #portfolio .portfolio-card.amber { background:linear-gradient(145deg,#fff7e9,#fff); border-color:#f1d19e; }
    #portfolio .portfolio-card.mint { background:linear-gradient(145deg,#eafbf7,#fff); border-color:#aee7d8; }
    #portfolio .portfolio-card.lav { background:linear-gradient(145deg,#f5efff,#fff); border-color:#d2bdf5; }
    #portfolio .portfolio-card.teal { background:linear-gradient(145deg,#eaf9fb,#fff); border-color:#addfe5; }
    #portfolio .portfolio-card h3 { color:var(--hero-ink); }
    #portfolio .portfolio-company,
    #portfolio .portfolio-block label { color:#54708c; }
    #portfolio .portfolio-block p,
    #portfolio .portfolio-outcome p { color:var(--hero-body); }
    #portfolio .portfolio-outcome { background:rgba(255,255,255,.76); border-color:rgba(28,75,119,.10); }
    #portfolio .portfolio-tag { color:#315d80; background:rgba(255,255,255,.84); border-color:#d2e1ee; }
    #portfolio .case-link { color:#1f5f99; }

    /* ---------- Tech & Data ---------- */
    #tech .capability-table {
      background:rgba(255,255,255,.88);
      border-radius:18px;
      border-color:#bdd8ef;
      overflow:hidden;
    }
    #tech .capability-row:nth-child(odd) { background:linear-gradient(90deg,#edf8ff,#f9fcff); }
    #tech .capability-row:nth-child(even) { background:linear-gradient(90deg,#faf7ff,#fff); }
    #tech .capability-row strong { color:var(--hero-ink); }
    #tech .capability-row span { color:var(--hero-body); }
    #tech .tech-panel {
      background:linear-gradient(145deg,#0a3565 0%,#14538d 54%,#6c40d5 100%);
      border-color:#75b5ef;
      border-radius:22px;
      box-shadow:0 20px 44px rgba(31,74,140,.18);
    }
    #tech .tech-panel-title { color:#fff; }
    #tech .tech-panel-sub { color:#dcecff; }
    #tech .tech-layer { background:rgba(255,255,255,.095); border-color:rgba(255,255,255,.18); }
    #tech .tool { background:rgba(255,255,255,.12); border-color:rgba(255,255,255,.22); color:#fff; }

    /* ---------- Outcomes ---------- */
    #outcomes .outcome-card {
      border-radius:17px;
      box-shadow:0 14px 30px rgba(32,86,139,.06);
    }
    #outcomes .outcome-card:nth-child(4n+1) { background:linear-gradient(145deg,#eaf7ff,#fff); border-color:#a9d7ff; }
    #outcomes .outcome-card:nth-child(4n+2) { background:linear-gradient(145deg,#f5efff,#fff); border-color:#d2bdf5; }
    #outcomes .outcome-card:nth-child(4n+3) { background:linear-gradient(145deg,#eafbf7,#fff); border-color:#afe7d9; }
    #outcomes .outcome-card:nth-child(4n) { background:linear-gradient(145deg,#fff7ea,#fff); border-color:#efd09e; }
    #outcomes .outcome-card strong,
    #outcomes .outcome-card h3 { color:var(--hero-ink); }
    #outcomes .outcome-card span { color:#55718c; }
    #outcomes .outcome-summary { border-color:#c5dcef; background:rgba(255,255,255,.84); }
    #outcomes .outcome-summary-item strong { color:var(--hero-ink); }
    #outcomes .outcome-summary-item span { color:var(--hero-body); }

    /* ---------- Connect ---------- */
    #contact {
      background:
        radial-gradient(circle at 88% 12%,rgba(39,133,242,.12),transparent 25%),
        radial-gradient(circle at 12% 82%,rgba(112,65,239,.10),transparent 25%),
        linear-gradient(145deg,#edf8ff,#f7f1ff);
    }
    #contact .contact-title { color:var(--hero-ink) !important; }
    #contact .contact-copy { color:var(--hero-body) !important; }
    #contact .contact-card {
      background:rgba(255,255,255,.86);
      border-color:#bdd8ef;
      border-radius:22px;
    }
    #contact .contact-link { color:var(--hero-ink); background:#fff; border-color:#c7dced; }
    #contact .contact-link.primary { color:#fff; border:0; background:linear-gradient(100deg,#1ba8ed,#3b79f1 52%,#7138e6); }
    #contact .contact-focus .pill { color:#315d80; background:#fff; border-color:#c7dced; }
    #contact .senior-signals > div { background:rgba(255,255,255,.72) !important; border-color:#c8dced !important; }
    #contact .senior-signals strong { color:var(--hero-ink) !important; }
    #contact .senior-signals p { color:var(--hero-body) !important; }
    #contact .contact-foot { color:#5e7b98; border-color:#c7dced; }

    /* =====================================================================
       DESKTOP 100% VIEWPORT FIT
       The portfolio is designed as one viewport per section on desktop.
       No content is deleted; dimensions are compacted so the existing text
       remains readable without clipping or nested scrollbars.
       ===================================================================== */
      html[data-layout="desktop"] { --header-h: 112px; }

      html[data-layout="desktop"] .slide {
        height: calc(var(--app-vh, 100dvh)) - var(--header-h));
        min-height: 0;
        padding: 18px 0 16px;
      }

      html[data-layout="desktop"] .wrap { max-width: 1920px; padding-left: 34px; padding-right: 34px; }

      /* Overview */
      html[data-layout="desktop"] #overview .overview-grid {
        grid-template-columns: minmax(0,1.00fr) minmax(590px,.96fr);
        gap: 28px;
        height: calc(var(--app-vh, 100dvh)) - var(--header-h) - 34px);
        align-items: center;
      }

      html[data-layout="desktop"] #overview .overview-copy { min-width:0; }
      html[data-layout="desktop"] #overview .overview-title {
        max-width: 760px;
        margin: 11px 0 13px;
        font-size: clamp(49px,calc(3.65 * var(--app-vw1, 1vw)),60px);
        line-height: .965;
      }
      html[data-layout="desktop"] #overview .overview-lead { max-width: 735px; font-size: 14.5px; line-height:1.48; }
      html[data-layout="desktop"] #overview .hero-stats { gap:8px; margin-top:16px; }
      html[data-layout="desktop"] #overview .hero-stat { min-height:82px; padding:12px 13px; border-radius:16px; }
      html[data-layout="desktop"] #overview .hero-stat strong { font-size:23px; }
      html[data-layout="desktop"] #overview .hero-stat span { font-size:8.5px; }
      html[data-layout="desktop"] #overview .core-expertise { margin-top:10px; padding-top:10px; }
      html[data-layout="desktop"] #overview .core-expertise-title { margin-bottom:8px; font-size:9px; }
      html[data-layout="desktop"] #overview .expertise-grid { gap:8px; }
      html[data-layout="desktop"] #overview .expertise-item { min-height:91px; padding:10px; border-radius:14px; }
      html[data-layout="desktop"] #overview .expertise-item strong { font-size:9.5px; }
      html[data-layout="desktop"] #overview .expertise-item span { font-size:8.4px; line-height:1.28; }

      html[data-layout="desktop"] #overview .overview-visual {
        min-height:0;
        height: calc(var(--app-vh, 100dvh)) - var(--header-h) - 72px);
        max-height: 704px;
