      html:not([data-layout="desktop"]) #overview .expertise-item { min-height:78px; }
      html:not([data-layout="desktop"]) #overview .overview-visual { max-height:690px; }
      html:not([data-layout="desktop"]) #overview .model-capability { min-height:92px; height:92px; padding:14px; }
