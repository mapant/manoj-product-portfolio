    .metric-group h3 { font-size: 15px; }
    .metric-group > p { font-size: 10.5px; line-height: 1.35; }
    .metric-list div { font-size: 10px; }
    .formula strong { font-size: 9px; }
    .formula span { font-size: 8.5px; line-height: 1.28; }

    .ref-metric-card.users { background:#f5faff; border-color:#acd9ff; }
    .ref-metric-card.rocket { background:#fbf7ff; border-color:#d5bfff; }
    .ref-metric-card.gear { background:#f1fbf8; border-color:#afe8d9; }
    .ref-metric-card.shield { background:#fffaf0; border-color:#f4e7ce; }
    .ref-metric-card.ai { background:#fff6fb; border-color:#f3ddea; }
    .ref-metric-card.chart { background:#f0fbf7; border-color:#d9efe9; }
    .ref-metric-card.rocket .ref-metric-icon { background:#6f27e4; }
    .ref-metric-card.gear .ref-metric-icon { background:#11bd93; }
    .ref-metric-card.shield .ref-metric-icon { background:#f39a10; }
    .ref-metric-card.ai .ref-metric-icon { background:#eb2a8d; }
    .ref-metric-card.chart .ref-metric-icon { background:#16b996; }
    .ref-metric-card.rocket .ref-metric-list li::before { background:#6e2de2; }
    .ref-metric-card.gear .ref-metric-list li::before { background:#0bb28b; }
    .ref-metric-card.shield .ref-metric-list li::before { background:#f1950c; }
    .ref-metric-card.ai .ref-metric-list li::before { background:#e62c8c; }
    .ref-metric-card.chart .ref-metric-list li::before { background:#0cb68c; }
    .ref-metric-card.rocket .ref-donut { background:conic-gradient(#6d2de2 0 62%,#e7ddf7 62%); }
    .ref-metric-card.gear .ref-donut { background:conic-gradient(#10bd93 0 45%,#dcefe9 45%); }
    .ref-metric-card.shield .ref-donut { background:conic-gradient(#f19a11 0 90%,#f4e7ce 90%); }
    .ref-metric-card.ai .ref-donut { background:conic-gradient(#e52a8d 0 68%,#f3ddea 68%); }
    .ref-metric-card.chart .ref-donut { background:conic-gradient(#16b995 0 32%,#d9efe9 32%); }
    .ref-metric-card.rocket .ref-donut::after { background:#fbf7ff; }
    .ref-metric-card.gear .ref-donut::after { background:#f1fbf8; }
    .ref-metric-card.shield .ref-donut::after { background:#fffaf0; }
    .ref-metric-card.ai .ref-donut::after { background:#fff6fb; }
    .ref-metric-card.chart .ref-donut::after { background:#f0fbf7; }

    /* PORTFOLIO */
    .portfolio-card h3 { font-size: 16px; line-height: 1.08; }
    .portfolio-block label { font-size: 8px; }
    .portfolio-block p { font-size: 10px; line-height: 1.42; }
    .portfolio-outcome { padding: 10px 11px; }
    .portfolio-outcome p { font-size: 10px; }
    .portfolio-tag { font-size: 8px; }
    .case-link { font-size: 9.5px; }
    .supporting-item strong { font-size: 8.5px; }
    .supporting-item span { font-size: 8px; line-height: 1.3; }

    /* TECH & DATA */
    .capability-row strong { font-size: 11px; }
    .capability-row span { font-size: 10px; line-height: 1.32; white-space: normal; }
    .tech-panel-title { font-size: 24px; line-height: 1.06; }
    .tech-panel-sub { font-size: 10.5px; }
