    /* DESKTOP HEIGHT SAFETY */
    @media (max-height: 850px) and (min-width: 900px) {
      html:not([data-layout="desktop"]) .ecosystem-story h3 { font-size: 30px; }
      html:not([data-layout="desktop"]) .eco-card { min-height: 96px; padding: 15px; }
      html:not([data-layout="desktop"]) .eco-card span { font-size: 10px; }
      html:not([data-layout="desktop"]) .strategy-step { height: 135px; padding: 14px; }
      html:not([data-layout="desktop"]) .strategy-step p { font-size: 9.5px; }
      html:not([data-layout="desktop"]) .scope-card { height: 190px; }
      html:not([data-layout="desktop"]) .metric-group { min-height: 145px; }
