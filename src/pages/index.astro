      color: var(--amber);
      font-weight: 950;
    }

    .focus-row .pill:last-child::after { display: none; }

    .overview-stats {
      display: grid;
      grid-template-columns: repeat(4,minmax(0,1fr));
      gap: 9px;
      margin-top: 14px;
    }

    .overview-stat {
      min-height: 78px;
      padding: 13px 14px 12px;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: rgba(255,255,255,.92);
      box-shadow: var(--shadow-xs);
    }

    .overview-stat strong {
      display: block;
      color: var(--text-strong);
      font-size: 24px;
      line-height: 1;
      font-weight: 950;
      letter-spacing: -.04em;
    }

    .overview-stat span {
      display: block;
      margin-top: 7px;
      color: var(--text-soft);
      font-size: 9px;
      line-height: 1.15;
      font-weight: 850;
      letter-spacing: .045em;
      text-transform: uppercase;
    }

    .career-strip {
      margin-top: 11px;
      display: grid;
      grid-template-columns: repeat(4,1fr);
      border: 1px solid var(--line);
      border-radius: 14px;
      overflow: hidden;
      background: rgba(255,255,255,.9);
    }

    .career-step {
      min-width: 0;
      min-height: 72px;
      padding: 11px 12px;
      border-right: 1px solid var(--line);
    }

    .career-step:last-child { border-right: 0; }
    .career-step .number { font-size: 8px; }

    .career-step strong {
      display: block;
      margin-top: 5px;
      color: var(--text-strong);
      font-size: 11.5px;
      line-height: 1;
      font-weight: 900;
      white-space: nowrap;
    }

    .career-step span {
      display: block;
      margin-top: 5px;
      color: var(--text-soft);
      font-size: 8.7px;
      line-height: 1.25;
    }

    .overview-visual {
      min-height: 555px;
      padding: 23px;
      border: 1px solid #cfdeea;
      border-radius: 24px;
      background: linear-gradient(145deg,#ffffff 0%,#f5f9fc 100%);
      box-shadow: 0 18px 42px rgba(16,47,85,.075);
      display: flex;
      flex-direction: column;
      gap: 17px;
    }

    .overview-visual::after {
      display: none;
    }

    #overview .visual-top {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      color: var(--text-soft);
      font-size: 9px;
      line-height: 1;
      font-weight: 900;
      letter-spacing: .1em;
      text-transform: uppercase;
    }

    #overview .visual-top span:last-child {
      color: var(--amber);
      text-align: right;
    }

    #overview .model-stage {
      position: relative;
      flex: 1;
      min-height: 310px;
      display: grid;
      grid-template-columns: minmax(0,1fr) 190px;
      gap: 12px;
      align-items: center;
    }

    #overview .model-profile {
      min-height: 230px;
      padding: 20px 16px;
      border-radius: 18px;
      background: linear-gradient(145deg,#102f55,#1c4c7b);
      color: #fff;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      box-shadow: 0 18px 36px rgba(16,47,85,.17);
    }

    #overview .model-profile img {
      width: 86px;
      height: 86px;
      margin-bottom: 12px;
      border: 3px solid rgba(255,255,255,.78);
      border-radius: 50%;
      object-fit: cover;
      object-position: center 18%;
    }

    #overview .model-profile strong {
      font-size: 17px;
      line-height: 1.15;
      font-weight: 900;
    }

    #overview .model-profile span {
      margin-top: 5px;
      color: #c7d9e9;
      font-size: 10px;
      line-height: 1.25;
    }

    #overview .model-capabilities {
      display: grid;
      gap: 10px;
    }

    #overview .model-capability {
      min-height: 70px;
      padding: 13px 12px;
      border: 1px solid var(--line);
      border-radius: 13px;
      background: #fff;
      box-shadow: var(--shadow-xs);
    }

    #overview .model-capability strong {
      display: block;
      color: var(--text-strong);
      font-size: 11px;
      line-height: 1.2;
      font-weight: 900;
    }

    #overview .model-capability span {
      display: block;
      margin-top: 6px;
      color: var(--text-soft);
      font-size: 9px;
      line-height: 1.35;
    }

    #overview .model-capability:nth-child(1) { border-color: #d9e6f2; background: #f7fbff; }
    #overview .model-capability:nth-child(2) { border-color: #eadfc8; background: #fffaf1; }
    #overview .model-capability:nth-child(3) { border-color: #d1e7e5; background: #f2fbf9; }
    #overview .model-capability:nth-child(4) { border-color: #ded5f5; background: #f8f5ff; }

    #overview .expertise {
      padding-top: 13px;
      border-top: 1px solid var(--line-strong);
    }

    #overview .expertise-title {
      margin-bottom: 10px;
      color: var(--text-soft);
      font-size: 9px;
      line-height: 1;
      font-weight: 900;
      letter-spacing: .12em;
      text-transform: uppercase;
    }

    #overview .expertise-grid {
      display: grid;
      grid-template-columns: repeat(3,minmax(0,1fr));
      gap: 8px;
    }

    #overview .expertise-item {
      min-width: 0;
      min-height: 70px;
      padding: 10px;
      border-radius: 11px;
      background: #edf5ff;
    }

    #overview .expertise-item:nth-child(2) { background: #fff6e8; }
    #overview .expertise-item:nth-child(3) { background: #edf9f5; }

    #overview .expertise-item strong {
      display: block;
      color: var(--text-strong);
      font-size: 9px;
      line-height: 1.2;
      font-weight: 900;
      text-transform: uppercase;
    }

    #overview .expertise-item span {
      display: block;
      margin-top: 5px;
      color: var(--text-body);
      font-size: 8.5px;
      line-height: 1.3;
    }

    /* ======================================================================
       ECOSYSTEM SLIDE
       ====================================================================== */

    .ecosystem-grid-layout {
      display: grid;
      grid-template-columns: minmax(290px,.72fr) minmax(0,1.28fr);
      gap: 34px;
      align-items: center;
    }

    .ecosystem-story {
      padding: 28px;
      border-radius: 25px;
      background: var(--navy-900);
      color: #fff;
      min-height: 525px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      box-shadow: var(--shadow-md);
    }

    .ecosystem-story h3 {
      margin: 16px 0 12px;
      color: #fff;
      font-size: 31px;
      line-height: 1.02;
      font-weight: 950;
      letter-spacing: -.045em;
    }

    .ecosystem-story p {
      margin: 0;
      color: #b9cbe0;
      font-size: 13px;
      line-height: 1.5;
    }

    .story-points {
      display: grid;
      gap: 9px;
      margin-top: 20px;
    }

    .story-point {
      display: flex;
      align-items: center;
      gap: 10px;
      color: #edf3f8;
      font-size: 10.5px;
      font-weight: 750;
      white-space: nowrap;
    }

    .story-point i {
      width: 7px;
      height: 7px;
      flex: 0 0 7px;
      border-radius: 50%;
      background: var(--amber-bright);
    }

    .ecosystem-story-foot {
      padding-top: 15px;
      border-top: 1px solid rgba(255,255,255,.1);
      color: #7f9ab5;
      font-size: 8.5px;
      line-height: 1.3;
      font-weight: 900;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .ecosystem-panel {
      padding: 14px;
      border: 1px solid var(--line);
      border-radius: 25px;
      background: #fff;
      box-shadow: var(--shadow-xs);
    }

    .ecosystem-grid {
      display: grid;
      grid-template-columns: repeat(3,minmax(0,1fr));
      gap: 10px;
    }

    .eco-card {
      min-height: 112px;
      padding: 17px;
      border: 1px solid var(--line);
      border-radius: 15px;
      background: #fff;
      position: relative;
      overflow: hidden;
    }

    .eco-card::after {
      content: "";
      position: absolute;
      width: 52px;
      height: 52px;
      right: -18px;
      bottom: -18px;
      border-radius: 50%;
      background: var(--blue-soft);
    }

    .eco-card strong {
      display: block;
      color: var(--navy-900);
      font-size: 13px;
      line-height: 1;
      font-weight: 900;
      white-space: nowrap;
      position: relative;
      z-index: 2;
    }

    .eco-card span {
      display: block;
      max-width: 190px;
      margin-top: 8px;
      color: var(--body);
      font-size: 9.5px;
      line-height: 1.35;
      position: relative;
      z-index: 2;
    }

    .eco-card.ai { background: var(--lav-soft); border-color: #e1d9ff; }
    .eco-card.automation { background: var(--amber-soft); border-color: #f2dfc3; }
    .eco-card.data { background: var(--teal-soft); border-color: #cce9ec; }
    .eco-card.product { background: var(--blue-soft); border-color: #d4e5fa; }

    /* ======================================================================
       CHALLENGE SLIDE
       ====================================================================== */

    .challenge-layout {
      display: grid;
      grid-template-columns: minmax(300px,.74fr) minmax(0,1.26fr);
      gap: 27px;
      align-items: stretch;
    }

    .challenge-lead {
      min-height: 530px;
      padding: 29px;
      border-radius: 25px;
      background: var(--navy-900);
      color: #fff;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      box-shadow: var(--shadow-md);
    }

    .challenge-lead h3 {
      margin: 18px 0 13px;
      color: #fff;
      font-size: 33px;
      line-height: 1.02;
      font-weight: 950;
      letter-spacing: -.045em;
    }

    .challenge-lead p {
      margin: 0;
      color: #b8cbe0;
      font-size: 13px;
      line-height: 1.5;
    }

    .challenge-lead .mini-label {
      color: #8da8c3;
    }

    .challenge-cards {
      display: grid;
      grid-template-columns: repeat(2,minmax(0,1fr));
      gap: 11px;
    }

    .challenge-card {
      min-width: 0;
      min-height: 169px;
      padding: 18px 19px;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: #fff;
      box-shadow: var(--shadow-xs);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .challenge-card-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .challenge-card h3 {
      margin: 10px 0 7px;
      color: var(--navy-900);
      font-size: 14px;
      line-height: 1.05;
      font-weight: 900;
      white-space: nowrap;
    }

    .challenge-card p {
      margin: 0;
      color: var(--body);
      font-size: 10.5px;
      line-height: 1.4;
    }

    .challenge-card .response {
      margin-top: 11px;
      padding-top: 9px;
      border-top: 1px solid var(--line-soft);
      color: var(--muted);
      font-size: 8.5px;
      font-weight: 850;
      letter-spacing: .04em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    /* ======================================================================
       STRATEGY SLIDE
       ====================================================================== */

    .strategy-flow {
      display: grid;
      grid-template-columns: repeat(8,minmax(0,1fr));
      gap: 7px;
    }

    .strategy-step {
      min-width: 0;
      height: 205px;
      padding: 16px 13px;
      border: 1px solid var(--line);
      border-radius: 15px;
      background: #fff;
      position: relative;
      box-shadow: var(--shadow-xs);
    }

    .strategy-step:not(:last-child)::after {
      content: "→";
      position: absolute;
      right: -11px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--amber);
      font-size: 14px;
      font-weight: 900;
      z-index: 3;
    }

    .strategy-step strong {
      display: block;
      margin-top: 12px;
      color: var(--navy-900);
      font-size: 13px;
      line-height: 1;
      font-weight: 900;
      white-space: nowrap;
    }

    .strategy-step p {
      margin: 9px 0 0;
      color: var(--body);
      font-size: 9.5px;
      line-height: 1.4;
    }

    .strategy-bottom {
      margin-top: 15px;
      display: grid;
      grid-template-columns: .55fr 1.45fr;
      gap: 14px;
      align-items: stretch;
    }

    .strategy-principle {
      padding: 17px 18px;
      border-radius: 16px;
      background: var(--navy-900);
      color: #fff;
    }

    .strategy-principle strong {
      display: block;
      font-size: 13px;
      line-height: 1.1;
    }

    .strategy-principle span {
      display: block;
      margin-top: 7px;
      color: #b8cbe0;
      font-size: 9.5px;
      line-height: 1.35;
    }

    .priority-panel {
      padding: 14px 16px;
      border: 1px solid #d5e4f2;
      border-radius: 16px;
      background: var(--blue-soft);
    }

    .priority-grid {
      display: grid;
      grid-template-columns: repeat(3,1fr);
      gap: 7px 14px;
      margin-top: 8px;
    }

    .priority-item {
      min-width: 0;
      display: grid;
      grid-template-columns: 7px minmax(0,1fr);
      gap: 8px;
      align-items: start;
    }

    .priority-item i {
      width: 7px;
      height: 7px;
      margin-top: 4px;
      border-radius: 50%;
      background: var(--amber);
    }

    .priority-item strong {
      display: block;
      color: var(--navy-900);
      font-size: 9px;
      line-height: 1.1;
      white-space: nowrap;
    }

    .priority-item span {
      display: block;
      margin-top: 3px;
      color: var(--body);
      font-size: 8px;
      line-height: 1.25;
    }

    /* ======================================================================
       PM SCOPE SLIDE
       ====================================================================== */

    .scope-grid {
      display: grid;
      grid-template-columns: repeat(4,minmax(0,1fr));
      gap: 10px;
    }

    .scope-card {
      min-width: 0;
      height: 210px;
      padding: 17px 18px;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: #fff;
      position: relative;
      overflow: hidden;
      box-shadow: var(--shadow-xs);
    }

    .scope-card::after {
      content: "";
      position: absolute;
      width: 84px;
      height: 84px;
      right: -28px;
      bottom: -28px;
      border-radius: 50%;
      background: var(--blue-soft);
    }

    .scope-card.ai-scope::after { background: var(--lav-soft); }
    .scope-card.auto-scope::after { background: var(--amber-soft); }

    .scope-card strong {
      display: block;
      margin: 12px 0 8px;
      color: var(--navy-900);
      font-size: 15px;
      line-height: 1;
      font-weight: 900;
      white-space: nowrap;
      position: relative;
      z-index: 2;
    }

    .scope-card p {
      margin: 0;
      color: var(--body);
      font-size: 9.5px;
      line-height: 1.4;
      position: relative;
      z-index: 2;
    }

    .scope-tags {
      position: absolute;
      left: 18px;
      right: 18px;
      bottom: 15px;
      display: flex;
      gap: 5px;
      overflow: hidden;
      z-index: 3;
    }

    .scope-tag {
      min-height: 23px;
      padding: 0 8px;
      display: inline-flex;
      align-items: center;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: #fff;
      color: var(--ink-soft);
      font-size: 7.5px;
      line-height: 1;
      font-weight: 850;
      white-space: nowrap;
    }

    .scope-footer {
      margin-top: 13px;
      padding: 12px 15px;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: #fff;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
    }

    .scope-footer strong {
      color: var(--navy-900);
      font-size: 10px;
      white-space: nowrap;
    }

    .scope-footer span {
      color: var(--body);
      font-size: 9px;
      line-height: 1.2;
      white-space: nowrap;
    }

    /* ======================================================================
       METRICS SLIDE
       ====================================================================== */

    .metrics-layout {
      display: grid;
      grid-template-columns: minmax(280px,.72fr) minmax(0,1.28fr);
      gap: 27px;
      align-items: stretch;
    }

    .metrics-story {
      min-height: 530px;
      padding: 28px;
      border-radius: 25px;
      background: var(--navy-900);
      color: #fff;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      box-shadow: var(--shadow-md);
    }

    .metrics-story h3 {
      margin: 18px 0 12px;
      color: #fff;
      font-size: 32px;
      line-height: 1.02;
      font-weight: 950;
      letter-spacing: -.045em;
    }

    .metrics-story p {
      margin: 0;
      color: #b8cbe0;
      font-size: 13px;
      line-height: 1.48;
    }

    .metric-equation {
      margin-top: 20px;
      padding: 14px;
      border: 1px solid rgba(255,255,255,.11);
      border-radius: 13px;
      background: rgba(255,255,255,.035);
    }

    .metric-equation strong {
      display: block;
      color: #fff;
      font-size: 10px;
      line-height: 1;
      font-weight: 900;
    }

    .metric-equation span {
      display: block;
      margin-top: 7px;
      color: #9fb7ce;
      font-size: 8.5px;
      line-height: 1.3;
    }

    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(2,minmax(0,1fr));
      gap: 10px;
    }

    .metric-group {
      min-height: 169px;
      padding: 17px 18px;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: #fff;
      box-shadow: var(--shadow-xs);
    }

    .metric-group h3 {
      margin: 0;
      color: var(--navy-900);
      font-size: 14px;
      line-height: 1;
      font-weight: 900;
      white-space: nowrap;
    }

    .metric-group > p {
      margin: 8px 0 12px;
      color: var(--body);
      font-size: 9.5px;
      line-height: 1.3;
    }

    .metric-list {
      display: grid;
      gap: 6px;
    }

    .metric-list div {
      display: flex;
      align-items: center;
      gap: 7px;
      color: var(--ink-soft);
      font-size: 8.5px;
      font-weight: 800;
      white-space: nowrap;
    }

    .metric-list i {
      width: 5px;
      height: 5px;
      flex: 0 0 5px;
      border-radius: 50%;
      background: var(--amber);
    }

    .formula-bar {
      margin-top: 12px;
      padding: 11px 14px;
      border: 1px solid #d5e4f2;
      border-radius: 14px;
      background: var(--blue-soft);
      display: grid;
      grid-template-columns: repeat(5,1fr);
      gap: 10px;
    }

    .formula {
      min-width: 0;
    }

    .formula strong {
      display: block;
      color: var(--navy-900);
      font-size: 8.5px;
      line-height: 1;
      white-space: nowrap;
    }

    .formula span {
      display: block;
      margin-top: 5px;
      color: var(--body);
      font-size: 7.5px;
      line-height: 1.2;
    }

    /* ======================================================================
       PORTFOLIO SLIDE
       ====================================================================== */

    .portfolio-intro {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 24px;
      margin-bottom: 17px;
    }

    .portfolio-intro .section-head { margin-bottom: 0; }

    .portfolio-note {
      width: 265px;
      flex: 0 0 265px;
      padding: 13px 14px;
      border: 1px solid var(--line);
      border-radius: 13px;
      background: var(--bg);
