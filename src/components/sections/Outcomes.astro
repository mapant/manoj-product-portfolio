---
import { outcomes } from '../../data/portfolio.js';
---
<section class="slide white" id="outcomes" data-section>
  <div class="slide-canvas"><div class="canvas-inner">
    <div class="section-head"><span class="section-kicker">Product Outcomes</span><h2>Outcomes that connect product work to real business performance.</h2><p>Selected impact represented across fintech, healthcare and telecom initiatives, connecting adoption, efficiency, automation, compliance and cost optimization.</p></div>
    <div class="outcome-grid">{outcomes.map(([value, label, source]) => <article class="outcome-card"><strong>{value}</strong><h3>{label}</h3><span>{source}</span></article>)}</div>
    <div class="outcome-footer"><b>Outcome framework</b><span>Adoption · Engagement · Efficiency · Compliance · Business Impact</span></div>
  </div></div>
</section>
