---
import { metricGroups } from '../../data/portfolio.js';
const metricValues = ['78%', '62%', '45%', '90%', '68%', '32%'];
---
<section class="slide soft" id="metrics" data-section>
  <div class="slide-canvas"><div class="canvas-inner">
    <div class="metrics-layout">
      <article class="metrics-story">
        <span class="section-kicker">Product Metrics</span>
        <h2>Measure the product, not just the release.</h2>
        <p>Use product metrics to connect activity to adoption, efficiency, quality, control and business impact. Metrics should measure outcomes across the entire product lifecycle.</p>
        <div class="metric-axis"><span>Users</span><span>Behavior</span><span>Efficiency</span><span>Business Impact</span></div>
        <div class="metric-bars"><i></i><i></i><i></i><i></i><i></i><i></i></div>
        <small>North-star metric: Adoption → Usage → Workflow behavior → Operational efficiency → Business outcome</small>
      </article>
      <div class="metric-grid">
        {metricGroups.map(([title, question, metrics], index) => <article class="metric-card"><div><span>{String(index + 1).padStart(2,'0')}</span><b>{title}</b></div><h3>{question}</h3><p>{metrics}</p><strong>{metricValues[index]}</strong></article>)}
      </div>
    </div>
  </div></div>
</section>
