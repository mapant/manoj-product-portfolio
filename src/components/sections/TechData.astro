---
import { capabilityRows, techLayers } from '../../data/portfolio.js';
---
<section class="slide tech-slide" id="tech" data-section>
  <div class="slide-inner tech-layout">
    <div class="tech-left"><div class="eyebrow"><i></i>TECH &amp; DATA</div><h2>Where product meets technology, AI and data.</h2><p>Technical product management grounded in enterprise architecture. APIs, workflows, analytics, integrations and delivery collaboration.</p><div class="translation"><div class="translation-title">PM TRANSLATION LAYER</div>{capabilityRows.slice(0,6).map(([title,text],i)=><div class="translation-row"><b>0{i+1}</b><strong>{title}</strong><span>{text}</span></div>)}</div></div>
    <div class="tech-right"><div class="technology-model"><div class="eyebrow">PRODUCT TECHNOLOGY MODEL FROM BUSINESS REQUIREMENTS TO REAL-WORLD IMPACT</div><div class="tech-flow">{techLayers.slice(0,5).map(([n,title,text],i)=><div><b>{n}</b><strong>{title}</strong><span>{text}</span></div>)}</div></div><div class="architecture"><div class="arch-side left"><span>Core systems</span><span>External APIs</span><span>Partner systems</span></div><div class="arch-stack"><div>API LAYER <small>REST APIs · integrations · security</small></div><div>PRODUCT SERVICES <small>business logic · workflows · AI / GenAI · rules</small></div><div>DATA LAYER <small>SQL · data models · DFD · ER · analytics</small></div></div><div class="arch-side right"><span>Databases</span><span>Documents</span><span>Real-time data</span></div></div><div class="tools"><b>KEY TOOLS &amp; TECHNOLOGIES</b>{['SQL','Power BI','Tableau','Looker Studio','Excel','Figma','JIRA','APIs','DFD / ER','Data Mapping'].map(x=><span>{x}</span>)}</div></div>
  </div>
</section>
