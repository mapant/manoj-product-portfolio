---
import { capabilityRows, techLayers } from '../../data/portfolio.js';
---
<section class="slide soft" id="tech" data-section>
  <div class="slide-canvas"><div class="canvas-inner">
    <div class="tech-layout">
      <div>
        <span class="section-kicker">Tech & Data</span>
        <h2>Where product meets technology, AI and data.</h2>
        <p class="tech-lead">Technical product management grounded in enterprise architecture, APIs, workflows, analytics, integrations and delivery collaboration.</p>
        <div class="capability-table">{capabilityRows.slice(0,6).map(([name, value]) => <div class="capability-row"><strong>{name}</strong><span>{value}</span></div>)}</div>
      </div>
      <article class="tech-model">
        <div class="tech-model-head"><span>PRODUCT TECHNOLOGY MODEL</span><b>From business requirements to real-world impact</b></div>
        <div class="tech-layers">{techLayers.map(([number, name, text]) => <div class="tech-layer"><span>{number}</span><div><b>{name}</b><small>{text}</small></div></div>)}</div>
        <div class="tool-strip"><span>SQL</span><span>Power BI</span><span>Tableau</span><span>Looker Studio</span><span>Excel</span><span>Figma</span><span>JIRA</span><span>APIs</span><span>DFD / ER</span><span>Data Mapping</span></div>
      </article>
    </div>
  </div></div>
</section>
