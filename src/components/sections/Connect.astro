---
import { connectFocus } from '../../data/portfolio.js';
---
<section class="slide page connect-page" id="connect" aria-labelledby="connect-title">
  <div class="page-inner connect-layout">
    <div class="connect-top">
      <div class="connect-copy"><div class="eyebrow violet-line">CONNECT</div><h2 id="connect-title">Building products where business, technology and <em>outcomes meet.</em></h2><p class="connect-location"><b>♦</b> Based in Noida, India <i></i> Open to Product Management, Technical Product and Business Transformation opportunities.</p><p>My experience spans the journey from data and business analysis to 0 → 1 product development and enterprise platform management, with a focus on AI / GenAI, workflow automation and data-driven product decisions.</p>
        <div class="connect-focus">{connectFocus.map(([title, description, color]) => <article class:list={[`tone-${color}`]}><b>{['◎','♧','♧','⬡','▥'][connectFocus.findIndex((item) => item[0] === title)]}</b><strong>{title}</strong><small>{description}</small></article>)}</div>
      </div>
      <div class="connect-scene" aria-label="Product planning desk illustration"><svg viewBox="0 0 600 470" role="img"><defs><linearGradient id="screen" x2="1" y2="1"><stop stop-color="#183457"/><stop offset="1" stop-color="#06182e"/></linearGradient><linearGradient id="desk" x2="0" y2="1"><stop stop-color="#fff"/><stop offset="1" stop-color="#d7e9f2"/></linearGradient></defs><rect x="0" y="0" width="600" height="470" fill="url(#desk)"/><g class="plant"><path d="M60 250Q40 140 100 80M64 200Q15 150 30 115M83 167Q130 125 135 90M75 135Q68 75 92 50" fill="none" stroke="#547f39" stroke-width="8"/><ellipse cx="30" cy="112" rx="13" ry="35" fill="#6a9b42" transform="rotate(-32 30 112)"/><ellipse cx="103" cy="81" rx="14" ry="40" fill="#4f8b36" transform="rotate(23 103 81)"/><ellipse cx="137" cy="89" rx="13" ry="38" fill="#89b755" transform="rotate(30 137 89)"/><ellipse cx="92" cy="50" rx="12" ry="34" fill="#71a04d"/><path d="M40 242h68l-8 72H50z" fill="#d8e3dc"/></g><g font-family="Arial" text-anchor="middle"><rect x="225" y="35" width="68" height="83" rx="3" fill="#b6f3e8" transform="rotate(5 225 35)"/><text x="257" y="69" font-size="16" fill="#182b42">Ideas</text><text x="257" y="89" font-size="15" fill="#182b42">to</text><text x="257" y="108" font-size="15" fill="#182b42">Products</text><rect x="310" y="51" width="72" height="84" rx="3" fill="#ffe36e" transform="rotate(3 310 51)"/><text x="346" y="86" font-size="15" fill="#182b42">Data</text><text x="346" y="106" font-size="14" fill="#182b42">to Insights</text><rect x="398" y="73" width="76" height="88" rx="3" fill="#ffa5ac" transform="rotate(-2 398 73)"/><text x="436" y="110" font-size="15" fill="#182b42">People</text><text x="436" y="131" font-size="14" fill="#182b42">to Impact</text></g><g><path d="M161 275l42-142q3-10 15-9l217 18q10 1 8 12l-23 143z" fill="#1b2430"/><path d="M176 268l37-126 213 17-22 123z" fill="url(#screen)"/><text x="286" y="193" fill="#dbe9f5" font-family="Arial" font-size="20" font-style="italic" text-anchor="middle">Ideas · Products</text><text x="293" y="220" fill="#dbe9f5" font-family="Arial" font-size="19" font-style="italic" text-anchor="middle">People · Impact</text><path d="M218 245q46 3 82-18l40-36" fill="none" stroke="#fff" stroke-width="2"/><path d="M328 190l14 1-4 14" fill="none" stroke="#fff" stroke-width="2"/><path d="M139 279l306 14 72 40q-7 11-28 12l-326-22q-23-2-24-16z" fill="#bcc5ce"/><path d="M250 294l95 4-8 10-97-5z" fill="#8b959f"/></g><g font-family="Arial" font-size="13" font-weight="bold"><rect x="402" y="201" width="142" height="29" rx="3" fill="#f2a22d"/><text x="414" y="220" fill="#1d2530">Product Strategy</text><rect x="408" y="232" width="143" height="28" rx="3" fill="#dd4846"/><text x="420" y="251" fill="#fff">AI / GenAI</text><rect x="414" y="262" width="143" height="28" rx="3" fill="#23a5b7"/><text x="425" y="281" fill="#fff">Data &amp; Analytics</text><rect x="420" y="292" width="143" height="28" rx="3" fill="#7e939e"/><text x="431" y="311" fill="#fff">Workflow Automation</text><rect x="426" y="322" width="143" height="28" rx="3" fill="#353f47"/><text x="437" y="341" fill="#fff">Business Impact</text></g><g><ellipse cx="380" cy="369" rx="34" ry="8" fill="#151a21"/><path d="M350 360h52v36q-25 14-50 0z" fill="#202a35"/><path d="M402 368q27-12 23 10-4 14-23 10" fill="none" stroke="#202a35" stroke-width="7"/><text x="376" y="380" fill="#fff" font-family="Arial" font-size="9" text-anchor="middle">Better Products</text><path d="M460 390l118-23v88l-133-19z" fill="#fff" stroke="#cbd6df"/><path d="M459 407l100-17M459 418l72-13M453 432l95-17" stroke="#4b8bba" stroke-width="2"/><path d="M531 424l39-62" stroke="#213b58" stroke-width="5"/><path d="M548 393l7 2" stroke="#e2b64d" stroke-width="8"/></g></svg></div>
      <aside class="contact-card"><span class="contact-label">LET’S CONNECT</span><span class="paper-plane">➤</span><h3>Have a product, platform or transformation opportunity?</h3><p>I'm open to conversations around Product Management, Technical Product Management, Business Analysis and enterprise technology products.</p>
        <form id="connect-form"><div class="form-two"><label><span>♙</span><input name="name" placeholder="Your name *" required/></label><label><span>▣</span><input name="company" placeholder="Your company"/></label></div><label><span>✉</span><input type="email" name="email" placeholder="Your email *" required/></label><label><span>☏</span><select name="topic"><option value="">I'm reaching out for...</option></select></label><label class="message-field"><span>☷</span><textarea name="message" maxlength="500" placeholder="Your message (optional)"></textarea><small>0/500</small></label><button type="submit">➤ &nbsp; Send Message <b>→</b></button></form><small class="form-note">This will open your email client with the details filled in.</small>
      </aside>
    </div>
    <div class="connect-bottom"><article><div class="bottom-heading"><b>↗</b><span><strong>Connect on professional platforms</strong><small>Let's connect and stay in touch on professional networks.</small></span></div><div class="social-links"><a href="https://www.linkedin.com/in/manoj-pant-35129495/" target="_blank" rel="noreferrer"><b>in</b><strong>LinkedIn<small>View profile →</small></strong></a><a href="https://github.com/mapant" target="_blank" rel="noreferrer"><b>◉</b><strong>GitHub<small>View projects →</small></strong></a><a href="https://x.com/" target="_blank" rel="noreferrer"><b>𝕏</b><strong>X (Twitter)<small>Follow updates →</small></strong></a></div></article><article><div class="bottom-heading"><b>▣</b><span><strong>Open to opportunities</strong><small>Open to Product Management, Technical Product, Business Analysis and strategic roles.</small></span></div><div class="availability"><span>● Full-time</span><span>● Contract / Consulting</span><span>● Remote / Hybrid</span></div></article><article class="location-panel"><div class="bottom-heading"><b>♦</b><span><strong>Based in Noida, India</strong><small>Available for opportunities across India and open to relocation for the right role.</small></span></div><div class="cityline">◢&nbsp; NOIDA &nbsp; • &nbsp; INDIA &nbsp; ◣</div></article></div>
  </div>
</section>
<script>
  const form = document.querySelector('#connect-form');
  const message = form?.querySelector('textarea');
  const counter = form?.querySelector('.message-field small');
  message?.addEventListener('input', () => { if (counter) counter.textContent = `${message.value.length}/500`; });
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const subject = encodeURIComponent(`Portfolio inquiry from ${data.get('name')}`);
    const body = encodeURIComponent(`Name: ${data.get('name')}\nCompany: ${data.get('company')}\nEmail: ${data.get('email')}\nTopic: ${data.get('topic')}\n\n${data.get('message')}`);
    window.location.href = `mailto:manoj.pant.pm@outlook.com?subject=${subject}&body=${body}`;
  });
</script>
