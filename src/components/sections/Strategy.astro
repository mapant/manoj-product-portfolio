---
import { strategySteps } from '../../data/portfolio.js';
---
<section class="slide soft" id="strategy" data-section>
  <div class="slide-canvas"><div class="canvas-inner">
    <div class="strategy-layout">
      <article class="strategy-intro">
        <span class="section-kicker">Product Strategy</span>
        <h2>From problem framing to measurable product delivery.</h2>
        <p>A practical strategy model keeps customer need, evidence, feasibility, AI / automation potential and measurable outcomes connected.</p>
        <div class="strategy-outcomes"><span>Customer need & experience</span><span>Strategy & priorities</span><span>Execution & enablement</span><span>Measurement & outcomes</span></div>
      </article>
      <div class="strategy-flow">
        {strategySteps.map(([number, tag, title, text]) => <article class="strategy-step"><div class="step-top"><span>{number}</span><b>{tag}</b></div><h3>{title}</h3><p>{text}</p><small>PM focus · Evidence → decision → outcome</small></article>)}
      </div>
    </div>
  </div></div>
</section>
