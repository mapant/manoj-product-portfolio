---
import { pmScope } from '../../data/portfolio.js';
---
<section class="slide white" id="scope" data-section>
  <div class="slide-canvas"><div class="canvas-inner">
    <div class="scope-layout">
      <article class="scope-intro">
        <span class="section-kicker">PM Scope</span>
        <h2>Product management across strategy, systems and execution.</h2>
        <p>End-to-end ownership from problem discovery and requirements to solution design, build, deployment and continuous improvement across stakeholders, systems and regulated environments.</p>
        <div class="scope-pillars"><span>Business & Customer</span><span>Strategy & Planning</span><span>Cross-functional Collaboration</span><span>Regulated & Compliant Delivery</span></div>
      </article>
      <div class="scope-grid">
        {pmScope.map(([number, title, text]) => <article class="scope-card"><span>{number}</span><h3>{title}</h3><p>{text}</p><small>Key outputs · Product artefacts, decisions and delivery readiness</small></article>)}
      </div>
    </div>
  </div></div>
</section>
