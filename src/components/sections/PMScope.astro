---
import { pmScope } from '../../data/portfolio.js';
---
<section class="slide scope-slide" id="scope" data-section>
  <div class="slide-inner scope-layout">
    <aside class="dark-story scope-intro"><div class="eyebrow light"><i></i>PM SCOPE</div><h2>Product management across <span>strategy, systems and execution.</span></h2><p>End-to-end ownership from problem discovery and requirements to solution design, build, deployment and continuous improvement across stakeholders, systems and regulated environments.</p><div class="scope-tags"><span>DISCOVER</span><span>DEFINE</span><span>DESIGN</span><span>ARCHITECT</span><span>DELIVER</span></div></aside>
    <div class="scope-work"><div class="swimlane-head"><span>INSIGHTS</span><span>SOLUTION DESIGN</span><span>EXECUTION</span><span>ADOPTION &amp; IMPACT</span></div><div class="scope-board">{pmScope.map(([n,title,text],i) => <article class={`scope-card sc${i+1}`}><b>{n}</b><h3>{title}</h3><p>{text}</p><small>KEY OUTPUTS</small><span>{i===0?'Discovery notes · process maps':i===1?'BRD · FRD · FSD · user stories':i===2?'Figma · workflows · feature specs':i===3?'APIs · DFD · ER · field mapping':i===4?'Rules · approvals · reconciliation':i===5?'AI use cases · intelligence workflows':i===6?'Epics · QA · UAT · VAPT': 'Migration · deployment · training · rollout'}</span></article>)}</div><div class="scope-flow"><span>Business &amp; Customer Needs</span><i>→</i><strong>Product Management</strong><i>→</i><span>Architecture · Intelligence · Workflows</span><i>→</i><strong>Impact</strong></div></div>
  </div>
</section>
