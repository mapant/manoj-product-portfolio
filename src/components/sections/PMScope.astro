---
import { scopeCards } from '../../data/portfolio.js';
---
<section class="slide page scope-page" id="scope" aria-labelledby="scope-title">
  <div class="page-inner scope-layout">
    <article class="dark-story scope-story">
      <div class="eyebrow amber-line">PM SCOPE</div>
      <h2 id="scope-title">Product management across strategy, systems and execution.</h2>
      <p>End-to-end ownership from problem discovery and requirements to solution design, build, deployment and continuous improvement, across multiple stakeholders, systems and regulated environments.</p>
      <div class="scope-principles"><span>♟ <b>Business &amp; Customer</b><small>Needs &amp; Outcomes</small></span><span>◎ <b>Strategy &amp; Planning</b><small>Vision &amp; Roadmap</small></span></div>
      <div class="scope-cycle"><div class="cycle-row"><b>01<br/>Discover</b><i>→</i><b>02<br/>Define</b><i>→</i><b>03<br/>Design</b><i>→</i><b>04<br/>Architect</b></div><strong>⬡<br/>Product<br/>Management</strong><div class="cycle-row"><b>05<br/>Automate</b><i>→</i><b>06<br/>AI / GenAI</b><i>→</i><b>07<br/>Deliver</b><i>→</i><b>Scale<br/>&amp; Adopt</b></div></div>
      <div class="scope-principles bottom"><span>♟ <b>Cross-functional</b><small>Collaboration</small></span><span>⬡ <b>Regulated &amp;</b><small>Compliant Delivery</small></span><span>▥ <b>Data-Driven</b><small>Decisions</small></span><span>⟳ <b>Continuous</b><small>Improvement</small></span></div>
      <div class="story-caption">FROM IDEAS AND REQUIREMENTS TO REAL-WORLD IMPACT</div>
    </article>
    <div class="scope-cards">
      {scopeCards.map((card, i) => <article class:list={['scope-card', `tone-${['blue','purple','green','amber','pink','blue','purple','green'][i]}`]}><div class="scope-card-head"><b>{card.n}</b><div><h3>{card.title}</h3><p>{card.description}</p></div><small>{card.eyebrow}</small></div><ul>{card.items.map((item) => <li>{item}</li>)}</ul><div class="scope-output"><span>{['♟','▤','◉','⚙','⚙','✦','🚀','▥'][i]}</span><div><b>KEY OUTPUTS:</b><small>{card.output}</small></div></div></article>)}
    </div>
  </div>
</section>
