---
import { products } from '../../data/portfolio.js';
---
<section class="slide white" id="portfolio" data-section>
  <div class="slide-canvas"><div class="canvas-inner">
    <div class="portfolio-head"><div><span class="section-kicker">Selected Product Portfolio</span><h2>Real products. Real impact. Across domains and platforms.</h2><p>Five representative case studies from my product journey. Each highlights the problem, my ownership, the solution context and the outcome.</p></div><aside class="portfolio-note"><b>Portfolio lens</b><span>Problem → Ownership → Solution → Outcome</span><small>Click to explore the detailed case study.</small></aside></div>
    <div class="portfolio-grid">
      {products.map((product) => <article class={`portfolio-card ${product.tone}`}>
        <div class="portfolio-top"><span>{product.number}</span><small>{product.company}</small></div>
        <h3>{product.title}</h3>
        <div class="portfolio-block"><b>Problem</b><p>{product.problem}</p></div>
        <div class="portfolio-block"><b>My Ownership</b><p>{product.ownership}</p></div>
        <div class="portfolio-outcome"><b>Outcome</b><p>{product.outcome}</p></div>
        <div class="tag-row">{product.tags.map((tag) => <span>{tag}</span>)}</div>
        <a class="case-link" href={product.url}>View Case Study <span>→</span></a>
      </article>)}
    </div>
  </div></div>
</section>
