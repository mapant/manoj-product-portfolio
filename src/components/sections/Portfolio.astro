---
import { products } from '../../data/portfolio.js';
---
<section class="slide white" id="portfolio" data-section>
  <div class="slide-canvas"><div class="canvas-inner">
    <div class="section-head portfolio-head"><div><span class="section-kicker">07 · Selected Product Portfolio</span><h2>Five products. Five different problem spaces.</h2><p>Case studies show the product context, ownership and measurable result.</p></div><span class="portfolio-note">Open a case study for the full product story →</span></div>
    <div class="portfolio-grid">
      {products.map((product) => <article class={`portfolio-card ${product.tone}`}>
        <div class="portfolio-top"><span>{product.number}</span><small>{product.company}</small></div>
        <h3>{product.title}</h3>
        <div class="portfolio-block"><b>Problem</b><p>{product.problem}</p></div>
        <div class="portfolio-block"><b>Ownership</b><p>{product.ownership}</p></div>
        <div class="portfolio-outcome"><b>Outcome</b><p>{product.outcome}</p></div>
        <div class="tag-row">{product.tags.map((tag) => <span>{tag}</span>)}</div>
        <a class="case-link" href={product.url}>View Case Study <span>↗</span></a>
      </article>)}
    </div>
  </div></div>
</section>
