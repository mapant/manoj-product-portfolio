---
import { products } from '../../data/portfolio.js';
---
<section class="slide portfolio-slide" id="portfolio" data-section>
  <div class="slide-inner">
    <div class="split-heading portfolio-heading"><div><div class="eyebrow"><i></i>SELECTED PRODUCT PORTFOLIO</div><h2>Real products. Real impact. Across domains and platforms.</h2><p>Five representative case studies from my product journey. Each project highlights the problem, my ownership, solution direction, key metrics and impact.</p></div><div class="section-index">07</div></div>
    <div class="portfolio-list">{products.map((p) => <article class={`portfolio-row ${p.tone}`}><div class="project-main"><span class="project-no">{p.number}</span><div><small>{p.company}</small><h3>{p.title}</h3><div class="pills">{p.tags.map(t => <span>{t}</span>)}</div></div></div><div class="project-detail"><div><b>PROBLEM</b><p>{p.problem}</p></div><div><b>MY OWNERSHIP</b><p>{p.ownership}</p></div><div><b>OUTCOME</b><p>{p.outcome}</p></div></div><div class="project-action"><div class="metric-badge">{p.number==='01'?'100+':p.number==='02'?'25%':p.number==='03'?'40→75%':p.number==='04'?'10→2d':'25%'}<small>{p.number==='01'?'Banks deployed':p.number==='02'?'Effort reduction':p.number==='03'?'Doctor adoption':p.number==='04'?'Payout TAT':'Cost reduction'}</small></div><a href={p.url}>View Case Study <span>→</span></a></div></article>)}</div>
  </div>
</section>
