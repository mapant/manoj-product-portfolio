---
import ProjectShell from './ProjectShell.astro';
import IntegratedChannelsPresentation from './IntegratedChannelsPresentation.astro';
import '../styles/docconnect-overview-prototype.scss';
import '../styles/integrated-channels-case-study.scss';

const navSections = [
  ['overview', 'Overview'], ['ecosystem', 'Ecosystem'], ['challenge', 'Challenge'],
  ['strategy', 'Strategy'], ['pm-scope', 'PM Scope'], ['product-metrics', 'Product Metrics'],
  ['portfolio', 'Portfolio'], ['tech-data', 'Tech & Data'], ['outcomes', 'Outcomes'],
  ['product-leadership', 'Product Leadership'],
] as [string, string][];

const APPS=[{"id": "audit", "name": "Audit", "category": "Governance & Control", "color": "#b7a6ff", "purpose": "Internal, compliance, statutory and operations audit management.", "problem": "Structured planning, evidence, observations, ownership, closure and management visibility.", "capabilities": ["Internal Audit", "Compliance Audit", "Statutory Audit", "Operations Audit", "Findings & action tracking", "Audit reporting"], "users": ["Auditor", "Audit Manager", "Business Owner", "Approver", "Leadership"], "integrations": ["Source / core systems", "Document repository", "Reporting layer"], "workflow": ["Audit plan", "Scope & evidence", "Observation", "Action owner", "Closure", "Management view"], "reports": ["Audit status", "Open findings", "Closure ageing", "Management report"], "pm": ["Discovery & requirement elicitation", "Workflow and role design", "BRD / FRD / FSD", "Acceptance criteria", "Reporting requirements", "UAT & client demo"], "api": "/api/v1/audit/findings", "error": "Finding cannot be closed until mandatory evidence and owner response are captured.", "learning": "Control-heavy products require explicit ownership, evidence and exception paths—not only happy-path screens."}, {"id": "fam", "name": "FAM", "category": "Financial Control", "color": "#8bd8c5", "purpose": "Fixed Assets Management for physical assets across the institution.", "problem": "A structured asset register with lifecycle visibility, categorisation, assignment, tracking and depreciation.", "capabilities": ["Asset registration", "Asset categorisation", "Assignment / tracking", "Depreciation", "Asset history", "Operational reporting"], "users": ["Asset Manager", "Branch / Operations", "Finance", "Approver", "Auditor"], "integrations": ["Finance / accounting data", "GST-related information", "Document repository"], "workflow": ["Register asset", "Classify", "Assign", "Track", "Depreciate", "Report"], "reports": ["Asset register", "Depreciation", "Asset movement", "Category-wise inventory"], "pm": ["Domain modelling", "Data-field definition", "Validation rules", "Role matrix", "Report specification", "Client feedback"], "api": "/api/v1/assets/{asset_id}", "error": "Asset assignment blocked: destination branch and custodian are required.", "learning": "Operational modules become reliable when master data, lifecycle state and ownership are designed together."}, {"id": "gst", "name": "GST", "category": "Financial Control", "color": "#ffd39a", "purpose": "GST-related purchase, calculation, warranty, insurance and reporting workflows.", "problem": "Tax and purchase information needs traceability from source transaction through calculation and reporting.", "capabilities": ["Purchase capture", "GST calculation", "Warranty tracking", "Insurance tracking", "GSTR1B-related extraction", "Reporting"], "users": ["Finance User", "Operations User", "Approver", "Auditor"], "integrations": ["GST portal / external source where applicable", "Finance systems", "FAM"], "workflow": ["Purchase", "Capture tax data", "Validate", "Track warranty / insurance", "Extract", "Report"], "reports": ["GST summary", "Purchase register", "Warranty ageing", "Insurance register"], "pm": ["Requirement elicitation", "Integration mapping", "Validation rules", "Report design", "UAT scenarios"], "api": "/api/v1/gst/transactions", "error": "Tax calculation requires valid tax category and transaction jurisdiction.", "learning": "Financial-control products need traceability from the originating transaction to the reporting output."}, {"id": "los-lms", "name": "LOS–LMS", "category": "Lending & Credit", "color": "#83b9ff", "purpose": "Loan origination and loan management workflows across multiple loan products.", "problem": "Different loan products need common lending controls while retaining product-specific configuration and approval flows.", "capabilities": ["Vehicle loans", "Education loans", "Gold loans", "Staff loans", "Personal loans", "Home loans", "Maker-checker-sanctioner", "Disbursement", "Repayment schedule configuration"], "users": ["Maker", "Checker", "Sanctioner", "Credit", "Operations", "Admin"], "integrations": ["CIBIL", "DMS & CKYC", "Core banking / bank systems", "Payment / collection systems"], "workflow": ["Application", "Checks", "Credit decision", "Sanction", "Disbursement", "Repayment"], "reports": ["Application funnel", "Approval status", "Disbursement status", "Workflow ageing"], "pm": ["Product strategy", "Journey & workflow design", "API / integration requirements", "Business rules", "UAT scenario design", "Client demos"], "api": "/api/v1/loans/applications", "error": "Sanction action unavailable: checker approval is pending.", "learning": "A reusable lending platform needs configurable product rules without losing the controls that make credit workflows auditable."}, {"id": "cms", "name": "CMS", "category": "Payments & Cards", "color": "#ff9fc5", "purpose": "Card management covering personalised and instant cards across major card networks.", "problem": "Card operations require network-aware product configuration, issuance workflows and operational visibility.", "capabilities": ["Personalised cards", "Instant cards", "Card product setup", "RuPay", "Visa", "Mastercard", "NBIN-related issuance context", "Operational reporting"], "users": ["Card Operations", "Maker", "Checker", "Branch User", "Admin"], "integrations": ["NPCI / card ecosystem", "RuPay", "Visa", "Mastercard", "Core banking"], "workflow": ["Request", "Validate", "Network route", "Issue", "Track", "Report"], "reports": ["Issuance status", "Card product summary", "Pending actions", "Operations dashboard"], "pm": ["Integration readiness", "Configuration design", "Exception handling", "API requirements", "Client demos", "UAT"], "api": "/api/v1/cards/requests", "error": "Card request cannot progress: network/product mapping is incomplete.", "learning": "Network-dependent products need configuration, dependency visibility and failure handling as first-class product concerns."}, {"id": "shares", "name": "Shares", "category": "Financial Control", "color": "#a7d8ff", "purpose": "Share and portfolio management with dividend calculation and governance reporting.", "problem": "Share operations need controlled updates, calculations, approvals and reliable management outputs.", "capabilities": ["Share management", "Portfolio management", "Dividend calculation", "Maker-checker", "Board meeting reports", "Operational reporting"], "users": ["Share Manager", "Maker", "Checker", "Finance", "Management"], "integrations": ["Core / finance data", "Document repository", "Reporting layer"], "workflow": ["Capture holding", "Validate", "Calculate", "Approve", "Report", "Board view"], "reports": ["Portfolio summary", "Dividend report", "Shareholding report", "Board meeting pack"], "pm": ["Business-rule mapping", "Workflow controls", "Report specification", "Data validation", "UAT"], "api": "/api/v1/shares/portfolio", "error": "Dividend calculation requires an approved shareholding snapshot.", "learning": "When outputs feed governance forums, calculation integrity and approval lineage become product features."}, {"id": "pm-schemes", "name": "PM Schemes", "category": "Operations", "color": "#9fe3a9", "purpose": "Management of government-launched schemes through configurable operational workflows.", "problem": "Scheme processes evolve and need configurable operational journeys, controls and reporting.", "capabilities": ["Scheme master", "Eligibility / workflow configuration", "Operational tracking", "Status monitoring", "Reports", "User controls"], "users": ["Scheme Operations", "Maker", "Checker", "Branch User", "Admin"], "integrations": ["Bank systems", "Customer / account data", "Reporting layer"], "workflow": ["Scheme setup", "Capture", "Validate", "Process", "Track", "Report"], "reports": ["Scheme status", "Application / beneficiary view", "Pending actions", "Management summary"], "pm": ["Configuration strategy", "Workflow design", "Stakeholder alignment", "Training", "Feedback-driven enhancement"], "api": "/api/v1/schemes", "error": "Scheme processing blocked: mandatory scheme parameters are incomplete.", "learning": "Configuration reduces the need to rebuild the product every time an operational programme changes."}, {"id": "cibil", "name": "CIBIL", "category": "Lending & Credit", "color": "#86c8ff", "purpose": "Credit-information retrieval through API connectivity for lending workflows.", "problem": "Credit decisions depend on timely external credit information and a reliable exception path when the dependency fails.", "capabilities": ["Credit information request", "API connectivity", "Response capture", "Status tracking", "Exception handling", "LOS hand-off"], "users": ["Credit User", "Maker", "Operations", "Admin"], "integrations": ["CIBIL API", "LOS–LMS", "Customer / application data"], "workflow": ["Loan application", "Request credit info", "API response", "Validate", "Attach to decision", "Continue"], "reports": ["Request status", "Response success / failure", "Pending requests", "Credit workflow view"], "pm": ["API requirement definition", "Failure-state design", "Integration testing", "UAT", "Operational readiness"], "api": "/api/v1/credit/cibil/request", "error": "Credit bureau response unavailable. Retry and manual exception handling are required.", "learning": "An integration is not complete when the happy-path API works; timeout, retry, status and recovery are product requirements."}, {"id": "reconciliation", "name": "Reconciliation", "category": "Payments & Cards", "color": "#f4c78e", "purpose": "Transaction reconciliation across AEPS, UPI, Switch, ATM and other transaction streams.", "problem": "Identify matched and unmatched records, manage exceptions and close reconciliation cycles.", "capabilities": ["Transaction ingestion", "Matching / reconciliation", "Exception identification", "Status tracking", "Operational reporting", "Settlement-oriented views"], "users": ["Reconciliation User", "Operations", "Maker", "Checker", "Finance"], "integrations": ["AEPS", "UPI", "Switch", "ATM", "Bank transaction systems"], "workflow": ["Ingest", "Normalise", "Match", "Exception", "Resolve", "Close"], "reports": ["Matched / unmatched", "Exception ageing", "Stream-wise summary", "Daily reconciliation"], "pm": ["Data-flow mapping", "Exception design", "Operational dashboards", "Integration readiness", "UAT"], "api": "/api/v1/reconciliation/transactions", "error": "Record remains unreconciled: source reference and settlement amount differ.", "learning": "Reconciliation is fundamentally an exception-management product; the unresolved queue is as important as the matched count."}, {"id": "aml-kyc", "name": "AML–KYC", "category": "Compliance", "color": "#ffb2a6", "purpose": "Transaction monitoring, rule-based flagging and compliance reporting.", "problem": "Compliance teams need to identify relevant activity, investigate exceptions and produce required reporting with traceability.", "capabilities": ["Transaction monitoring", "Rule-based flagging", "Risk / alert workflow", "CTR reporting", "STR reporting", "NTR reporting", "KYC controls", "Compliance dashboards"], "users": ["Compliance User", "AML Analyst", "Maker", "Checker", "Compliance Manager"], "integrations": ["Transaction sources", "KYC / CKYC", "Bank systems", "Reporting interfaces"], "workflow": ["Transaction", "Rules", "Alert", "Review", "Decision", "Report"], "reports": ["Alerts", "Case ageing", "CTR", "STR", "NTR", "Compliance summary"], "pm": ["Regulatory requirement translation", "Rule / workflow design", "Reporting", "Stakeholder governance", "UAT", "Operational training"], "api": "/api/v1/aml/alerts", "error": "Alert cannot be closed: review disposition and mandatory evidence are missing.", "learning": "Compliance products need traceability: why something was flagged, who reviewed it, what evidence was used and what was reported."}, {"id": "treasury", "name": "Treasury", "category": "Financial Control", "color": "#9ed7ff", "purpose": "Treasury operational workflows supporting BOD and EOD activities.", "problem": "Time-bound treasury activities need clear state transitions, dependencies, controls and closure visibility.", "capabilities": ["BOD activities", "EOD activities", "Operational checklist", "Status tracking", "Exception visibility", "Reporting"], "users": ["Treasury User", "Maker", "Checker", "Treasury Manager", "Admin"], "integrations": ["Core banking / finance systems", "Transaction data", "Reporting layer"], "workflow": ["BOD start", "Validate inputs", "Execute", "Check", "EOD close", "Report"], "reports": ["BOD checklist", "EOD status", "Pending actions", "Treasury summary"], "pm": ["Operational workflow design", "Dependency mapping", "Exception paths", "Release readiness", "Client feedback"], "api": "/api/v1/treasury/eod", "error": "EOD close blocked: a mandatory reconciliation / validation task is still open.", "learning": "Time-bound operational products need strong guardrails before a cycle can be closed."}, {"id": "dms-ckyc", "name": "DMS & CKYC", "category": "Compliance", "color": "#c2b0ff", "purpose": "Document management and CKYC workflows covering OVD, verification, secure storage and CKYC retrieval.", "problem": "KYC processes require complete customer information, authentic documents, controlled access and reliable retrieval.", "capabilities": ["OVD capture", "Customer information", "Document authenticity verification", "Secure storage", "CKYC number retrieval", "Document status"], "users": ["KYC User", "Maker", "Checker", "Compliance", "Admin"], "integrations": ["CKYC", "Customer / account systems", "LOS–LMS", "Document services"], "workflow": ["Capture", "Validate", "Verify", "Store", "Retrieve CKYC", "Share status"], "reports": ["KYC status", "Document completeness", "Verification exceptions", "CKYC lookup status"], "pm": ["Data model", "API integration", "Security considerations", "Edge-case design", "UAT", "Training"], "api": "/api/v1/ckyc/search", "error": "Document rejected: authenticity or mandatory metadata validation failed.", "learning": "Document products need lifecycle, metadata, permissions and verification—not simply file upload."}];

---

<ProjectShell
  title="Integrated Channels Suite"
  previous={{ title: 'Telecom Analytics & Cost Optimization', href: '/projects/telecom-cost-optimization' }}
  next={{ title: 'Ayu DocConnect', href: '/projects/ayu-docconnect' }}
  navSections={navSections}
  ctaText="View Projects"
  ctaHref="/#portfolio"
  showProjectFooter={false}
  viewportFitPrototype={true}
>
  <IntegratedChannelsPresentation apps={APPS} />

  <div aria-hidden="true" class="ics-modal-backdrop" id="backdrop">
    <aside class="ics-modal" role="dialog" aria-modal="true" aria-labelledby="dname">
      <div class="ics-modal-head"><span class="ics-modal-badge" id="dbadge">A</span><div><h2 id="dname">Application</h2><small id="dcat">Domain</small></div><button type="button" class="ics-modal-close" id="close" aria-label="Close product workspace">×</button></div>
      <div class="ics-modal-body" id="dbody"></div>
    </aside>
  </div>

  <script is:inline define:vars={{ appData: APPS }}>
    const APPS = appData;
    const esc = value => String(value).replace(/[&<>"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[char]));
    const backdrop = document.getElementById('backdrop');
    const closeButton = document.getElementById('close');
    let returnHash = '#portfolio';

    function showApp(id, push = true) {
      const app = APPS.find(item => item.id === id);
      if (!app) return;
      document.getElementById('dbadge').textContent = app.name.slice(0, 1);
      document.getElementById('dname').textContent = app.name;
      document.getElementById('dcat').textContent = `${app.category} · Integrated Channels Suite`;
      const list = items => items.map(item => `<li>${esc(item)}</li>`).join('');
      const reports = app.reports.map((name, index) => `<tr><td>${esc(name)}</td><td>${esc(['Operational monitoring','Management visibility','Exception management','Control / compliance'][index % 4])}</td><td>${index % 2 ? 'On demand' : 'Cycle / daily'}</td></tr>`).join('');
      const api = esc(JSON.stringify({reference_id:'IC-DEMO-001',application:app.name,source_system:'BANK-SOURCE',idempotency_key:'synthetic-key',metadata:{channel:'operations',suite:'integrated-channels'}},null,2));
      document.getElementById('dbody').innerHTML = `
        <div class="ics-modal-two-col">
          <article class="ics-modal-card"><span class="ics-overline">Product brief</span><h3>${esc(app.purpose)}</h3><p><b>Problem:</b> ${esc(app.problem)}</p><div class="ics-modal-subsection"><h4>Core capabilities</h4><ul>${list(app.capabilities)}</ul></div></article>
          <article class="ics-modal-card"><span class="ics-overline">Users &amp; ecosystem</span><div class="ics-modal-subsection"><h4>Primary users</h4><ul>${list(app.users)}</ul></div><div class="ics-modal-subsection"><h4>Integration landscape</h4><ul>${list(app.integrations)}</ul></div></article>
        </div>
        <section class="ics-modal-card ics-modal-section"><div class="ics-modal-section-head"><h3>End-to-end workflow</h3><span>Conceptual product journey</span></div><ol class="ics-modal-flow">${app.workflow.map((step,index)=>`<li><b>${String(index+1).padStart(2,'0')} · ${esc(step)}</b><span>State · owner · validation · next action</span></li>`).join('')}</ol></section>
        <section class="ics-modal-card ics-modal-section"><div class="ics-modal-section-head"><h3>Sample reporting view</h3><span>Synthetic · no client data</span></div><div class="ics-modal-report"><b>${esc(app.name)} Operations Dashboard</b><table><thead><tr><th>Report / widget</th><th>Product purpose</th><th>Cadence</th></tr></thead><tbody>${reports}</tbody></table></div></section>
        <div class="ics-modal-two-col"><article class="ics-modal-card"><div class="ics-modal-section-head"><h3>API / integration thinking</h3><span>Conceptual contract</span></div><pre><b>POST</b> ${esc(app.api)}\n\n${api}</pre><div class="ics-modal-error"><b>Representative guardrail / exception</b><p>${esc(app.error)}</p></div></article><article class="ics-modal-card"><span class="ics-overline">Product management contribution</span><ul>${list(app.pm)}</ul><div class="ics-modal-subsection"><span class="ics-overline">Product learning</span><p>${esc(app.learning)}</p></div></article></div>
        <section class="ics-modal-card ics-modal-section"><span class="ics-overline">Portfolio artefacts represented</span><ul class="ics-artifact-list">${list(['Problem statement / use cases','Workflow & role model','BRD / FRD / FSD','Figma / product screens','DFD / ER / architecture','API specification','Acceptance criteria / UAT','User manual / training'])}</ul></section>`;
      backdrop.classList.add('is-open');
      backdrop.setAttribute('aria-hidden','false');
      document.body.classList.add('ics-modal-open');
      if (push) {
        returnHash = location.hash && !location.hash.startsWith('#app/') ? location.hash : '#portfolio';
        history.replaceState({app:id}, '', `${location.pathname}#app/${id}`);
      }
    }

    function closeApp(push = true) {
      backdrop.classList.remove('is-open');
      backdrop.setAttribute('aria-hidden','true');
      document.body.classList.remove('ics-modal-open');
      if (push && location.hash.startsWith('#app/')) history.replaceState({}, '', `${location.pathname}${returnHash}`);
    }

    document.querySelectorAll('[data-open]').forEach(node => node.addEventListener('click', event => { event.preventDefault(); showApp(node.dataset.open); }));
    closeButton?.addEventListener('click', () => closeApp());
    backdrop?.addEventListener('click', event => { if (event.target === backdrop) closeApp(); });
    document.addEventListener('keydown', event => { if (event.key === 'Escape') closeApp(); });
    if (location.hash.startsWith('#app/')) showApp(location.hash.slice(5), false);
  </script>
</ProjectShell>
