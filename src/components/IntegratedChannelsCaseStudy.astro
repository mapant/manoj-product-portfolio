const navSections = [
  ['overview', 'Overview'], ['ecosystem', 'Ecosystem'], ['challenge', 'Challenge'],
  ['strategy', 'Strategy'], ['pm-scope', 'PM Scope'], ['product-metrics', 'Product Metrics'],
  ['portfolio', 'Portfolio'], ['tech-data', 'Tech & Data'], ['outcomes', 'Outcomes'],
  ['product-leadership', 'Product Leadership'],
] as [string, string][];

const APPS=[{"id": "audit", "name": "Audit", "category": "Governance & Control", "color": "#b7a6ff", "purpose": "Internal, compliance, statutory and operations audit management.", "problem": "Structured planning, evidence, observations, ownership, closure and management visibility.", "capabilities": ["Internal Audit", "Compliance Audit", "Statutory Audit", "Operations Audit", "Findings & action tracking", "Audit reporting"], "users": ["Auditor", "Audit Manager", "Business Owner", "Approver", "Leadership"], "integrations": ["Source / core systems", "Document repository", "Reporting layer"], "workflow": ["Audit plan", "Scope & evidence", "Observation", "Action owner", "Closure", "Management view"], "reports": ["Audit status", "Open findings", "Closure ageing", "Management report"], "pm": ["Discovery & requirement elicitation", "Workflow and role design", "BRD / FRD / FSD", "Acceptance criteria", "Reporting requirements", "UAT & client demo"], "api": "/api/v1/audit/findings", "error": "Finding cannot be closed until mandatory evidence and owner response are captured.", "learning": "Control-heavy products require explicit ownership, evidence and exception paths—not only happy-path screens."}, {"id": "fam", "name": "FAM", "category": "Financial Control", "color": "#8bd8c5", "purpose": "Fixed Assets Management for physical assets across the institution.", "problem": "A structured asset register with lifecycle visibility, categorisation, assignment, tracking and depreciation.", "capabilities": ["Asset registration", "Asset categorisation", "Assignment / tracking", "Depreciation", "Asset history", "Operational reporting"], "users": ["Asset Manager", "Branch / Operations", "Finance", "Approver", "Auditor"], "integrations": ["Finance / accounting data", "GST-related information", "Document repository"], "workflow": ["Register asset", "Classify", "Assign", "Track", "Depreciate", "Report"], "reports": ["Asset register", "Depreciation", "Asset movement", "Category-wise inventory