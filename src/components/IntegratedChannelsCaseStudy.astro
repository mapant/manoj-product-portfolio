  <script is:inline define:vars={{ appData: APPS }}>
    const APPS = appData;
    const esc = value => String(value).replace(/[&<>"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[char]));
    const backdrop = document.getElementById('backdrop');
    const closeButton = document.getElementById('close');
    const search = document.getElementById('search');
    const filters = [...document.querySelectorAll('#ics-filters .filter')];
    let activeFilter = 'All';

    function showApp(id, push = true) {
      const app = APPS.find(item => item.id === id);
      if (!app) return;
      document.getElementById('dbadge').textContent = app.name.slice(0, 1);
      document.getElementById('dname').textContent = app.name;
      document.getElementById('dcat').textContent = `${app.category} · Integrated Channels Suite`;
      const list = items => items.map(item => `<li>${esc(item)}</li>`).join('');
      const reports = app.reports.map((name, index) => `<tr><td>${esc(name)}</td><td>${esc(['Operational monitoring','Management visibility','Exception management','Control / compliance'][index % 4])}</td><td>${index % 2 ? 'On demand' : 'Cycle / daily'}</td></tr>`).join('');
      const api = esc(JSON.stringify({reference_id:'IC-DEMO-001',application:app.name,source_system:'BANK-SOURCE',idempotency_key:'synthetic-key',metadata:{channel:'operations',suite:'integrated-channels'}},null,2));
      document.getElementById('dbody').innerHTML = `
        <div class="ics-modal-two-col">
          <article class="ics-modal-card"><span class="ics-overline">Product brief</span><h3>${esc(app.purpose)}</h3><p><b>Problem:</b> ${esc(app.problem)}</p><div class="ics-modal-subsection"><h4>Core capabilities</h4><ul>${list(app.capabilities)}</ul></div></article>
          <article class="ics-modal-card"><span class="ics-overline">Users &amp; ecosystem</span><div class="ics-modal-subsection"><h4>Primary users</h4><ul>${list(app.users)}</ul></div><div class="ics-modal-subsection"><h4>Integration landscape</h4><ul>${list(app.integrations)}</ul></div></article>
        </div>
        <section class="ics-modal-card ics-modal-section"><div class="ics-modal-section-head"><h3>End-to-end workflow</h3><span>Conceptual product journey</span></div><ol class="ics-modal-flow">${app.workflow.map((step,index)=>`<li><b>${String(index+1).padStart(2,'0')} · ${esc(step)}</b><span>State · owner · validation · next action</span></li>`).join('')}</ol></section>
        <section class="ics-modal-card ics-modal-section"><div class="ics-modal-section-head"><h3>Sample reporting view</h3><span>Synthetic · no client data</span></div><div class="ics-modal-report"><b>${esc(app.name)} Operations Dashboard</b><table><thead><tr><th>Report / widget</th><th>Product purpose</th><th>Cadence</th></tr></thead><tbody>${reports}</tbody></table></div></section>
        <div class="ics-modal-two-col"><article class="ics-modal-card"><div class="ics-modal-section-head"><h3>API / integration thinking</h3><span>Conceptual contract</span></div><pre><b>POST</b> ${esc(app.api)}\n\n${api}</pre><div class="ics-modal-error"><b>Representative guardrail / exception</b><p>${esc(app.error)}</p></div></article><article class="ics-modal-card"><span class="ics-overline">Product management contribution</span><ul>${list(app.pm)}</ul><div class="ics-modal-subsection"><span class="ics-overline">Product learning</span><p>${esc(app.learning)}</p></div></article></div>
        <section class="ics-modal-card ics-modal-section"><span class="ics-overline">Portfolio artefacts represented</span><ul class="ics-artifact-list">${list(['Problem statement / use cases','Workflow & role model','BRD / FRD / FSD','Figma / product screens','DFD / ER / architecture','API specification','Acceptance criteria / UAT','User manual / training'])}</ul></section>`;
      backdrop.classList.add('is-open');
      backdrop.setAttribute('aria-hidden','false');
      document.body.classList.add('ics-modal-open');
      if (push) history.replaceState({app:id}, '', `${location.pathname}#app/${id}`);
    }

    function closeApp(push = true) {
      backdrop.classList.remove('is-open');
      backdrop.setAttribute('aria-hidden','true');
      document.body.classList.remove('ics-modal-open');
      if (push && location.hash.startsWith('#app/')) history.replaceState({}, '', `${location.pathname}#portfolio`);
    }

    function matchesFilter(app) {
      if (activeFilter === 'All') return true;
      if (activeFilter === 'Lending') return app.category.includes('Lending');
      if (activeFilter === 'Governance') return app.category.includes('Governance');
      return app.category === activeFilter;
    }

    function applyFilters() {
      const query = (search?.value || '').toLowerCase().trim();
      let visible = 0;
      document.querySelectorAll('.ics-app-card').forEach(card => {
        const app = APPS.find(item => item.id === card.dataset.open);
        const show = app && matchesFilter(app) && (!query || card.dataset.search.toLowerCase().includes(query));
        card.hidden = !show;
        if (show) visible++;
      });
      document.getElementById('empty').hidden = visible > 0;
    }

    document.querySelectorAll('[data-open]').forEach(node => node.addEventListener('click', event => { event.preventDefault(); showApp(node.dataset.open); }));
    search?.addEventListener('input', applyFilters);
    filters.forEach(button => button.addEventListener('click', () => {
      filters.forEach(item => item.classList.remove('active'));
      button.classList.add('active');
      activeFilter = button.dataset.filter;
      applyFilters();
    }));
    closeButton?.addEventListener('click', () => closeApp());
    backdrop?.addEventListener('click', event => { if (event.target === backdrop) closeApp(); });
    document.addEventListener('keydown', event => { if (event.key === 'Escape') closeApp(); });
    if (location.hash.startsWith('#app/')) showApp(location.hash.slice(5), false);
  </script>
</ProjectShell>
