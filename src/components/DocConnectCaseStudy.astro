---
import ProjectShell from './ProjectShell.astro';
import AyuHealthBrand from './AyuHealthBrand.astro';
import DocConnectIcon from './DocConnectIcon.astro';
import DocConnectLandscape from './DocConnectLandscape.astro';
import '../styles/docconnect-case-study.scss';
import '../styles/docconnect-overview-prototype.scss';
import '../styles/docconnect-reference-layout.scss';

const navSections: [string, string][] = [
  ['overview', 'Overview'], ['ecosystem', 'Ecosystem'], ['challenge', 'Challenge'],
  ['strategy', 'Strategy'], ['pm-scope', 'PM Scope'], ['product-metrics', 'Product Metrics'],
  ['portfolio', 'Portfolio'], ['tech-data', 'Tech & Data'], ['outcomes', 'Outcomes'],
  ['product-leadership', 'Product Leadership'],
];
const pages = [
  { id: 'overview', cls: 'dc-overview', ratio: '1.95', number: '01', caption: 'A CONNECTED ECOSYSTEM FOR DOCTORS, PATIENTS AND HEALTHCARE SERVICES' },
  { id: 'ecosystem', cls: 'dc-ecosystem', ratio: '1.95', number: '02', caption: 'DOCTORS · PATIENTS · HOSPITALS · SERVICES' },
  { id: 'challenge', cls: 'dc-challenge', ratio: '1.95', number: '03', caption: 'OFFLINE DEPENDENCE · LIMITED VISIBILITY · FRAGMENTED EXPERIENCE' },
  { id: 'strategy', cls: 'dc-strategy', ratio: '1.95', number: '04', caption: 'REFER → TRACK → ENGAGE → GROW' },
  { id: 'pm-scope', cls: 'dc-scope', ratio: '1.9296', number: '05', caption: 'STRATEGY · DISCOVERY · DELIVERY · ADOPTION · MEASUREMENT' },
  { id: 'product-metrics', cls: 'dc-metrics', ratio: '1.9498', number: '06', caption: 'ACQUISITION · ACTIVATION · ENGAGEMENT · JOURNEY VISIBILITY' },
  { id: 'portfolio', cls: 'dc-portfolio', ratio: '1.943', number: '07', caption: 'REFERRALS · JOURNEY TRACKING · ENGAGEMENT · SERVICES' },
  { id: 'tech-data', cls: 'dc-tech', ratio: '1.9498', number: '08', caption: 'MODULAR APPS · INTEGRATIONS · DATA · OPERATIONAL VISIBILITY' },
  { id: 'outcomes', cls: 'dc-outcomes', ratio: '1.9397', number: '09', caption: 'DOCTOR ADOPTION · REFERRAL GROWTH · JOURNEY VISIBILITY' },
  { id: 'product-leadership', cls: 'dc-leadership', ratio: '1.942', number: '10', caption: 'HEALTHTECH PRODUCTS · PARTNERSHIPS · SHARED IMPACT' },
];
const ecosystemNodes = [
  { tone: 'blue', icon: 'doctor', title: 'Referral Doctors', bullets: ['Patient referrals', 'Patient tracking', 'Doctor referrals', 'Incentives & earnings', 'Access healthcare services'], position: 'dc-node-1' },
  { tone: 'green', icon: 'people', title: 'Patients', bullets: ['OPD consultations', 'IPD admissions', 'Discharge journey', 'Ambulance services', 'Care journey updates'], position: 'dc-node-2' },
  { tone: 'amber', icon: 'people', title: 'BDMs / Sales', bullets: ['Digital leads from doctors', 'Doctor relationships', 'Follow-up and support', 'Engagement with doctors'], position: 'dc-node-3' },
  { tone: 'pink', icon: 'hospital', title: 'Ayu Hospitals / Operations', bullets: ['Patient handling', 'Hospital coordination', 'OPD / IPD updates', 'Discharge information', 'Patient journey tracking'], position: 'dc-node-4' },
  { tone: 'violet', icon: 'bars', title: 'Growth / Product', bullets: ['Referral acquisition', 'Engagement & notifications', 'Doctor-to-doctor network', 'Incentive programs', 'Funnel analytics (referrals, OPD, IPD)'], position: 'dc-node-5' },
  { tone: 'sky', icon: 'link', title: 'External Services', bullets: ['WhatsApp (notifications)', 'Google Business (practice profile)', 'Ambulance partners', 'Other healthcare services'], position: 'dc-node-6' },
];
const ecosystemOutcomes = [
  ['blue', 'Stronger doctor engagement', 'Digital tools and continuous value beyond onboarding.'],
  ['violet', 'Transparent patient journeys', 'Real-time visibility from referral to discharge.'],
  ['green', 'Network-driven growth', 'Doctor-to-doctor referrals and measurable funnel.'],
  ['amber', 'Integrated services', 'Access to ambulance, Google Business and healthcare services.'],
];
const challenges = [
  { tone: 'blue', icon: 'doctor', number: '01', title: 'Offline dependence', description: 'Doctor relationships relied heavily on BDM-led and offline interactions, with limited digital touchpoints.', bullets: ['Manual coordination', 'Phone / WhatsApp communication', 'Lack of self-serve digital platform'] },
  { tone: 'green', icon: 'eye', number: '02', title: 'Patient journey opacity', description: 'Referring doctors lacked a single place to understand what happened after a patient referral.', bullets: ['No real-time patient status', 'Limited updates on OPD / IPD', 'Unclear discharge and follow-up'] },
  { tone: 'pink', icon: 'chat', number: '03', title: 'Limited digital engagement', description: 'There were limited recurring reasons for doctors to return to the platform and remain active.', bullets: ['Few ongoing engagement triggers', 'Limited visibility into outcomes', 'No integrated services or incentives'] },
  { tone: 'amber', icon: 'network', number: '04', title: 'Network growth dependency', description: 'Doctor acquisition relied heavily on direct BDM relationships instead of network-led, doctor-to-doctor growth.', bullets: ['Dependent on field teams', 'Limited organic doctor referrals', 'Slower and less scalable growth'] },
];
const fragmentation = [
  ['Delayed patient updates', 'Referring doctors had to follow up manually for patient status.'],
  ['Lower repeat engagement', 'Limited reasons for doctors to return to the platform after initial use.'],
  ['Slower network growth', 'Doctor acquisition remained dependent on direct BDM relationships.'],
  ['Underutilised potential', 'Strong doctor relationships did not fully translate into measurable patient and business outcomes.'],
];
const strategyCards = [
  { tone: 'blue', icon: 'referral', title: 'Digitise the referral journey', description: 'Allow doctors to create patient leads digitally and follow their progress.', bullets: ['Simple, digital patient referral flow', 'Easy tracking of referred patients', 'Seamless doctor app experience'] },
  { tone: 'green', icon: 'eye', title: 'Create continuous visibility', description: 'Expose patient progression through referral, OPD, IPD and discharge stages.', bullets: ['Real-time patient journey updates', 'OPD / IPD / discharge status', 'Clear and transparent tracking'] },
  { tone: 'violet', icon: 'heart', title: 'Build engagement loops', description: 'Use notifications, incentives, patient updates and healthcare services to create repeat value.', bullets: ['Notifications and WhatsApp updates', 'Incentives and earnings for referrals', 'Practice services and healthcare utilities'] },
  { tone: 'amber', icon: 'network', title: 'Turn the network into a growth channel', description: 'Enable doctor-to-doctor referrals with measurable acquisition and business outcomes.', bullets: ['Doctor-to-doctor referral capability', 'Incentive programs for network growth', 'Measure referral-led acquisition and impact'] },
];
const phases = [
  { tone: 'blue', icon: 'target', title: 'Product Strategy', description: 'Defined product vision, target users, use cases and roadmap aligned with Ayu Health\u2019s business objectives.', bullets: ['Product vision & positioning', 'Target user personas', 'Use case definition', 'Product roadmap', 'Success metrics'] },
  { tone: 'green', icon: 'people', title: 'Requirement Gathering', description: 'Engaged with doctors, BDMs, hospital teams and other stakeholders to capture needs and prioritise requirements.', bullets: ['Stakeholder interviews', 'User requirements', 'Requirement prioritisation', 'Feature backlog', 'Process mapping (As-Is & To-Be)'] },
  { tone: 'violet', icon: 'document', title: 'Product Design & Documentation', description: 'Created PRD, BRD, FRD, user flows, wireframes and process flows to translate requirements into a clear product backlog.', bullets: ['PRD / BRD / FRD', 'User flows & journey maps', 'Wireframes (Figma)', 'Process flows (DFD)', 'UI/UX input & design reviews', 'UAT scenarios'] },
  { tone: 'pink', icon: 'gear', title: 'Development & Execution', description: 'Worked with engineering teams using Agile sprints to build, test and deploy the product in phases across web and mobile platforms.', bullets: ['Sprint planning & backlog grooming', 'Feature development', 'Testing & UAT support', 'Release planning & deployment', 'Issue tracking (JIRA)'] },
  { tone: 'amber', icon: 'rocket', title: 'GTM & Adoption', description: 'Planned pilot launch, enabled doctor onboarding and drove awareness and adoption through training, incentives and feedback loops.', bullets: ['Pilot plan & rollout', 'Doctor onboarding and training', 'Incentive programs', 'Communication assets', 'Adoption tracking and feedback'] },
  { tone: 'sky', icon: 'bars', title: 'Monitoring & Continuous Improvement', description: 'Tracked usage, referrals and engagement, analysed feedback and iterated on the product to improve outcomes and plan for scale.', bullets: ['Usage & referral analytics', 'Feedback analysis', 'Feature enhancements', 'Performance tracking', 'Continuous improvement roadmap'] },
];
const metricCategories = [
  ['blue', 'person', 'Acquisition', 'Doctors reached and app installs across channels.'],
  ['green', 'document', 'Activation', 'Signup, onboarding, first successful referral.'],
  ['violet', 'people', 'Engagement', 'Active usage, repeat visits, notifications interaction.'],
  ['amber', 'referral', 'Referral Conversion', 'Doctors creating referrals and onboarding via network flow.'],
  ['sky', 'eye', 'Journey Visibility', 'Referral to OPD / IPD / discharge tracking availability.'],
  ['pink', 'ambulance', 'Service Adoption', 'Usage of incentives, Google Business, ambulance and related tools.'],
];
const metricTakeaways = [
  ['Acquisition Health', 'Helps evaluate channel effectiveness and optimize doctor outreach.'],
  ['Engagement Quality', 'Informs features, notifications and workflow improvements.'],
  ['Referral Efficiency', 'Highlights funnel drop-offs and guides conversion improvements.'],
  ['Visibility Coverage', 'Ensures better journey transparency across the care continuum.'],
  ['Ecosystem Learning', 'Product and operational insights guide roadmap and partnerships.'],
];
const funnel = [
  ['blue', 'person', 'Reached Doctors'], ['green', 'document', 'Installed App'], ['violet', 'document', 'Registered / Logged In'], ['amber', 'people', 'Completed Onboarding'], ['pink', 'referral', 'Created First Referral'],
];
const signals = [
  ['bars', 'Active doctors trend', 'Increasing over time'], ['people', 'Repeat usage', 'Recurring monthly and weekly activity'],
  ['bell', 'Notification engagement', 'Drives return visits'], ['referral', 'Referral follow-up behavior', 'Sustained usage after first referral'],
  ['clock', 'Retention health', 'Monitored through repeat journey tracking and return actions'],
];
const workflowFeatures = [
  ['blue', 'person', 'Reached Doctors'], ['green', 'document', 'Installed Tracking'], ['violet', 'doctor', 'Doctor Referrals'],
  ['amber', 'spark', 'Incentives & Earnings'], ['sky', 'google', 'Google Business'], ['pink', 'ambulance', 'Ambulance Booking'],
];
const operationalMetrics = [
  ['clock', 'Journey update timeliness'], ['eye', 'Referral-to-status visibility'], ['chat', 'Support responsiveness'],
  ['star', 'Doctor satisfaction signals'], ['database', 'Data completeness / tracking coverage'], ['gear', 'Operational coordination quality'],
];
const modules = [
  ['blue', 'referral', 'Patient Referrals', 'Create, track and manage patient referrals'],
  ['green', 'eye', 'Patient Tracking', 'Follow patient journey across OPD, IPD and discharge'],
  ['violet', 'spark', 'Incentives & Earnings', 'Track incentives, earnings and referral performance'],
  ['amber', 'doctor', 'Doctor Network', 'Discover and collaborate with other doctors'],
  ['pink', 'ambulance', 'Ambulance Services', 'Book ambulance for patients directly from the app'],
  ['sky', 'google', 'Google Business', 'Manage practice profile and digital presence'],
];
const uxHighlights = [
  ['01', 'Mobile-first design', 'Optimised for on-the-go access with a clean and modern interface'],
  ['02', 'Quick actions', 'Refer patients, view updates and track earnings in a few taps'],
  ['03', 'Personalised dashboard', 'Relevant information and insights for each doctor'],
  ['04', 'Real-time notifications', 'Patient updates, referral status and incentives'],
];
const journeySteps = [
  ['blue', '01', 'Refer Patient', 'Create and share patient referrals'], ['green', '02', 'Track Journey', 'Follow status across OPD, IPD and discharge'],
  ['violet', '03', 'Earn Incentives', 'Get rewarded for successful referrals'], ['amber', '04', 'Grow Network', 'Connect with other doctors and collaborate'],
  ['pink', '05', 'Access Services', 'Book ambulance and other healthcare services'],
];
const integrations = [
  ['blue', 'google', 'Google Business', 'Manage practice profile, visibility and reviews.'],
  ['pink', 'ambulance', 'Ambulance Booking', 'Integrate and support patient ambulance requests.'],
  ['sky', 'chat', 'Communication Services', 'Notifications, WhatsApp and in-app alerts for doctors and patients.'],
  ['amber', 'spark', 'Incentives & Earnings', 'Track referral rewards and earnings visibility for doctors.'],
  ['violet', 'bars', 'Analytics & Reporting', 'Adoption, referral and journey dashboards.'],
  ['green', 'shield', 'Security & Governance', 'Access control, permissions and audit visibility.'],
];
const techStack = [
  ['database', 'PostgreSQL', 'Relational database'], ['spark', 'Python', 'Scripting & automation'],
  ['bars', 'Big Data', 'Data processing & analytics'], ['bars', 'Google Analytics', 'Web & user analytics'],
  ['target', 'Looker Studio', 'Dashboards & reporting'], ['document', 'SQL Reporting', 'Reporting & query analysis'],
  ['link', 'REST APIs', 'Integration & services'], ['gear', 'JIRA', 'Project & sprint management'],
  ['spark', 'Figma', 'UI/UX design & prototyping'], ['network', 'GitHub', 'Source control & collaboration'],
];
const outcomeMetrics = [
  ['blue', 'doctor', '1,150+', 'Doctors installed / logged in'],
  ['green', 'people', '400+', 'Monthly active users (MAU)'],
  ['violet', 'bars', '170+', 'Weekly active users (WAU)'],
  ['pink', 'referral', '27+', 'Doctor referrals in pilot'],
  ['amber', 'doctor', '7', 'Newly onboarded doctors through referral flow'],
];
const adoption = [['120+', 'Pilot Start', '15%'], ['280+', 'Month 1', '30%'], ['520+', 'Month 2', '48%'], ['780+', 'Month 3', '67%'], ['980+', 'Month 4', '82%'], ['1,150+', 'Month 5', '96%']];
const ecosystemValue = [
  ['doctor', 'Doctors', 'Higher engagement, visibility and earnings opportunities'], ['people', 'Patients', 'Better coordinated care and improved patient experience'],
  ['bars', 'BDMs / Sales', 'Stronger doctor relationships and network growth'], ['hospital', 'Ayu Hospitals / Operations', 'Improved referral inflow and operational visibility'],
  ['bulb', 'Growth / Product', 'Validated product model with clear path to scale'],
];
const leadershipCards = [
  { tone: 'blue', icon: 'rocket', title: 'Build Similar Platforms', description: 'Discuss ideas or requirements for doctor engagement, referral platforms or patient journey solutions.', bullets: ['Product discovery & vision', 'Use case definition', 'Solution design and roadmap'] },
  { tone: 'green', icon: 'bars', title: 'Healthcare Product Consulting', description: 'Support in product strategy, feature prioritisation and go-to-market for digital health products.', bullets: ['Product strategy & positioning', 'Feature and roadmap planning', 'Market and user insights'] },
  { tone: 'violet', icon: 'database', title: 'Data-Driven Healthcare Solutions', description: 'Leverage data and analytics to improve doctor and patient outcomes.', bullets: ['Data strategy and use cases', 'Metrics and outcome framework', 'Analytics-driven product decisions'] },
  { tone: 'amber', icon: 'handshake', title: 'Collaborations & Opportunities', description: 'Open to collaborations with healthcare organisations, startups and product teams.', bullets: ['Product partnerships', 'Advisory and consulting', 'Exploring new opportunities'] },
];
---

<ProjectShell
  title="Ayu DocConnect"
  previous={{ title: 'Integrated Channels Suite', href: '/projects/integrated-channels' }}
  next={{ title: 'Ayu Sales Intelligence & Field Force Optimization', href: '/projects/ayu-sales-intelligence' }}
  navSections={navSections}
  ctaText="View Projects"
  ctaHref="/#projects"
  showProjectFooter={false}
  viewportFitPrototype={true}
  profileImage="/profile/portrait.png"
>
  <main class="docconnect-case">
    <!-- 01 · Overview -->
    <section id="overview" class="case-page dc-overview" style={`--reference-ratio:${pages[0].ratio}`}>
      <div class="case-page-inner">
        <AyuHealthBrand className="dc-overview-brand" />
        <div class="dc-overview-main">
          <div class="dc-overview-copy">
            <h1><em>Ayu DocConnect</em><span>Turn doctor relationships</span><span>into a connected</span><span>digital care journey.</span></h1>
            <p class="case-lede">Ayu DocConnect is a doctor engagement, referral and patient journey platform that brings referral doctors, patient journeys and healthcare services into one connected digital experience, enabling stronger collaboration and better patient care.</p>
          </div>
          <div class="dc-hero-art">
            <img class="dc-doctor-portrait" src="/ayu-docconnect/doctor-portrait.png" alt="Doctor using the Ayu DocConnect workspace" />
            <svg class="dc-overview-connectors" viewBox="0 0 900 600" preserveAspectRatio="none" aria-hidden="true"><path d="M565 180 C670 160 695 130 785 105 M565 280 C680 280 695 285 785 295 M565 390 C665 410 700 440 785 470"/><circle cx="565" cy="180" r="5"/><circle cx="565" cy="280" r="5"/><circle cx="565" cy="390" r="5"/></svg>
            <div class="dc-device-card"><small><i class="dc-brand-plus"></i> Ayu DocConnect</small><strong>Doctor workspace</strong><div class="dc-device-actions"><span><DocConnectIcon name="referral" />Refer<br/>Patient</span><span><DocConnectIcon name="document" />Track<br/>Journey</span><span><DocConnectIcon name="people" />Engage</span></div><div class="dc-care-line"><i></i><i></i><i></i><i></i></div><b>Referral <i>&rarr;</i> OPD <i>&rarr;</i> IPD <i>&rarr;</i> Discharge</b></div>
            <div class="dc-hero-tag dc-tag-hospital"><DocConnectIcon name="hospital"/><span><b>Ayu Hospitals</b><small>Better collaboration<br/>across the network</small></span></div>
            <div class="dc-hero-tag dc-tag-patient"><DocConnectIcon name="people"/><span><b>Patients</b><small>Improved care continuity</small></span></div>
            <div class="dc-hero-tag dc-tag-doctor"><DocConnectIcon name="doctor"/><span><b>Referral Doctors</b><small>Stronger relationships</small></span></div>
          </div>
        </div>
        <div class="dc-value-row">
          <article class="dc-value-card tone-blue"><span class="dc-symbol"><DocConnectIcon name="referral" /></span><div><h2>Refer Digitally</h2><p>Enable referral doctors to refer patients easily and keep them within the Ayu Health network.</p></div></article>
          <article class="dc-value-card tone-green"><span class="dc-symbol"><DocConnectIcon name="document" /></span><div><h2>Track Patient Journeys</h2><p>Provide real-time visibility across the patient journey from referral to discharge.</p></div></article>
          <article class="dc-value-card tone-amber"><span class="dc-symbol"><DocConnectIcon name="people" /></span><div><h2>Stay Engaged with Ayu</h2><p>Deliver relevant information, updates and opportunities to strengthen long-term relationships with doctors.</p></div></article>
          <div class="dc-overview-caption">A connected ecosystem for doctors, patients and healthcare services.</div>
        </div>
      </div>
    </section>

    <!-- 02 · Product ecosystem -->
    <section id="ecosystem" class="case-page dc-ecosystem" style={`--reference-ratio:${pages[1].ratio}`}>
      <div class="case-page-inner">
        <article class="dc-dark-story dc-eco-story">
          <div class="case-kicker"><i></i> Product Ecosystem</div>
          <h2>A connected ecosystem enabling <em>doctor engagement, patient care journeys and network growth.</em></h2>
          <p>Ayu DocConnect brings together referral doctors, patients, hospitals, sales teams and external services into a single digital ecosystem — connecting referrals, care journeys, engagement, incentives and growth across the Ayu Health network.</p>
          <ul class="dc-check-list"><li>End-to-end doctor and patient journey connectivity</li><li>Digital referrals and real-time journey visibility</li><li>Engagement, incentives and network-driven growth</li><li>Integration with healthcare services and external platforms</li></ul>
          <div class="dc-eco-loop"><small>DOCTOR ECOSYSTEM</small><div><span><b>01</b>Engage<br/>doctors</span><i></i><span><b>02</b>Enable<br/>patient care</span><i></i><span><b>03</b>Grow<br/>network</span></div></div>
        </article>
        <div class="dc-ecosystem-content">
          <div class="dc-network-map">
            <svg viewBox="0 0 1000 600" preserveAspectRatio="none" aria-hidden="true"><path d="M200 75 L500 300 L800 75 M200 300 L500 300 L800 300 M200 525 L500 300 L800 525"/><circle cx="500" cy="300" r="8"/></svg>
            {ecosystemNodes.map(node => <article class:list={['dc-network-node', `tone-${node.tone}`, node.position]}><span class="dc-node-icon"><DocConnectIcon name={node.icon} /></span><div><h3>{node.title}</h3><ul>{node.bullets.map(bullet => <li>{bullet}</li>)}</ul></div></article>)}
            <div class="dc-network-hub"><span><DocConnectIcon name="doctor" /></span><strong>Ayu<br/>DocConnect</strong><small>Doctor Engagement &amp;<br/>Referral Platform</small></div>
          </div>
          <div class="dc-outcome-strip"><small>KEY ECOSYSTEM OUTCOMES</small><div>{ecosystemOutcomes.map(([tone, title, text]) => <article class={`tone-${tone}`}><b>{title}</b><span>{text}</span></article>)}</div></div>
        </div>
      </div>
    </section>

    <!-- 03 · The challenge -->
    <section id="challenge" class="case-page dc-challenge" style={`--reference-ratio:${pages[2].ratio}`}>
      <div class="case-page-inner">
        <article class="dc-dark-story dc-challenge-story">
          <div class="case-kicker"><i></i> The Challenge</div>
          <h2>Doctor relationships existed, but the <em>journey was fragmented.</em></h2>
          <p>Ayu Health had strong relationships with referral doctors, but the engagement, referral and patient journey were largely offline and fragmented across people, systems and touchpoints. Referring doctors lacked a single digital platform to refer patients, track progress and stay engaged with Ayu.</p>
          <ul class="dc-check-list"><li>Limited digital engagement and visibility for doctors</li><li>Fragmented patient journey across multiple touchpoints</li><li>Heavy dependence on BDM-led, offline interactions</li><li>Network growth reliant on direct relationships</li></ul>
          <div class="dc-fragmented-flow"><small>FROM FRAGMENTED INTERACTIONS …</small><div><span>Offline<br/>interactions</span><i></i><span>Multiple<br/>touchpoints</span><i></i><span>Limited<br/>visibility</span><i></i><span>Slower network<br/>growth</span></div></div>
        </article>
        <div class="dc-challenge-main">
          <div class="dc-challenge-cards">{challenges.map(item => <article class={`dc-challenge-card tone-${item.tone}`}><span class="dc-challenge-icon"><DocConnectIcon name={item.icon} /></span><span class="dc-challenge-number">{item.number}</span><small class="dc-challenge-label">THE FRICTION</small><h3>{item.title}</h3><p>{item.description}</p><ul>{item.bullets.map(bullet => <li>{bullet}</li>)}</ul></article>)}</div>
          <div class="dc-challenge-photo"><img class="dc-challenge-doctor" src="/ayu-docconnect/doctor-portrait-challenge.png" alt="Doctor viewing a patient's referral journey"/><b class="dc-photo-title">DOCTOR<br/>ENGAGEMENT</b><b class="dc-photo-callout dc-photo-referred">Patient referred</b><b class="dc-photo-callout dc-photo-track">Track journey</b><b class="dc-photo-callout dc-photo-updates">OPD / IPD updates</b><b class="dc-photo-callout dc-photo-incentives">Earn incentives</b></div>
          <div class="dc-impact-row"><small>IMPACT OF FRAGMENTATION</small><div>{fragmentation.map(([title, text]) => <article><b>{title}</b><span>{text}</span></article>)}</div></div>
        </div>
      </div>
    </section>

    <!-- 04 · Product strategy -->
    <section id="strategy" class="case-page dc-strategy" style={`--reference-ratio:${pages[3].ratio}`}>
      <div class="case-page-inner">
        <article class="dc-dark-story dc-strategy-story">
          <div class="case-kicker"><i></i> Product Strategy</div>
          <h2>Turn referral activity into an <em>engagement and growth loop.</em></h2>
          <p>A focused product strategy to digitise referrals, create continuous visibility, build engagement and scale through the doctor network.</p>
          <ul class="dc-check-list"><li>Digitise the end-to-end referral journey</li><li>Create continuous visibility into patient progression</li><li>Build engagement loops with incentives and services</li><li>Enable doctor-to-doctor referrals for network growth</li></ul>
          <div class="dc-strategy-outcomes"><small>STRATEGY OUTCOMES</small><div><span>More Doctor<br/>Referrals</span><span>Higher<br/>Engagement</span><span>Stronger<br/>Network</span><span>Measurable<br/>Impact</span></div></div>
        </article>
        <div class="dc-strategy-main">
          <div class="dc-strategy-cards">{strategyCards.map((item, index) => <article class={`tone-${item.tone}`}><div class="dc-strategy-card-head"><span class="dc-card-icon"><DocConnectIcon name={item.icon} /></span><div><span class="dc-card-num">0{index + 1}</span><b>{item.title}</b></div></div><p>{item.description}</p><ul>{item.bullets.map(bullet => <li>{bullet}</li>)}</ul></article>)}</div>
          <div class="dc-strategy-orbit"><div class="dc-orbit-center"><DocConnectIcon name="doctor"/><strong>AYU<br/>DOCCONNECT</strong><small>REFERRAL &amp;<br/>ENGAGEMENT LOOP</small></div><i class="orbit-dot dot-one"><DocConnectIcon name="referral"/></i><i class="orbit-dot dot-two"><DocConnectIcon name="eye"/></i><i class="orbit-dot dot-three"><DocConnectIcon name="heart"/></i><i class="orbit-dot dot-four"><DocConnectIcon name="network"/></i><i class="dc-orbit-arrow arrow-one">›</i><i class="dc-orbit-arrow arrow-two">›</i><i class="dc-orbit-arrow arrow-three">›</i><i class="dc-orbit-arrow arrow-four">›</i></div>
          <div class="dc-priorities"><small>KEY STRATEGIC PRIORITIES</small><div><span>Seamless doctor experience</span><span>Real-time journey visibility</span><span>Repeat engagement</span><span>Network-led growth</span><span>Measurable business outcomes</span></div></div>
        </div>
      </div>
    </section>

    <!-- 05 · Product management scope -->
    <section id="pm-scope" class="case-page dc-scope" style={`--reference-ratio:${pages[4].ratio}`}>
      <div class="case-page-inner">
        <article class="dc-dark-story dc-scope-story">
          <div class="case-kicker"><i></i> Product Management Scope</div>
          <h2>Drive end-to-end product execution to create <em>real impact.</em></h2>
          <p>I drove the end-to-end product scope across discovery, definition, design, delivery, adoption and measurement to build Ayu DocConnect—a doctor engagement, referral and patient journey platform that strengthened doctor relationships, improved patient visibility and created measurable value across the Ayu Health ecosystem.</p>
          <ul class="dc-check-list"><li>Aligned product vision with business goals</li><li>Worked closely with doctors, hospitals, operations and growth teams</li><li>Delivered a usable, scalable and measurable product</li><li>Drove adoption and continuous improvement</li></ul>
        </article>
        <div class="dc-scope-main">
          <div class="dc-phase-track">{phases.map((phase, index) => <span class={`tone-${phase.tone}`}><b>0{index + 1}</b>{index < 5 && <i>⟶</i>}</span>)}</div>
