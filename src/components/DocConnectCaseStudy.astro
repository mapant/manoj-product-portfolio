  ['blue', 'Stronger doctor engagement', 'Digital tools and continuous value beyond onboarding'],
  ['violet', 'Transparent patient journeys', 'Real-time visibility from referral to discharge'],
  ['green', 'Network-driven growth', 'Doctor-to-doctor referrals and measurable funnel'],
  ['amber', 'Integrated services', 'Access to ambulance, Google Business and healthcare services'],
];
const challenges = [
  { tone: 'blue', icon: 'doctor', number: '01', title: 'Offline dependence', description: 'Doctor relationships relied heavily on BDM-led and offline interactions, with limited digital touchpoints.', bullets: ['Manual coordination', 'Phone / WhatsApp communication', 'Lack of self-serve digital platform'] },
  { tone: 'green', icon: 'eye', number: '02', title: 'Patient journey opacity', description: 'Referring doctors lacked a single place to understand what happened after a patient referral.', bullets: ['No real-time patient status', 'Limited updates on OPD / IPD', 'Unclear discharge and follow-up'] },
  { tone: 'pink', icon: 'message', number: '03', title: 'Limited digital engagement', description: 'There were limited recurring reasons for doctors to return to the platform and remain active.', bullets: ['Few ongoing engagement triggers', 'Limited visibility into outcomes', 'No integrated services or incentives'] },
  { tone: 'amber', icon: 'network', number: '04', title: 'Network growth dependency', description: 'Doctor acquisition relied heavily on direct BDM relationships instead of network-led, doctor-to-doctor growth.', bullets: ['Dependent on field teams', 'Limited organic doctor referrals', 'Slower and less scalable growth'] },
];
const fragmentation = [
  ['Delayed patient updates', 'Referring doctors had to follow up manually for patient status.'],
  ['Lower repeat engagement', 'Limited reasons for doctors to return to the platform after initial use.'],
  ['Slower network growth', 'Doctor acquisition remained dependent on direct BDM relationships.'],
  ['Underutilised potential', 'Strong doctor relationships did not fully translate into measurable patient and business outcomes.'],
];
const strategyCards = [
  { tone: 'blue', icon: 'referral', title: 'Digitise the referral journey', description: 'Allow doctors to create patient leads digitally and follow their progress.', bullets: ['Simple, digital patient referral flow', 'Easy tracking of referred patients', 'Seamless doctor app experience'] },
  { tone: 'green', icon: 'eye', title: 'Create continuous visibility', description: 'Expose patient progression through referral, OPD, IPD and discharge stages.', bullets: ['Real-time patient journey updates', 'OPD / IPD / discharge status', 'Clear and transparent tracking'] },
  { tone: 'violet', icon: 'gift', title: 'Build engagement loops', description: 'Use notifications, incentives, patient updates and healthcare services to create repeat value.', bullets: ['Notifications and WhatsApp updates', 'Incentives and earnings for referrals', 'Practice services and healthcare utilities'] },
  { tone: 'amber', icon: 'network', title: 'Turn the network into a growth channel', description: 'Enable doctor-to-doctor referrals with measurable acquisition and business outcomes.', bullets: ['Doctor-to-doctor referral capability', 'Incentive programs for network growth', 'Measure referral-led acquisition and impact'] },
];
const phases = [
  { tone: 'blue', icon: 'target', title: 'Product Strategy', description: 'Defined product vision, target users, use cases and roadmap aligned with Ayu Health\u2019s business objectives.', bullets: ['Product vision & positioning', 'Target user personas', 'Use case definition', 'Product roadmap', 'Success metrics'] },
  { tone: 'green', icon: 'people', title: 'Requirement Gathering', description: 'Engaged with doctors, BDMs, hospital teams and other stakeholders to capture needs and prioritise requirements.', bullets: ['Stakeholder interviews', 'User requirements', 'Requirement prioritisation', 'Feature backlog', 'Process mapping (As-Is & To-Be)'] },
  { tone: 'violet', icon: 'document', title: 'Product Design & Documentation', description: 'Created PRD, BRD, FRD, user flows, wireframes and process flows to translate requirements into a clear product backlog.', bullets: ['PRD / BRD / FRD', 'User flows & journey maps', 'Wireframes (Figma)', 'Process flows (DFD)', 'UI/UX input & design reviews', 'UAT scenarios'] },
  { tone: 'pink', icon: 'code', title: 'Development & Execution', description: 'Worked with engineering teams using Agile sprints to build, test and deploy the product in phases across web and mobile platforms.', bullets: ['Sprint planning & backlog grooming', 'Feature development', 'Testing & UAT support', 'Release planning & deployment', 'Issue tracking (JIRA)'] },
  { tone: 'amber', icon: 'rocket', title: 'GTM & Adoption', description: 'Planned pilot launch, enabled doctor onboarding and drove awareness and adoption through training, incentives and feedback loops.', bullets: ['Pilot plan & rollout', 'Doctor onboarding and training', 'Incentive programs', 'Communication assets', 'Adoption tracking and feedback'] },
  { tone: 'sky', icon: 'bars', title: 'Monitoring & Continuous Improvement', description: 'Tracked usage, referrals and engagement, analysed feedback and iterated on the product to improve outcomes and plan for scale.', bullets: ['Usage & referral analytics', 'Feedback analysis', 'Feature enhancements', 'Performance tracking', 'Continuous improvement roadmap'] },
];
const phaseTypography = [
  { heading: ['Product', 'Strategy'], emphasis: 'Defined product vision' },
  { heading: ['Requirement', 'Gathering'], emphasis: 'Engaged with doctors' },
  { heading: ['Product Design', '& Documentation'], emphasis: 'Created PRD, BRD, FRD' },
  { heading: ['Development', '& Execution'], emphasis: 'Worked with engineering teams' },
  { heading: ['GTM &', 'Adoption'], emphasis: 'Planned pilot launch' },
  { heading: ['Monitoring &', 'Continuous', 'Improvement'], emphasis: 'Tracked usage, referrals and engagement' },
];
const coreSignals = [
  { tone:'blue', icon:'person-add', title:['Doctor','Activation'], lines:['Doctors creating a','first referral ÷','doctors onboarded'] },
  { tone:'green', icon:'bars', title:['Active Doctor','Usage'], lines:['Weekly / monthly','doctors using referral','or tracking workflows'] },
  { tone:'violet', icon:'repeat', title:['Repeat Referral','Rate'], lines:['Doctors referring','again ÷ referring','doctors'] },
  { tone:'pink', icon:'share', title:['Referral','Conversion'], lines:['Referral → OPD and','OPD → IPD','progression'] },
  { tone:'amber', icon:'eye', title:['Journey','Visibility'], lines:['Referred patients with','an updated journey','status'] },
  { tone:'pink', icon:'rupee-circle', title:['Payout','Turnaround'], lines:['Time from payout','initiation to','completion'] },
];
const handoffMeasures = [
  { tone:'blue', iconTone:'pink', icon:'bars', title:'Conversion', lines:['Stage-to-stage progression','and drop-offs'] },
  { tone:'sky', iconTone:'blue', icon:'clock', title:'Timeliness', lines:['Time between stages','and status updates'] },
  { tone:'violet', iconTone:'violet', icon:'document', title:'Completeness', lines:['Patient tracking through','discharge and follow-up'] },
];
const doctorLifecycle = [
  ['blue','person-add','Onboarding','Completion and time to first referral'],
  ['green','people','Engagement','Repeat visits, referrals and notification interaction'],
  ['violet','repeat','Retention','Returning doctors, inactivity and cohort behaviour'],
];
const measurementWorkflows = [
  { tone:'blue', icon:'document', title:'Patient Referrals & Tracking', measure:['Referral creation and patient-','status tracking usage'], informs:['Improve the core referral','workflow'] },
  { tone:'green', icon:'rupee', title:'Incentives & Earnings', measure:['Earnings-view usage and','payout turnaround'], informs:['Improve payout clarity','and responsiveness'] },
  { tone:'violet', icon:'cube', title:'Extended Services', measure:['Google Business and','ambulance-service usage'], informs:['Prioritise services','doctors use'] },
  { tone:'pink', icon:'headset', title:'Support & Reliability', measure:['Support resolution time','and referral errors'], informs:['Resolve recurring','service friction'] },
];
const modules = [
  ['blue', 'document', 'Patient Referrals', 'Create, track and manage patient referrals'],
  ['green', 'activity', 'Patient Tracking', 'Follow patient journey across OPD, IPD and discharge'],
  ['violet', 'rupee', 'Incentives & Earnings', 'Track incentives, earnings and referral performance'],
  ['amber', 'person-add', 'Doctor Network', 'Discover and collaborate with other doctors'],
  ['pink', 'ambulance', 'Ambulance Services', 'Book ambulance for patients directly from the app'],
  ['sky', 'google', 'Google Business', 'Manage practice profile and digital presence'],
];
const uxHighlights = [
  ['blue', 'mobile', 'Mobile-first design', 'Optimised for on-the-go access with a clean and modern interface'],
  ['green', 'lightning', 'Quick actions', 'Refer patients, view updates and track earnings in a few taps'],
  ['green', 'shield', 'Personalised dashboard', 'Relevant information and insights for each doctor'],
  ['pink', 'bell', 'Real-time notifications', 'Patient updates, referral status and incentives'],
];
const journeySteps = [
  ['blue', 'person-add', 'Refer Patient', 'Create and share patient referrals'], ['green', 'document', 'Track Journey', 'Follow status across OPD, IPD and discharge'],
  ['violet', 'rupee', 'Earn Incentives', 'Get rewarded for successful referrals'], ['amber', 'person-add', 'Grow Network', 'Connect with other doctors and collaborate'],
  ['pink', 'ambulance', 'Access Services', 'Book ambulance and other healthcare services'],
];
const integrations = [
  ['blue', 'maps', 'Google Business', 'Manage practice profile, visibility and reviews'],
  ['pink', 'ambulance', 'Ambulance Booking', 'Integrate and support patient ambulance requests'],
  ['sky', 'chat', 'Communication Services', 'Notifications, WhatsApp and in-app alerts for doctors and patients'],
  ['amber', 'rupee', 'Incentives & Earnings', 'Track referral rewards and earnings visibility for doctors'],
  ['blue', 'bars', 'Analytics & Reporting', 'Adoption, referral and journey dashboards'],
  ['violet', 'shield', 'Security & Governance', 'Access control, permissions and audit visibility'],
];
const techStack = [
  ['postgresql', 'PostgreSQL', 'Relational database'], ['python', 'Python', 'Scripting & automation'],
  ['database', 'Big Data', 'Data processing & analytics'], ['analytics', 'Google Analytics', 'Web & user analytics'],
  ['looker', 'Looker Studio', 'Dashboards & reporting'], ['database', 'SQL Reporting', 'Reporting & query analysis'],
  ['gear', 'REST APIs', 'Integration & services'], ['jira', 'JIRA', 'Project & sprint management'],
  ['figma', 'Figma', 'UI/UX design & prototyping'], ['github', 'GitHub', 'Source control & collaboration'],
];
const outcomeMetrics = [
  ['blue', 'stethoscope', '1,150+', 'Doctors installed / logged in'],
  ['green', 'people', '400+', 'Monthly active users (MAU)'],
  ['violet', 'bars', '170+', 'Weekly active users (WAU)'],
  ['pink', 'send', '27+', 'Doctor referrals in pilot'],
  ['amber', 'person-add', '7', 'Newly onboarded doctors through referral flow'],
];
const adoption = [['120+', 'Pilot Start', '15%'], ['280+', 'Month 1', '30%'], ['520+', 'Month 2', '48%'], ['780+', 'Month 3', '67%'], ['980+', 'Month 4', '82%'], ['1,150+', 'Month 5', '96%']];
const ecosystemValue = [
  ['doctor', 'Doctors', 'Higher engagement, visibility and earnings opportunities'], ['people', 'Patients', 'Better coordinated care and improved patient experience'],
  ['bars', 'BDMs / Sales', 'Stronger doctor relationships and network growth'], ['hospital', 'Ayu Hospitals / Operations', 'Improved referral inflow and operational visibility'],
  ['bulb', 'Growth / Product', 'Validated product model with clear path to scale'],
];
const leadershipCards = [
  { tone: 'blue', icon: 'rocket', title: 'Build Similar Platforms', description: 'Discuss ideas or requirements for doctor engagement, referral platforms or patient journey solutions.', bullets: ['Product discovery & vision', 'Use case definition', 'Solution design and roadmap'] },
  { tone: 'green', icon: 'bars', title: 'Healthcare Product Consulting', description: 'Support in product strategy, feature prioritisation and go-to-market for digital health products.', bullets: ['Product strategy & positioning', 'Feature and roadmap planning', 'Market and user insights'] },
  { tone: 'violet', icon: 'database', title: 'Data-Driven Healthcare Solutions', description: 'Leverage data and analytics to improve doctor and patient outcomes.', bullets: ['Data strategy and use cases', 'Metrics and outcome framework', 'Analytics-driven product decisions'] },
  { tone: 'amber', icon: 'handshake', title: 'Collaborations & Opportunities', description: 'Open to collaborations with healthcare organisations, startups and product teams.', bullets: ['Product partnerships', 'Advisory and consulting', 'Exploring new opportunities'] },
