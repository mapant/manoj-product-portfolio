    : name === 'file-gear' ? <><g fill="currentColor" stroke="none">{solid.file.map(d=><path d={d} fill-rule="evenodd"/>)}</g><circle cx="18" cy="18" r="6" fill="var(--pale,#d7faed)" stroke="none"/><path d="M17 13h2l.4 1.5 1.4.8 1.5-.2.8 1.8-1.1 1.1v1.6l1.1 1.1-.8 1.8-1.5-.2-1.4.8L19 24h-2l-.4-1.5-1.4-.8-1.5.2-.8-1.8 1.1-1.1v-1.6L12.9 16.3l.8-1.8 1.5.2 1.4-.8Z" transform="translate(0 -1.5)" fill="currentColor" stroke="none"/><circle cx="18" cy="17" r="2.2" fill="var(--pale,#d7faed)" stroke="none"/></>
    : name === 'problem-pin' ? <><path d="M12 23C10 20 4 13 4 8a8 8 0 1 1 16 0c0 5-6 12-8 15Z" fill="currentColor" stroke="none"/><path d="M9 6a3 3 0 1 1 4 3c-1 .4-1 1-1 2" stroke="var(--pale,#e3f2ff)"/><circle cx="12" cy="14" r="1" fill="var(--pale,#e3f2ff)" stroke="none"/></>
