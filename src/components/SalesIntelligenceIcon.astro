<svg class:list={['asi-icon', className]} data-asi-icon={name} viewBox={name === 'gear' ? '-2 -1 28 28' : '0 0 24 24'} fill={filled ? 'currentColor' : 'none'} stroke={filled ? 'none' : 'currentColor'} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
