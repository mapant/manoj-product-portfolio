    : name === 'route' ? <><path d="M17 3H9a4 4 0 0 0 0 8h5a4 4 0 0 1 0 8H4" stroke-dasharray="2.5 2.5"/><path d="M18 12s-5-5-5-8a5 5 0 1 1 10 0c0 3-5 8-5 8Z" fill="currentColor" stroke="none"/><circle cx="18" cy="4" r="1.8" fill="white" stroke="none"/></>
