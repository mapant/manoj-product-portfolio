---
import ProjectCaseStudyShell from './ProjectCaseStudyShell.astro';
import '../styles/case-study-system.scss';

interface Metric { value: string; label: string; tone?: string }
interface Persona { role: string; need: string; control: string }
interface Card { title: string; text: string; bullets?: string[]; tone?: string }
interface Layer { title: string; items: string[] }
interface FlowStep { title: string; text: string; tone?: string }
interface Artifact { type: string; title: string; text: string; code?: string }
interface Data {
  index: string; title: string; company: string; brand: string; eyebrow: string; lead: string;
  theme: string; metrics: Metric[]; personas: Persona[]; friction: string[];
  strategy: Card[]; architecture: Layer[]; integrations: string[]; dataFlow: string[];
  workflow: FlowStep[]; exceptions: Card[]; artifacts: Artifact[]; rollout: Card[];
  outcomes: Metric[]; lessons: string[]; roadmap: Card[]; capabilities: string[];
}

const { data } = Astro.props as { data: Data };
---

<ProjectCaseStudyShell title={`${data.title} | Manoj Pant`} navItems={[
  { href: '#context', label: 'Context' },
  { href: '#strategy', label: 'Strategy' },
  { href: '#architecture', label: 'Architecture' },
  { href: '#workflow', label: 'Workflow' },
  { href: '#artifacts', label: 'Artifacts' },
  { href: '#rollout', label: 'Rollout' },
  { href: '#outcomes', label: 'Outcomes' },
  { href: '#roadmap', label: 'Roadmap' },
]}>
  <div class="case-v2" data-theme={data.theme}>
    <div class="case-v2-progress"></div>
    <section class="cv2-hero" id="context">
      <div class="cv2-wrap">
        <div class="cv2-hero-grid">
          <div>
            <div class="cv2-brandline"><span class="cv2-brand">{data.brand}</span><span>{data.eyebrow}</span></div>
            <div class="cv2-index">{data.index}</div>
            <h1>{data.title}</h1>
            <p class="cv2-lead">{data.lead}</p>
            <div class="cv2-actions"><a class="cv2-btn primary" href="#strategy">Explore product thinking ↓</a><button class="cv2-btn" onclick="window.print()">Download / Print PDF</button></div>
            <div class="cv2-capabilities">{data.capabilities.map((item) => <span>{item}</span>)}</div>
          </div>
          <aside class="cv2-hero-card">
            <span class="cv2-label">Executive snapshot</span>
            <h2>What I was solving</h2>
            <div class="cv2-friction">{data.friction.slice(0, 4).map((item, i) => <div><b>0{i + 1}</b><span>{item}</span></div>)}</div>
          </aside>
        </div>
        <div class="cv2-metrics">{data.metrics.map((metric) => <div class={`cv2-metric ${metric.tone || ''}`}><strong>{metric.value}</strong><span>{metric.label}</span></div>)}</div>
      </div>
    </section>

    <section class="cv2-section" id="personas">
      <div class="cv2-wrap">
        <div class="cv2-heading"><span>01 · Executive Context</span><h2>People, friction and the product boundary</h2><p>The case study starts with the operating reality: who uses the product, what blocks them and which constraints shape the solution.</p></div>
        <div class="cv2-two">
          <article class="cv2-panel cv2-friction-panel"><div class="cv2-panel-title">The friction</div>{data.friction.map((item) => <div class="cv2-friction-row"><i>×</i><span>{item}</span></div>)}</article>
          <article class="cv2-panel"><div class="cv2-panel-title">Target personas</div><div class="cv2-personas">{data.personas.map((p) => <div><b>{p.role}</b><span>{p.need}</span><small>{p.control}</small></div>)}</div></article>
        </div>
      </div>
    </section>

    <section class="cv2-section alt" id="strategy">
      <div class="cv2-wrap">
        <div class="cv2-heading"><span>02 · Strategic Scope & Prioritization</span><h2>Decisions before delivery</h2><p>Product strategy is visible through sequencing, trade-offs, controls and the deliberate shape of the MVP.</p></div>
        <div class="cv2-strategy-grid">{data.strategy.map((card, i) => <article class={`cv2-card tone-${i % 4}`}><div class="cv2-card-no">0{i + 1}</div><h3>{card.title}</h3><p>{card.text}</p>{card.bullets && <ul>{card.bullets.map((b) => <li>{b}</li>)}</ul>}</article>)}</div>
        <div class="cv2-priority"><div><span>Prioritisation lens</span><b>Impact × risk × dependency × adoption</b></div><div class="cv2-priority-bar"><i style="width:88%">Core journey</i><i style="width:68%">Controls</i><i style="width:54%">Automation</i><i style="width:38%">Optimisation</i></div></div>
      </div>
    </section>

    <section class="cv2-section" id="architecture">
      <div class="cv2-wrap">
        <div class="cv2-heading"><span>03 · Architecture & Network</span><h2>How the product sits inside the ecosystem</h2><p>Architecture is shown as a product boundary: experience, orchestration, business services, data and external systems.</p></div>
        <div class="cv2-architecture">
          {data.architecture.map((layer, i) => <div class="cv2-layer"><div class="cv2-layer-title"><b>0{i + 1}</b>{layer.title}</div><div class="cv2-layer-items">{layer.items.map((item) => <span>{item}</span>)}</div></div>)}
        </div>
        <div class="cv2-network"><div class="cv2-network-core"><span>PRODUCT</span><b>{data.title}</b><small>Workflow · rules · controls · auditability</small></div>{data.integrations.map((item, i) => <div class={`cv2-node n${i + 1}`}><b>{item}</b><small>Integration boundary</small></div>)}</div>
        <div class="cv2-dataflow"><div class="cv2-panel-title">Data flow</div><div class="cv2-flowline">{data.dataFlow.map((step, i) => <div><b>{String(i + 1).padStart(2, '0')}</b><span>{step}</span>{i < data.dataFlow.length - 1 && <em>→</em>}</div>)}</div></div>
      </div>
    </section>

    <section class="cv2-section alt" id="workflow">
      <div class="cv2-wrap">
        <div class="cv2-heading"><span>04 · User Workflows & State Machines</span><h2>From happy path to controlled exception</h2><p>The workflow makes roles, states, decisions and failure handling explicit rather than hiding them in prose.</p></div>
        <div class="cv2-state-machine">{data.workflow.map((step, i) => <div class="cv2-state"><div class="cv2-state-node">{String(i + 1).padStart(2, '0')}</div><b>{step.title}</b><span>{step.text}</span>{i < data.workflow.length - 1 && <i>→</i>}</div>)}</div>
        <div class="cv2-two cv2-exceptions"><article class="cv2-panel"><div class="cv2-panel-title">Exception matrix</div>{data.exceptions.map((item, i) => <div class="cv2-exception"><span>{String(i + 1).padStart(2, '0')}</span><div><b>{item.title}</b><p>{item.text}</p></div></div>)}</article><article class="cv2-panel cv2-rbac"><div class="cv2-panel-title">Control model</div><div class="cv2-rbac-stack"><div><b>Maker</b><span>Create / submit</span></div><div><b>Checker</b><span>Validate / approve</span></div><div><b>System</b><span>Execute / reconcile</span></div><div><b>Audit</b><span>Evidence / traceability</span></div></div></article></div>
      </div>
    </section>

    <section class="cv2-section" id="artifacts">
      <div class="cv2-wrap">
        <div class="cv2-heading"><span>05 · Product Artifacts & UI Execution</span><h2>Evidence of product craft</h2><p>Portfolio-safe reconstructions turn requirements into visible product artefacts: screens, API contracts, rules and operational views.</p></div>
        <div class="cv2-artifacts">{data.artifacts.map((a, i) => <article class="cv2-artifact"><div class="cv2-artifact-top"><span>{a.type}</span><b>0{i + 1}</b></div><h3>{a.title}</h3><p>{a.text}</p>{a.code && <pre>{a.code}</pre>}<div class="cv2-wire"><div></div><div></div><div></div><div></div><div></div></div></article>)}</div>
      </div>
    </section>

    <section class="cv2-section alt" id="rollout">
      <div class="cv2-wrap">
        <div class="cv2-heading"><span>06 · Go-To-Market & Operational Rollout</span><h2>Shipping is not the finish line</h2><p>The product moves through migration, validation, enablement and phased adoption before it becomes operationally useful.</p></div>
        <div class="cv2-rollout">{data.rollout.map((card, i) => <article><div class="cv2-rollout-no">0{i + 1}</div><h3>{card.title}</h3><p>{card.text}</p>{card.bullets && <ul>{card.bullets.map((b) => <li>{b}</li>)}</ul>}</article>)}</div>
      </div>
    </section>

    <section class="cv2-section" id="outcomes">
      <div class="cv2-wrap">
        <div class="cv2-heading"><span>07 · Product Metrics & Business Outcomes</span><h2>What changed because the product existed</h2><p>Metrics are presented as decision signals: operational impact, business impact and product/system performance.</p></div>
        <div class="cv2-outcomes">{data.outcomes.map((metric, i) => <div class={`cv2-outcome o${i % 4}`}><strong>{metric.value}</strong><span>{metric.label}</span><div class="cv2-spark"><i></i><i></i><i></i><i></i><i></i></div></div>)}</div>
      </div>
    </section>

    <section class="cv2-section alt" id="roadmap">
      <div class="cv2-wrap">
        <div class="cv2-heading"><span>08 · Retrospective & Future Roadmap</span><h2>What I learned and what I would build next</h2><p>A strong product case study ends with judgement: lessons from delivery and the next product hypothesis.</p></div>
        <div class="cv2-two"><article class="cv2-panel"><div class="cv2-panel-title">Lessons learned</div>{data.lessons.map((lesson, i) => <div class="cv2-lesson"><b>0{i + 1}</b><p>{lesson}</p></div>)}</article><article class="cv2-panel"><div class="cv2-panel-title">Next iteration</div>{data.roadmap.map((item, i) => <div class="cv2-roadmap"><span>0{i + 1}</span><div><b>{item.title}</b><p>{item.text}</p></div></div>)}</article></div>
        <div class="cv2-footer-card"><div><span>Product leadership lens</span><h3>Turn ambiguity into a system people can execute.</h3><p>Strategy → requirements → architecture → workflow → delivery → adoption → measurable outcomes.</p></div><a href="/#portfolio">Back to Product Portfolio ↗</a></div>
      </div>
    </section>
  </div>
</ProjectCaseStudyShell>
