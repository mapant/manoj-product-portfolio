---
import ProjectShell from './ProjectShell.astro';
import SalesIntelligencePresentation from './SalesIntelligencePresentation.astro';
import '../styles/page-view.scss';
import '../styles/ayu-sales-intelligence-case-study.scss';
const navSections: [string, string][] = [
  ['overview', 'Overview'], ['ecosystem', 'Ecosystem'], ['challenge', 'Challenge'],
  ['strategy', 'Strategy'], ['pm-scope', 'PM Scope'], ['product-metrics', 'Product Metrics'],
  ['portfolio', 'Portfolio'], ['tech-data', 'Tech & Data'], ['outcomes', 'Outcomes'],
  ['product-leadership', 'Product Leadership'],
];
---
<ProjectShell title="Ayu Sales Intelligence & Field Force Optimization"
  previous={{ title: 'Ayu DocConnect', href: '/projects/ayu-docconnect' }}
  next={{ title: 'Telecom Analytics & Cost Optimization', href: '/projects/telecom-cost-optimization' }}
  navSections={navSections} ctaText="View Projects" ctaHref="/#portfolio" showProjectFooter={false}>
  <main class="case-study ayu-sales-case"><SalesIntelligencePresentation /></main>
</ProjectShell>
