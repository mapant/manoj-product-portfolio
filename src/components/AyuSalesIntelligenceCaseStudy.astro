---
import ProjectShell from './ProjectShell.astro';
import '../styles/ayu-sales-intelligence-case-study.scss';
---

<ProjectShell title="Ayu Sales Intelligence & Field Force Optimization" previous={{title:'Ayu DocConnect',href:'/projects/ayu-docconnect'}} next={{title:'Telecom Analytics & Cost Optimization',href:'/projects/telecom-cost-optimization'}}>
  <main class="case-study ayu-sales-case">
    <section class="case-page asi-overview" id="overview"><div class="case-page-inner">
      <div class="case-kicker"><i></i>01 / OVERVIEW <span>AYU HEALTH · SALES INTELLIGENCE</span></div>
      <div class="asi-overview-grid"><div><h1>Turn field sales activity into data-driven territory execution.</h1><p class="case-lede">A sales-intelligence platform helping BDMs discover high-potential doctors, prioritise territories, optimise daily visit plans and convert field activity into measurable doctor-network growth.</p><div class="asi-journey"><b>DISCOVER</b><i>→</i><b>PRIORITISE</b><i>→</i><b>PLAN</b><i>→</i><b>VISIT</b><i>→</i><b>CONVERT</b></div></div><aside class="asi-map"><small>ILLUSTRATIVE BEAT PLAN</small><div class="asi-map-lines"></div><b class="asi-bdm">BDM</b><span class="asi-doc d1">DOCTOR A</span><span class="asi-doc d2">DOCTOR B</span><span class="asi-doc d3">DOCTOR C</span></aside></div>
      <div class="asi-pilot-label">MANUAL PILOT · 2 BDMs · BANGALORE</div><div class="asi-metrics"><article><strong>+60%</strong><span>Unique doctor visits · BDM 1</span></article><article><strong>+166%</strong><span>Unique doctor visits · BDM 2</span></article><article><strong>−18%</strong><span>Distance travelled per visit · BDM 1</span></article><article><strong>−15%</strong><span>Distance travelled per visit · BDM 2</span></article></div>
      <div class="case-page-foot"><span>01</span><i></i><b>DISCOVER · PRIORITISE · PLAN · VISIT · CONVERT</b></div>
    </div></section>

    <section class="case-page asi-ecosystem" id="ecosystem"><div class="case-page-inner">
      <header class="case-heading"><div><div class="case-kicker"><i></i>02 / ECOSYSTEM</div><h2>Convert distributed field and network signals into useful recommendations.</h2></div></header>
      <div class="asi-ecosystem-grid"><article><b>INPUTS</b><p>Doctor / non-doctor prospects · Google / location data · historical referrals · leads · IPDs · GMV · visit history · pincodes · BDM assignments</p></article><article class="asi-ecosystem-hub"><b>AYU SALES<br/>INTELLIGENCE</b><span>Data-informed decision system</span></article><article><b>USERS</b><p>BDMs / Sales Agents · Sales Managers · Sales Admins · Product / Business · Analytics</p></article><article class="asi-outputs"><b>OUTPUTS</b><p>Prospect recommendations · Beat Plan · nearby prioritisation · territory planning · manager visibility · conversion analytics</p></article></div>
      <div class="case-page-foot"><span>02</span><i></i><b>FIELD SIGNALS → DECISIONS → EXECUTION → LEARNING</b></div>
    </div></section>

    <section class="case-page asi-challenge" id="challenge"><div class="case-page-inner">
      <header class="case-heading"><div><div class="case-kicker"><i></i>03 / CHALLENGE</div><h2>More doctor onboarding did not automatically create a productive referral network.</h2></div><p>Supplied project context: approximately 14,420 doctors onboarded; approximately 85% had not shared patient leads.</p></header>
      <div class="asi-challenge-grid"><article><b>01 · ACQUISITION</b><h3>Relationship-led acquisition</h3><p>Doctor discovery depended heavily on BDM networks and manual sourcing.</p></article><article><b>02 · ACTIVATION</b><h3>Low-value onboarding</h3><p>Large doctor volumes did not necessarily translate into active patient referrals.</p></article><article><b>03 · EXECUTION</b><h3>Unstructured field visits</h3><p>BDMs lacked a consistent daily visit plan.</p></article><article><b>04 · TERRITORY</b><h3>Territory inefficiency</h3><p>Travel across wider areas increased distance and weakened field productivity.</p></article></div>
      <div class="case-page-foot"><span>03</span><i></i><b>NETWORK QUALITY · VISIT STRUCTURE · TERRITORY PRODUCTIVITY</b></div>
    </div></section>

    <section class="case-page asi-strategy" id="strategy"><div class="case-page-inner">
      <header class="case-heading"><div><div class="case-kicker"><i></i>04 / STRATEGY</div><h2>Move from relationship-led selling to data-driven field execution.</h2></div></header>
      <div class="asi-strategy-flow"><article><span>01</span><b>DISCOVER</b><h3>Structure the prospect network</h3><p>Create a Prospect entity and expand the addressable doctor network.</p></article><article><span>02</span><b>SCORE</b><h3>Combine relevant signals</h3><p>Use fitment, location, historical activity and business-potential signals.</p></article><article><span>03</span><b>PRIORITISE</b><h3>Recommend who and when</h3><p>Focus BDM effort on the most relevant next doctor visit.</p></article><article><span>04</span><b>OPTIMISE</b><h3>Learn from field outcomes</h3><p>Cluster activity geographically and improve recommendations over time.</p></article></div>
      <div class="case-page-foot"><span>04</span><i></i><b>DISCOVER · SCORE · PRIORITISE · OPTIMISE</b></div>
    </div></section>

    <section class="case-page asi-scope" id="pm-scope"><div class="case-page-inner">
      <header class="case-heading"><div><div class="case-kicker"><i></i>05 / PM SCOPE</div><h2>Frame product work across prospect data, decisioning and field use.</h2></div><p>Project documentation lists Manoj in Business Analytics reviewer participation.</p></header>
      <div class="asi-scope-grid"><article><b>01 · PROSPECT MODEL</b><h3>Define usable prospect data</h3><p>Prospect entity · lifecycle states · conversion · data requirements</p></article><article><b>02 · DECISION LOGIC</b><h3>Make prioritisation useful</h3><p>Fitment scoring · thresholds · visit frequency · prioritisation</p></article><article><b>03 · FIELD EXPERIENCE</b><h3>Support daily execution</h3><p>My Prospects · Beat Plan · map · directions · reschedule · record visit</p></article><article><b>04 · MEASUREMENT</b><h3>Connect activity to outcomes</h3><p>Visit compliance · unique doctors · travel distance · conversion · leads · IPD · territory productivity</p></article></div>
      <div class="case-page-foot"><span>05</span><i></i><b>BUSINESS ANALYTICS REVIEW · CROSS-FUNCTIONAL PRODUCT WORK</b></div>
    </div></section>

    <section class="case-page asi-architecture" id="architecture"><div class="case-page-inner">
      <header class="case-heading"><div><div class="case-kicker"><i></i>06 / ARCHITECTURE</div><h2>A conceptual intelligence layer for territory planning and field execution.</h2></div><p>Product concept only; no specific implementation stack is implied.</p></header>
      <div class="asi-architecture-flow"><article><b>INPUT DATA</b><span>Prospects · doctor performance · lead / IPD history · GMV · visits · pincodes · location · Google Places data</span></article><i>↓</i><article><b>DATA / DECISION LAYER</b><span>Prospect scoring · visit-frequency rules · priority logic · geo clustering · territory mapping</span></article><i>↓</i><article><b>RECOMMENDATION LAYER</b><span>My Prospects · Beat Plan · Must Visit · Nearby Suggestions</span></article><i>↓</i><article><b>FIELD EXECUTION</b><span>Call · directions · record visit · reschedule · onboard</span></article><i>↓</i><article><b>MEASUREMENT</b><span>Visit compliance · conversion · lead generation · IPD · travel efficiency</span></article></div>
      <div class="case-page-foot"><span>06</span><i></i><b>CONCEPTUAL SALES INTELLIGENCE ARCHITECTURE</b></div>
    </div></section>

    <section class="case-page asi-delivery" id="delivery"><div class="case-page-inner">
      <header class="case-heading"><div><div class="case-kicker"><i></i>07 / DELIVERY</div><h2>Validate the field model in a bounded pilot before scaling.</h2></div></header>
      <div class="asi-delivery-grid"><article><b>01</b><h3>Problem discovery</h3><p>Identify field-sales inefficiency and doctor-network productivity gaps.</p></article><article><b>02</b><h3>Manual pilot</h3><p>Test with two Bangalore BDMs.</p></article><article><b>03</b><h3>Validate outcome</h3><p>Measure visit increase and travel-distance reduction.</p></article><article><b>04</b><h3>Productise algorithm</h3><p>Translate pilot learning into Beat Plan logic and recommendation rules.</p></article><article><b>05</b><h3>Controlled rollout</h3><p>Launch Bangalore first.</p></article><article><b>06</b><h3>Scale</h3><p>Expand to additional cities after impact and issue assessment.</p></article></div>
      <div class="case-page-foot"><span>07</span><i></i><b>DISCOVER · PILOT · VALIDATE · PRODUCTISE · ROLL OUT · SCALE</b></div>
    </div></section>

    <section class="case-page asi-explorer" id="product-explorer"><div class="case-page-inner">
      <header class="case-heading"><div><div class="case-kicker"><i></i>08 / PRODUCT EXPLORER</div><h2>A daily field workspace that turns priorities into visits.</h2></div><p>Illustrative product reconstruction; no new mapping library or technology stack.</p></header>
      <div class="asi-product-ui"><aside><small>AYU SALES INTELLIGENCE</small><b>Field workspace</b><span>My Visit Plan</span><span>My Prospects</span><span>Map View</span><span>Must Visit</span><span>Manager Tracking</span></aside><div class="asi-workspace"><div class="asi-workspace-head"><div><small>TODAY · BANGALORE</small><h3>My Visit Plan</h3></div><b>4 PRIORITIES</b></div><div class="asi-route"><span>Current BDM</span><i>→</i><b>Doctor A</b><i>→</i><b>Doctor B</b><i>→</i><b>Doctor C</b></div><div class="asi-doctor-cards"><article><b>Doctor / Prospect</b><div><span>High IPD</span><span>Lead Active</span></div><small>Directions · Record visit · Reschedule</small></article><article><b>Doctor / Prospect</b><div><span>New Doctor</span><span>Reactivation</span></div><small>Directions · Record visit · Reschedule</small></article><article><b>Manager tracking</b><small>Visit plan · completion · field outcome</small></article></div></div></div>
      <div class="case-page-foot"><span>08</span><i></i><b>PLAN · PROSPECTS · MAP · VISIT · MANAGER TRACKING</b></div>
    </div></section>

    <section class="case-page asi-impact" id="impact"><div class="case-page-inner">
      <header class="case-heading"><div><div class="case-kicker"><i></i>09 / IMPACT</div><h2>Manual pilot results show visit gains alongside lower travel per visit.</h2></div></header>
      <div class="asi-pilot-label">MANUAL PILOT · BANGALORE · 2 BDMs</div><div class="asi-impact-grid"><article><strong>+60%</strong><span>Unique doctor visits · BDM 1</span></article><article><strong>+166%</strong><span>Unique doctor visits · BDM 2</span></article><article><strong>−18%</strong><span>Distance travelled per visit · BDM 1</span></article><article><strong>−15%</strong><span>Distance travelled per visit · BDM 2</span></article></div>
      <div class="asi-kpi-framework"><b>SCALE KPI FRAMEWORK</b><span>Unique doctors visited</span><span>Beat-plan compliance</span><span>Distance per visit</span><span>Prospect → doctor conversion</span><span>Leads per active doctor</span><span>IPD-generating doctors</span><span>Territory productivity</span></div>
      <div class="case-page-foot"><span>09</span><i></i><b>OBSERVED MANUAL PILOT · FUTURE SCALE KPI FRAMEWORK</b></div>
    </div></section>

    <section class="case-page asi-leadership" id="leadership"><div class="case-page-inner">
      <header class="case-heading"><div><div class="case-kicker"><i></i>10 / PRODUCT LEADERSHIP</div><h2>Improve the quality and explainability of field decisions.</h2></div></header>
      <div class="asi-leadership-grid"><article><b>01 · QUALITY OVER VOLUME</b><h3>Optimise quality, not just visit volume</h3><p>More visits help when higher-value doctors are prioritised.</p></article><article><b>02 · EXPLAINABILITY</b><h3>Make recommendation logic clear</h3><p>BDMs should understand why a doctor is recommended.</p></article><article><b>03 · HUMAN FLEXIBILITY</b><h3>Balance algorithm and field reality</h3><p>Availability, rescheduling and geography require controlled flexibility.</p></article><article class="asi-future"><b>04 · FUTURE OPPORTUNITIES</b><h3>Extend field intelligence</h3><p>Next-best doctor · dynamic territory balancing · lead / IPD propensity · route optimisation · BDM capacity prediction · AI-assisted planning</p><small>FUTURE OPPORTUNITIES</small></article></div>
      <div class="case-page-foot"><span>10</span><i></i><b>QUALITY · EXPLAINABILITY · FIELD REALITY · FUTURE INTELLIGENCE</b></div>
    </div></section>
  </main>
</ProjectShell>
