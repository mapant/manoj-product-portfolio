---
interface Props { name: string; }
const { name } = Astro.props;
const id = `asi-art-${name}`;
const paint = (tone: string) => `url(#${id}-${tone})`;
---
<svg class="asi-illustration" viewBox="0 0 320 140" role="img" aria-label={name.replaceAll('-', ' ')}>
  <defs>
    <linearGradient id={`${id}-paper`} x2="25%" y2="100%"><stop stop-color="#fff"/><stop offset=".65" stop-color="#fff"/><stop offset="1" stop-color="#edf6ff"/></linearGradient>
    <linearGradient id={`${id}-blue`} x2="70%" y2="100%"><stop stop-color="#54b9ff"/><stop offset=".45" stop-color="#078eff"/><stop offset="1" stop-color="#0060ef"/></linearGradient>
    <linearGradient id={`${id}-violet`} x2="80%" y2="100%"><stop stop-color="#c2a3ff"/><stop offset=".45" stop-color="#9351ff"/><stop offset="1" stop-color="#6623eb"/></linearGradient>
    <linearGradient id={`${id}-green`} x2="50%" y2="100%"><stop stop-color="#5ae9cb"/><stop offset=".45" stop-color="#04bfaa"/><stop offset="1" stop-color="#009f92"/></linearGradient>
    <linearGradient id={`${id}-orange`} x2="60%" y2="100%"><stop stop-color="#ffd067"/><stop offset=".45" stop-color="#ff9b13"/><stop offset="1" stop-color="#ff7400"/></linearGradient>
    <linearGradient id={`${id}-pink`} x2="75%" y2="100%"><stop stop-color="#ff89b7"/><stop offset=".45" stop-color="#ff2485"/><stop offset="1" stop-color="#db0764"/></linearGradient>
    <linearGradient id={`${id}-note`} x2="30%" y2="100%"><stop stop-color="#fff093"/><stop offset="1" stop-color="#ffd569"/></linearGradient>
    <linearGradient id={`${id}-sky`} x2="70%" y2="100%"><stop stop-color="#e0f4ff"/><stop offset="1" stop-color="#bde5ff"/></linearGradient>
    <linearGradient id={`${id}-ring`} x1="0" y1="0" x2="100%" y2="100%"><stop stop-color="#19bfff"/><stop offset=".55" stop-color="#1686ff"/><stop offset="1" stop-color="#a029ff"/></linearGradient>
    <filter id={`${id}-shadow`} x="-30%" y="-30%" width="160%" height="180%"><feDropShadow dx="0" dy="3" stdDeviation="2.5" flood-color="#26578a" flood-opacity=".2"/></filter>
    <filter id={`${id}-soft`}><feGaussianBlur stdDeviation="2"/></filter>
  </defs>
  {name === 'discovery' && <g filter={paint('shadow')}>
    {[[51,8,-1],[171,32,3],[23,70,-12],[134,79,2]].map(([x,y,a]) => <g transform={`translate(${x} ${y}) rotate(${a})`}>
      <rect width="104" height="57" rx="6" fill={paint('paper')} stroke="#83baff"/><rect x="1" y="1" width="102" height="3" rx="2" fill="white"/>
      <circle cx="22" cy="23" r="15" fill="#e0eeff"/><circle cx="22" cy="18" r="6" fill="#3b83d5"/><path d="M11 34q0-15 11-15t11 15" fill="#3b83d5"/>
      <path d="M45 16h28M45 27h40M45 38h21" stroke="#72a3db" stroke-width="4.5" stroke-linecap="round"/>
    </g>)}
    <g transform="translate(257 82) rotate(8)"><rect width="58" height="44" rx="4" fill={paint('note')} stroke="#f2c959"/><path d="M12 12h33M12 22h24M12 32h18" stroke="#efa939" stroke-width="4" stroke-linecap="round"/></g>
    <text x="135" y="72" fill="#ff396b" font-size="22" font-weight="800">?</text>
    <path d="m29 42 8 3m-6-13 6 5m180-21 8-8" stroke="#268bff" stroke-width="3" stroke-linecap="round"/><path d="m210 14 9-9" stroke="#ffb200" stroke-width="3" stroke-linecap="round"/>
  </g>}
  {name === 'intelligence' && <g>
    <rect x="78" y="14" width="178" height="108" rx="22" fill={paint('sky')}/>
    {[[92,26],[92,76]].map(([x,y])=><g transform={`translate(${x} ${y})`}>
      <rect width="87" height="37" rx="9" fill="#ffffff8c"/><rect x="10" y="6" width="24" height="26" rx="3" fill="#68adff" stroke="#fff"/>
      <path d="M15 12h14M15 17h14M15 22h10" stroke="white" stroke-width="2" stroke-linecap="round"/><path d="M44 12h25M44 23h18" stroke="#99caff" stroke-width="4" stroke-linecap="round"/>
    </g>)}
    <rect x="184" y="27" width="56" height="34" rx="8" fill="#ffffff78"/><path d="M196 39h27M196 49h18" stroke="#a3cdff" stroke-width="4" stroke-linecap="round"/>
    <g filter={paint('shadow')}><circle cx="184" cy="75" r="24" fill="#effaffaa" stroke="#005aff" stroke-width="8"/><path d="m202 94 23 23" stroke="#005aff" stroke-width="12" stroke-linecap="round"/><path d="M168 64q12-16 28-4" fill="none" stroke="white" stroke-width="3" opacity=".8"/></g>
  </g>}
  {name === 'planning' && <g filter={paint('shadow')}>
    <g transform="rotate(-4 162 70)"><rect x="103" y="18" width="130" height="113" rx="10" fill={paint('paper')} stroke="#bbe7eb"/><path d="M103 48V28q0-10 10-10h110q10 0 10 10v20Z" fill={paint('green')}/>
      {[123,164,205].map(x=><><circle cx={x} cy="27" r="4" fill="#087b86"/><path d={`M${x} 8v17`} stroke="#0e727e" stroke-width="5" stroke-linecap="round"/><path d={`M${x-1} 9v12`} stroke="#8ad9df" stroke-width="1.5" stroke-linecap="round"/></>)}
      {[0,1,2].map(row=>[0,1,2,3].map(col=><rect x={115+col*28} y={58+row*23} width="21" height="17" rx="2" fill={row===1&&col===1?'#d0e6f5':'#e5f0f8'}/>))}
    </g>
    {[[37,43,-10,'#ffe277','#df9a31'],[84,94,-10,'#eab3fc','#a83ad1'],[200,94,-10,'#ffdb77','#dd902b'],[258,60,9,'#9ad5ff','#3b9bea']].map(([x,y,a,c,s])=><g transform={`translate(${x} ${y}) rotate(${a})`}>
      <rect width="58" height="43" rx="4" fill={c} stroke="#ffffff70"/><circle cx="14" cy="14" r="4" fill={s}/><path d="M8 27q0-10 6-10t6 10" fill={s}/><path d="M26 12h22M26 21h15M10 33h26" stroke={s} stroke-width="3" stroke-linecap="round"/>
    </g>)}
    <path d="m27 99 14 1m-5 12 8-5m219-85 5-10m4 20 8-4" stroke="#ff3d66" stroke-width="3" stroke-linecap="round"/>
  </g>}
  {name === 'beat-plan' && <g>
    <rect x="83" y="16" width="119" height="116" rx="20" fill="#ead9ff" opacity=".55"/>
    <g filter={paint('shadow')}><rect x="99" y="34" width="87" height="88" rx="9" fill={paint('paper')} stroke="#d0a3ff"/><path d="M99 58V44q0-10 10-10h67q10 0 10 10v14Z" fill="#9619ff"/>
      <path d="M121 24v17m42-17v17" stroke="#6610d6" stroke-width="7" stroke-linecap="round"/>
      {[0,1].map(row=>[0,1,2].map(col=><circle cx={120+col*23} cy={75+row*22} r="6" fill={col===2?'#9d48f5':'#c99af8'}/>))}
    </g>
    <g stroke="#951bff" stroke-width="3" stroke-linecap="round" fill="none"><path d="M209 78h12q12 0 12-12V41q0-12 12-12h14M221 78h38M221 78q12 0 12 12v23q0 12 12 12h14"/></g><circle cx="210" cy="78" r="8" fill="#9319ff"/>
    {[17,63,109].map((y,i)=><g transform={`translate(267 ${y})`}><rect width="29" height="29" rx="6" fill={i===1?'#cfacfa':'#951aff'}/>{i===0?<><circle cx="14.5" cy="10" r="4" fill="white"/><path d="M8 22q0-10 6.5-10T21 22" fill="white"/></>:i===1?<path d="m15 6 8 9-8 8-8-8Z" fill="white"/>:<path d="M7 12h15v12H7Zm4-4h7v7h-7Z" fill="white"/>}</g>)}
  </g>}
  {name === 'travel' && <g>
    <path d="M38 95C55 43 119 52 121 89S48 130 40 107 90 14 130 33 120 110 158 109 229 59 204 48 150 65 177 89 238 84 237 117 278 140 291 109" fill="none" stroke="#0459d7" stroke-width="3.2" stroke-linecap="round" stroke-dasharray="56 5 9 5 16 5"/>
    {[[34,91,'#fa2e5c'],[124,21,'#fa2e5c'],[172,119,'#0086ff'],[218,65,'#ffb026'],[291,112,'#007dff'],[124,124,'#ffb323']].map(([x,y,t])=><g transform={`translate(${x} ${y})`}><path d="M0 13S-12-1-12-10a12 12 0 1 1 24 0C12-1 0 13 0 13Z" fill={t} stroke="#fff" stroke-width=".8"/><circle cy="-10" r="4.2" fill="white"/><path d="M-8-15q4-5 10-3" fill="none" stroke="white" opacity=".45" stroke-width="1.5"/></g>)}
    <g transform="translate(276 32)" filter={paint('shadow')}><circle r="29" fill="#ff7b94"/><circle r="25" fill="#fff" stroke="#fa315d" stroke-width="4"/><path d="M0-18v18l12 7" stroke="#1b4d92" stroke-width="2.4" stroke-linecap="round"/><path d="M0-23v4m23 4h-4M0 23v-4m-23-19h4" stroke="#658dc5" stroke-width="1.5"/><circle r="3" fill="#236bbb"/></g>
    <path d="m305 88 10-6m-9 19 10 1" stroke="#ff6451" stroke-width="3" stroke-linecap="round"/>
  </g>}
  {name === 'reassignment' && <g>
    <g filter={paint('shadow')}><path d="M35 58h37l8 10h82v57H35Z" fill="#b9a5f4"/>
      {[[44,38,-7],[69,26,-5],[142,28,7]].map(([x,y,a],i)=><g transform={`translate(${x} ${y}) rotate(${a})`}><rect width="77" height="68" rx="5" fill={paint('paper')} stroke="#c9cbe7"/><circle cx="18" cy="20" r="12" fill="#d6e5ff"/><circle cx="18" cy="16" r="5" fill="#5385d3"/><path d="M10 30q0-12 8-12t8 12" fill="#5385d3"/><path d="M38 16h27M38 27h20M12 43h48M12 53h39" stroke="#c6d8f1" stroke-width="4" stroke-linecap="round"/>{i===2&&<path d="M54 0v20h20" fill="#ffb81e"/>}</g>)}
      <path d="M36 80 54 69h107l-10 59H42Z" fill={paint('violet')}/><path d="M43 82h108" stroke="#e2ceff" stroke-width="2" opacity=".6"/>
      <path d="M234 65h27l7 10h30v51h-64Z" fill="#0066df"/><path d="M239 78h29l6-4h25l-5 52h-61Z" fill="#6cbaff"/><path d="M239 86h66l-8 44h-69Z" fill={paint('blue')}/>
      <g transform="translate(112 94) rotate(-3)"><rect width="91" height="45" rx="5" fill={paint('paper')} stroke="#b4caf4"/><circle cx="17" cy="14" r="5" fill="#3e8cea"/><path d="M10 27q0-11 7-11t7 11" fill="#3e8cea"/><path d="M34 13h39M34 24h28M10 35h64" stroke="#b7cdeb" stroke-width="3.7" stroke-linecap="round"/></g>
    </g>
    <path d="M134 29Q187-19 249 28" fill="none" stroke="#6923da" stroke-width="2.5" stroke-dasharray="7 4" stroke-linecap="round"/><path d="m239 23 13 9-3-16" fill="none" stroke="#6923da" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="m171 120 5 19 5-8 10 1Z" fill="#07084b" stroke="white" stroke-width="1"/><path d="m284 43 4-10m3 17 10-5" stroke="#ff3b6b" stroke-width="3" stroke-linecap="round"/>
  </g>}
  {name === 'visibility' && <g>
    <path d="M22 91h264" stroke="#ee3868" stroke-width="3" stroke-linecap="round"/><path d="M101 91h59" stroke="#006dff" stroke-width="3"/><path d="M176 91h110" stroke="#f8edf4" stroke-width="3" stroke-dasharray="9 6"/>
    {[[48,'#fa245b'],[155,'#087fff'],[221,'#c9c0c3'],[293,'#fa245b']].map(([x,c],i)=><g transform={`translate(${x} 77)`}><path d="M0 12S-13-5-13-17a13 13 0 0 1 26 0C13-5 0 12 0 12Z" fill={i===2?'#efe6eb':c} stroke={i===2?'#b7b0b2':'#fff'} stroke-width="1.5" stroke-dasharray={i===2?'4 3':undefined}/><circle cy="-17" r="5" fill="white"/><circle cy="14" r="4" fill={i===2?'#d2c9cb':c}/></g>)}
    <circle cx="98" cy="91" r="7" fill="#006dff"/><circle cx="98" cy="91" r="2.5" fill="white"/><path d="m257 83 14 16m0-16-14 16" stroke="#f6255b" stroke-width="4"/>
  </g>}
  {name === 'verification' && <g>
    <g filter={paint('shadow')} transform="rotate(-5 87 74)"><path d="M39 17h91q7 0 7 7v96l-17 16H39q-7 0-7-7V24q0-7 7-7Z" fill={paint('paper')} stroke="#a9d9ff"/><path d="M120 136v-16h17" fill="#fff" stroke="#d4eafa"/><circle cx="56" cy="47" r="6" fill="#098aff"/><path d="M46 68q0-16 10-16t10 16" fill="#098aff"/><path d="M77 48h44M77 59h26M47 81h73M47 95h70M47 109h55" stroke="#bcd8f3" stroke-width="5" stroke-linecap="round"/></g>
    <path d="M90 9v23q0 10-6 10t-6-10V15q0-10 6-10t6 10v17" fill="none" stroke="#085ef4" stroke-width="3"/>
    <rect x="171" y="25" width="77" height="82" rx="5" fill="#dff4ff" stroke="#7bace4" stroke-width="1.8" stroke-dasharray="5 3"/>
    <path d="M187 75q-6-15 7-17 4-23 21-13 7-1 11 8 18 3 10 22Z" fill="#7cafdc"/><path d="M209 87V58m-8 8 8-8 8 8" stroke="#e3f5ff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
    <g transform="rotate(-13 239 107)" filter={paint('shadow')}><rect x="178" y="89" width="135" height="39" rx="5" fill="#fff" stroke="#f6305a" stroke-width="3"/><rect x="182" y="93" width="127" height="31" rx="2" fill="none" stroke="#f6305a"/><text x="187" y="116" fill="#f6305a" font-size="21" font-family="Arial,sans-serif" font-weight="800">REJECTED</text></g>
    <path d="m277 49 5-9m1 20 9-5" stroke="#ff3565" stroke-width="3" stroke-linecap="round"/>
  </g>}
  {name === 'priority' && <g>
    {[[83,23,'#00bd97','#c1f5e6'],[83,76,'#009bea','#cff5ff']].map(([x,y,c,b])=><g transform={`translate(${x} ${y})`}><rect width="118" height="43" rx="13" fill={b}/><circle cx="25" cy="14" r="7" fill={c}/><path d="M12 34q0-14 13-14t13 14" fill={c}/><path d="M52 15h41M52 27h28" stroke={c} stroke-width="5" stroke-linecap="round"/></g>)}
    <g filter={paint('shadow')}><circle cx="246" cy="70" r="31" fill="#fff" stroke="#00b897" stroke-width="7"/><circle cx="246" cy="70" r="19" fill="none" stroke="#13b793" stroke-width="6"/><circle cx="246" cy="70" r="8" fill="#14b795"/><path d="m246 70 25-31" stroke="#034867" stroke-width="5" stroke-linecap="round"/><path d="m265 40 5-13 10 1 4 8-12 9Z" fill="#034867"/></g>
  </g>}
  {name === 'territory' && <g>
    <ellipse cx="168" cy="104" rx="86" ry="28" fill="#ffdca7" opacity=".45"/><ellipse cx="168" cy="99" rx="61" ry="20" fill="#ffe5b9"/><ellipse cx="168" cy="94" rx="33" ry="12" fill="#ffd899"/>
    <g filter={paint('shadow')}><path d="M168 89s-22-27-22-43a22 22 0 1 1 44 0c0 16-22 43-22 43Z" fill={paint('orange')}/><circle cx="168" cy="45" r="8" fill="white"/><path d="M153 38q6-13 20-10" fill="none" stroke="white" stroke-width="2" opacity=".55"/></g>
    <g fill="none" stroke="#ff9000" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m129 86-27-16m101 16 27-16m-101 39-27 17m101-17 27 17"/><path d="m109 70-10-1 4 9m118-8 12-1-5 9m-119 48-10 3 4-10m119 7 12 3-5-10"/></g>
  </g>}
  {name === 'allocation' && <g>
    <rect x="84" y="22" width="158" height="108" rx="21" fill="#ffd1e6" opacity=".52"/>
    <path d="M163 62v17M108 98v-8q0-14 14-14h81q14 0 14 14v8M163 76v22" fill="none" stroke="#f32983" stroke-width="3" stroke-linecap="round"/>
    <g filter={paint('shadow')}><circle cx="163" cy="39" r="23" fill={paint('pink')} stroke="white"/><circle cx="163" cy="32" r="7" fill="white"/><path d="M150 52q0-16 13-16t13 16" fill="white"/>
      {[108,163,218].map(x=><g transform={`translate(${x} 111)`}><path d="M0 24S-14 6-14-5a14 14 0 1 1 28 0C14 6 0 24 0 24Z" fill={paint('pink')} stroke="white"/><circle cy="-5" r="5" fill="white"/></g>)}
    </g>
  </g>}
  {name === 'optimise' && <g>
    <circle cx="165" cy="74" r="53" fill="none" stroke="#ceebff" stroke-width="9"/>
    <path d="M116 74a49 49 0 0 1 49-49" fill="none" stroke="#008bff" stroke-width="7"/><path d="m159 17 11 8-11 7" fill="none" stroke="#008bff" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M189 31a49 49 0 0 1 25 43" fill="none" stroke={paint('ring')} stroke-width="7"/><path d="m207 67 7 11 8-11" fill="none" stroke="#8d22fb" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M205 101a49 49 0 0 1-46 22" fill="none" stroke="#07bdaf" stroke-width="7"/><path d="m167 115-12 8 12 6" fill="none" stroke="#07bdaf" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M141 115a49 49 0 0 1-25-41" fill="none" stroke="#31c0f7" stroke-width="7"/><path d="m109 83 7-12 8 12" fill="none" stroke="#009dff" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
    <g fill={paint('blue')}><rect x="142" y="74" width="12" height="25" rx="2"/><rect x="160" y="61" width="12" height="38" rx="2"/><rect x="178" y="47" width="12" height="52" rx="2"/></g>
  </g>}
</svg>
